---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import SectionIcon from "../components/SectionIcon.astro";
import ProductName from "../components/ProductName.astro";
import ProductStructuredData from "../components/ProductStructuredData.astro";
import { BOOKS_URL, SITE_NAME } from "../consts";

const startReadingAction = { label: "Start reading", href: BOOKS_URL, external: true };
const readLibraryAction = { label: "Read 60K+ books in WeRead", href: BOOKS_URL, external: true };
const exploreReaderPubAction = { label: "Explore ReaderPub", href: "/platform/", variant: "secondary" as const };
---

<Base
	title={`Browser-Based eReader & Online Book Reading | ${SITE_NAME}`}
	description="Read 60K+ books online with WeRead, a browser-based eReader with notes, sharing, discussion, discovery, read-aloud, and connected reading tools."
	ogImage="/images/readers2.webp"
>
	<Fragment slot="head">
		<ProductStructuredData
			name="WeRead"
			description="Read 60K+ books online with WeRead, a browser-based eReader with notes, sharing, discussion, discovery, read-aloud, and connected reading tools."
			url="/weread/"
			image="/images/readers2.webp"
		/>
	</Fragment>
	<HeroSection
		class="weread-source-hero"
		eyebrow="READERS"
		lead="Books, discussions, notes, and recommendations are scattered across disconnected platforms."
		image="/images/readers2.webp"
		imageAlt="Illustration of the WeRead browser reader with book discovery, notes, discussion, and read-aloud controls across devices"
		actions={[readLibraryAction]}
		spacerBackgroundPositionY="9%"
		>
			<Fragment slot="title">
				<span class="readers-hero-product" style="color: var(--accent);">We<span class="hero-product-part-accent">Read</span><span class="hero-title-colon">:</span></span><br />
				<span class="readers-hero-title-small hero-title-rest">A genuine eReader.<br />Right in your browser.</span>
			</Fragment>
			<Fragment slot="body">We bring everything around books together.</Fragment>
		</HeroSection>

	<Section
		tone="gray"
		body="The problem isn't access. Readers already have more books than they can finish. The problem is isolation."
	>
		<Fragment slot="title"><span class="section-title-accent">Why</span> <span class="section-title-rest">readers abandon books</span></Fragment>
		<CardGrid columns="2" class="weread-source-icon-grid">
			<article class="card icon-grid-card">
				<SectionIcon type="readerBook" title="Reading is isolated" />
				<div class="icon-grid-card-copy">
					<h3>Reading is isolated</h3>
					<p>Most reading platforms stop at access: they give readers a file, not a living reading environment.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="research" title="Discovery is broken" />
				<div class="icon-grid-card-copy">
					<h3>Discovery is broken</h3>
					<p>Recommendations are driven by marketplaces and algorithms rather than real literary communities.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="fan" title="Discussions disappear" />
				<div class="icon-grid-card-copy">
					<h3>Discussions disappear</h3>
					<p>Important conversations happen on Reddit, Facebook, Discord, and in private groups—disconnected from the books themselves.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="reader" title="Notes stay private" />
				<div class="icon-grid-card-copy">
					<h3>Notes stay private</h3>
					<p>A reader's thoughts often remain trapped on one device or in one app instead of becoming part of a larger literary context.</p>
				</div>
			</article>
		</CardGrid>
		<div class="weread-combined-subsection weread-app-problem-subsection">
			<header class="section-header">
				<h2>The problem <span class="section-title-rest">with app-based reading</span></h2>
				<p class="section-lead">App-based reading gave books digital access, but kept reading isolated from the web.</p>
			</header>
			<CardGrid columns="3">
				<Card title="Fragmented reading" body="Readers move among apps, stores, social networks, and private notes without a shared context." />
				<Card title="Why the model fails" body="The book becomes a closed object, while discovery, discussion, and long-term engagement happen somewhere else." />
				<Card title="The outcome" body="Reading becomes easier to start but harder to connect with people, ideas, and future books." />
			</CardGrid>
		</div>
	</Section>

	<section class="section section--white weread-solution-showcase-section" aria-labelledby="weread-solution-showcase-title">
		<header class="weread-solution-showcase-header">
			<h2 id="weread-solution-showcase-title" class="heading--center-full heading--center-full-h2">
				<span class="weread-solution-title-prefix">The solution:&nbsp;&nbsp;</span><a class="weread-solution-product-word" href={BOOKS_URL} target="_blank" rel="noopener noreferrer"><span>We</span><span>Read</span></a>, a browser-based eReader
			</h2>
		</header>
		<picture class="weread-solution-picture" data-reveal>
			<source media="(orientation: portrait)" srcset="/images/tech_mobile.webp" width="823" height="1743" />
			<img
				src="/images/tablet.webp"
				alt="WeRead browser-based eReader with sharing, notes and discussion"
				loading="lazy"
				decoding="async"
				width="2200"
				height="1600"
			/>
		</picture>
		<div class="weread-solution-cta">
			<h2 class="heading--center-full heading--center-full-h2">Again, it's not an app—it's a&#32;<a class="weread-solution-product-word" href="https://reader.pub/books/reader/?id=11" target="_blank" rel="noopener noreferrer"><span>We</span><span>Read</span></a> webpage.</h2>
			<h3 class="heading--center-full heading--center-full-h3">Read on the web, share the whole book or a single passage, make and share notes, and discuss it all on&#32;<a class="weread-solution-product-word" href="https://webuzz.org/" target="_blank" rel="noopener noreferrer"><span>We</span><span>Buzz</span></a>.</h3>
			<div class="weread-solution-actions">
				<a class="button button--secondary" href={BOOKS_URL} target="_blank" rel="noopener noreferrer">Read 60K+ books in WeRead</a>
				<a class="button" href="/webuzz/">Explore WeBuzz</a>
			</div>
		</div>
	</section>

	<Section
		tone="white"
		title="ReaderPub reconnects reading"
		body="WeRead turns books into active, browser-based reading experiences connected to notes, discussion, discovery, and community."
	>
		<CardGrid columns="4">
			<Card title="Read in the browser" body="Open books instantly without installing another isolated app." />
			<Card title="Discuss books and authors" body="Join conversations connected to books, authors, passages, and ideas." />
			<Card title="Discover through people" body="Find books through readers and communities—not only bestseller lists." />
			<Card title="Keep context alive" body="Keep notes, comments, and discussions connected to the work." />
		</CardGrid>
	</Section>

	<Section
		tone="green"
		body="WeRead turns the browser into the reading environment, so a book can open from a link and remain part of the public web."
	>
		<Fragment slot="title">Browser-based <span class="green-heading-white">active reading</span></Fragment>
		<CardGrid columns="3" class="weread-source-icon-grid">
			<article class="card icon-grid-card">
				<SectionIcon type="readerBook" title="Open from a link" />
				<div class="icon-grid-card-copy">
					<h3>Open from a link</h3>
					<p>Readers can start from a link without installing another isolated app.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="research" title="Searchable context" />
				<div class="icon-grid-card-copy">
					<h3>Searchable context</h3>
					<p>Books become easier to find, revisit, and connect with related work.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="fan" title="Attached discussion" />
				<div class="icon-grid-card-copy">
					<h3>Discussion stays attached</h3>
					<p>Conversation can stay connected to the book, author, passage, and idea.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<Section tone="white" class="weread-web-reading-section section--two-column">
		<div class="weread-web-reading-intro">
			<div class="weread-web-reading-copy">
				<header class="section-header">
					<h2>Why web reading wins</h2>
					<p class="section-lead">The fastest way to start reading, with a full eReader experience—no download required.</p>
				</header>
				<ul class="weread-source-bullets">
					<li>Most major book libraries still don't offer a true web reader that matches the quality of native apps.</li>
					<li>Many readers don't want to install another app or struggle with device-specific readers.</li>
					<li>With WeRead, one link is enough—click and start reading instantly.</li>
					<li>Get the same long-form reading comfort without setup or friction.</li>
				</ul>
			</div>
			<article class="card weread-ad-free-card">
				<div class="weread-ad-free-card-heading">
					<SectionIcon type="noAds" title="Ad-free public-domain reading" />
					<h3>Ad-free public-domain reading</h3>
				</div>
				<p>
					ReaderPub's WeRead catalog gives readers browser-based access to public-domain books without advertising around the reading experience.
				</p>
			</article>
		</div>
		<CardGrid columns="2" class="weread-feature-cards">
			<article class="card">
				<h3><ProductName name="WeRead" colon /><br />Reader benefits</h3>
				<p>A personal reading space built for discovery and continuity.</p>
				<ul class="weread-source-bullets">
					<li>Curated shelves, reading plans, and discovery lists.</li>
					<li>One library for personal, academic, and professional reading.</li>
					<li>Follow authors, series, and institutions in one feed.</li>
					<li>Add private or shared notes as you read.</li>
					<li>Send a book with your notes to another reader or directly to the author.</li>
					<li>Switch instantly to read-aloud using voices available on your device.</li>
				</ul>
				<div class="cta-row">
					<a class="button button--secondary" href="https://reader.pub/books/protected/?id=90000074" target="_blank" rel="noopener noreferrer">Read sample book with WeRead</a>
				</div>
			</article>
			<article class="card">
				<h3><ProductName name="WeBuzz" colon /><br />Reading is better together.</h3>
				<p>Books become more meaningful when readers discuss them.</p>
				<p>With WeBuzz, readers can discuss books, authors, and specific passages. Follow readers whose insights you value, and discover new books through conversation.</p>
				<ul class="weread-source-bullets">
					<li>Discuss books and authors</li>
					<li>Comment on specific passages</li>
					<li>Follow other readers</li>
					<li>Discover books through discussion</li>
					<li>Join literary communities</li>
				</ul>
				<div class="cta-row">
					<a class="button" href="/webuzz/">Join the Conversation</a>
				</div>
			</article>
			<article class="card">
				<h3><ProductName name="BookTree" colon /><br />Built for serious reading</h3>
				<p>Structure, focus, and long-term work with texts.</p>
				<ul class="weread-source-bullets">
					<li>Organize books, excerpts, and references across projects.</li>
					<li>Keep context while reading long and complex materials.</li>
					<li>Build personal knowledge maps from what you read.</li>
					<li>Consolidate notes from multiple books while working on your own manuscript.</li>
					<li>Designed for sustained attention—not endless scrolling.</li>
				</ul>
				<div class="cta-row">
					<a class="button button--secondary" href="/booktree/">Explore BookTree</a>
				</div>
			</article>
			<article class="card">
				<h3><span class="weread-card-product">Scribe:</span><br />Ask while you read</h3>
				<p>A focused AI companion for books, authors, references, and literary context.</p>
				<ul class="weread-source-bullets">
					<li>Ask questions about unfamiliar references and ideas.</li>
					<li>Explore authors, genres, literary history, and themes.</li>
					<li>Discuss difficult passages without leaving ReaderPub.</li>
					<li>Continue Scribe conversations connected to your reading activity.</li>
				</ul>
				<div class="cta-row">
					<a class="button button--secondary" href="/scribe/">Explore Scribe</a>
				</div>
			</article>
		</CardGrid>
	</Section>

	<Section
		class="weread-network-section"
		tone="green"
	>
		<Fragment slot="title">
			<ProductName name="WeRead" colon />&nbsp;&nbsp;<span class="weread-network-title-line">A richer catalog with connected context</span>
		</Fragment>
		<Fragment slot="body">
			<span class="weread-network-black-copy">The WeRead catalog includes tens of thousands of books with annotations and author biographies, helping readers understand a book before they begin.</span>
			<span>Notes, comments, recommendations, and discussions become part of the reading environment instead of disappearing into separate products.</span>
		</Fragment>
		<CardGrid columns="3" data-card-reveal-origin="rise">
			<Card title="Books connect to readers" body="Reading activity can guide people toward communities and conversations about the work." />
			<Card title="Readers connect to books" body="Discovery can come through people and communities—not only store rankings." />
			<Card title="Books connect to future work" body="A title can remain active on the web after the first sale or download." />
		</CardGrid>
		<div class="weread-combined-subsection">
			<header class="section-header">
				<h2>Who benefits from <span class="green-heading-white">reading books online</span>?</h2>
			</header>
			<CardGrid columns="4" class="weread-benefits-icon-grid">
				<article class="card weread-benefit-card">
					<div class="weread-benefit-card-heading">
						<SectionIcon type="reader" title="Readers" />
						<h3>Readers</h3>
					</div>
					<p>Gain immediate access without installation or platform lock-in.</p>
				</article>
				<article class="card weread-benefit-card">
					<div class="weread-benefit-card-heading">
						<SectionIcon type="author" title="Authors" />
						<h3>Authors</h3>
					</div>
					<p>Maintain stronger visibility into reader engagement.</p>
				</article>
				<article class="card weread-benefit-card">
					<div class="weread-benefit-card-heading">
						<SectionIcon type="publisher" title="Publishers" />
						<h3>Publishers</h3>
					</div>
					<p>Support modern reading experiences without relying on file delivery.</p>
				</article>
				<article class="card weread-benefit-card">
					<div class="weread-benefit-card-heading">
						<SectionIcon type="library" title="Institutions" />
						<h3>Institutions</h3>
					</div>
					<p>Provide collections that are easier to access and use.</p>
				</article>
			</CardGrid>
		</div>
	</Section>

	<CtaBlock
		title="Reading should not begin with a download."
		body="WeRead helps web books and knowledge publications remain accessible, discoverable, and active after release."
		actions={[startReadingAction, exploreReaderPubAction]}
	/>
</Base>

<style>
	.weread-solution-showcase-section {
		justify-items: center;
		gap: 34px;
		padding-top: calc(var(--section-padding) * 0.8);
		padding-bottom: var(--section-padding);
	}

	.weread-solution-showcase-header,
	.weread-solution-cta {
		display: grid;
		justify-items: center;
		width: 100%;
		text-align: center;
	}

	.weread-solution-showcase-header {
		gap: 0;
	}

	.weread-solution-showcase-header h2,
	.weread-solution-cta h2,
	.weread-solution-cta h3 {
		margin: 0;
		color: var(--text) !important;
	}

	.weread-solution-title-prefix {
		font-style: italic;
	}

	.weread-solution-product-word {
		display: inline-block;
		color: var(--accent);
		text-decoration: none !important;
	}

	.weread-solution-product-word > span:last-child {
		color: var(--accent-orange);
	}

	.weread-solution-picture {
		display: block;
		justify-self: stretch;
		width: 100%;
	}

	.weread-solution-picture img {
		display: block;
		width: 100%;
		height: auto;
	}

	.weread-solution-cta {
		gap: clamp(10px, 1vw, 16px);
	}

	.weread-solution-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--button-row-gap);
		width: 100%;
		margin-top: calc(var(--button-row-gap) * 0.25);
	}

	.weread-solution-actions .button {
		width: auto;
	}

	.weread-source-hero .hero-copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.weread-source-hero .hero-copy > * {
		margin: 0;
	}

	.weread-source-hero .section-kicker {
		display: none;
	}

	.weread-source-hero h1 {
		max-width: 1060px;
		line-height: var(--line-height-heading);
	}

	.weread-source-hero .readers-hero-product {
		color: var(--accent);
	}

	.weread-source-hero .readers-hero-title-small {
		display: block;
		color: var(--text);
	}

	:global(.weread-source-hero .hero-lead) {
		max-width: 760px;
		color: var(--text) !important;
		font-size: 19.5px !important;
		line-height: var(--line-height-body) !important;
	}

	:global(.weread-source-hero .hero-body) {
		max-width: 720px;
		color: var(--accent) !important;
		font-family: var(--font-heading) !important;
		font-size: clamp(22.1px, 2.72vw, 32.3px) !important;
		font-weight: var(--font-weight-heading) !important;
		letter-spacing: var(--letter-spacing-heading) !important;
		line-height: var(--line-height-heading) !important;
	}

	.weread-source-hero .hero-image {
		align-self: center;
	}

	@media (min-width: 901px) {
		.weread-source-hero .readers-hero-title-small {
			white-space: nowrap;
		}
	}

	.weread-comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.weread-list-card {
		min-height: 0;
	}

	.weread-app-problem-subsection h2 {
		color: var(--accent-orange);
	}

	.weread-model-list {
		display: grid;
		gap: 10px;
		padding-left: 1.15rem;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}

	.weread-model-list li::marker {
		color: var(--accent);
	}

	.weread-source-bullets {
		display: grid;
		gap: 8px;
		padding-left: 1.15rem;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}

	.weread-source-bullets li::marker {
		color: var(--accent);
	}

	:global(.weread-web-reading-section .section-header) {
		text-align: left;
	}

	.weread-web-reading-intro {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
		gap: 32px;
		align-items: start;
		width: 100%;
	}

	.weread-web-reading-copy {
		display: grid;
		gap: 28px;
		min-width: 0;
	}

	.weread-web-reading-copy > .section-header {
		margin: 0 !important;
	}

	.weread-web-reading-copy .weread-source-bullets {
		margin: 0;
	}

	.weread-ad-free-card {
		--weread-ad-card-heading-size: clamp(1.2rem, 2vw, 1.55rem);
		--weread-ad-card-icon-size: calc(var(--weread-ad-card-heading-size) * 1.7);
		align-self: start;
		gap: 18px;
		background: var(--card-bg);
	}

	.weread-ad-free-card-heading {
		display: flex;
		align-items: center;
		gap: var(--card-icon-gap);
	}

	:global(.weread-ad-free-card-heading .section-icon) {
		flex: 0 0 var(--weread-ad-card-icon-size);
		width: var(--weread-ad-card-icon-size) !important;
		height: var(--weread-ad-card-icon-size) !important;
	}

	.weread-ad-free-card-heading h3 {
		margin: 0 !important;
		font-size: var(--weread-ad-card-heading-size);
		line-height: var(--line-height-heading);
	}

	.weread-ad-free-card p {
		margin: 0 !important;
		color: var(--accent-copy);
		font-size: var(--hero-problem-copy-size);
		line-height: var(--line-height-body);
	}

	.weread-combined-subsection {
		display: grid;
		gap: 28px;
		margin-top: var(--section-padding);
	}

	.weread-card-product {
		color: var(--accent-orange);
	}

	.weread-network-title-line {
		display: inline-block;
	}

	:global(.weread-network-section .section-header h2) {
		white-space: normal;
	}

	:global(.weread-network-section .section-header) {
		justify-items: start;
		text-align: left;
	}

	:global(.weread-network-section .section-header h2) {
		text-align: left;
	}

	:global(.weread-network-section .section-header h2 .weread-card-product) {
		color: #ffffff !important;
	}

	:global(.weread-network-section .section-lead) {
		display: grid;
		gap: var(--section-gap);
	}

	:global(.weread-network-section .section-lead span) {
		display: block;
	}

	:global(.weread-network-section .section-lead .weread-network-black-copy) {
		color: #ffffff !important;
	}

	@media (min-width: 901px) {
		.weread-network-title-line {
			white-space: normal;
		}
	}

	@media (max-width: 900px) {
		:global(.weread-network-section .section-header h2) {
			white-space: normal;
		}
	}

	:global(.weread-source-icon-grid .card.icon-grid-card) {
		display: grid !important;
		grid-template-columns: var(--card-icon-column) minmax(0, 1fr) !important;
		column-gap: var(--card-icon-gap) !important;
		row-gap: 16px !important;
		align-items: flex-start;
		width: 100%;
	}

	:global(.weread-source-icon-grid .icon-grid-card-copy) {
		display: contents;
	}

	:global(.weread-source-icon-grid .icon-grid-card > .section-icon) {
		grid-column: 1;
		grid-row: 1;
		align-self: center;
		width: var(--card-inline-icon-size) !important;
		height: var(--card-inline-icon-size) !important;
	}

	:global(.weread-source-icon-grid .icon-grid-card .icon-grid-card-copy > h3) {
		grid-column: 2;
		grid-row: 1;
		align-self: center;
		margin: 0;
	}

	:global(.weread-source-icon-grid .icon-grid-card .icon-grid-card-copy > p) {
		grid-column: 1 / -1;
	}

	:global(.weread-benefits-icon-grid .weread-benefit-card) {
		display: grid;
		grid-template-rows: auto 1fr;
		gap: 22px;
		align-content: flex-start;
		width: 100%;
	}

