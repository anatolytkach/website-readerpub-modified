---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import PartnershipRequestModal from "../components/PartnershipRequestModal.astro";
import ProductTitle from "../components/ProductTitle.astro";
import SectionIcon from "../components/SectionIcon.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";

const heroActions = [
	{ label: "Partner inquiry", href: "#partnership-request-modal", modalTarget: "#partnership-request-modal" },
	{ label: "Explore the Platform", href: "/platform/", variant: "secondary" as const },
];

const marketCards = [
	{
		title: "Authors",
		marketSize: "Millions",
		body: "Publish and manage web-native publications while building long-term relationships with readers.",
		icon: "author" as const,
	},
	{
		title: "Publishers",
		marketSize: "Hundreds of thousands",
		body: "Modernize publishing workflows, distribution, and audience engagement without replacing existing editorial processes.",
		icon: "publisher" as const,
	},
	{
		title: "Libraries",
		marketSize: "Hundreds of thousands",
		body: "Deliver curated digital collections with controlled access, community discussion, and long-term preservation.",
		icon: "library" as const,
	},
	{
		title: "Universities",
		marketSize: "25,000+",
		body: "Support textbooks, research, institutional publishing, and collaborative learning through one integrated platform.",
		icon: "university" as const,
	},
	{
		title: "Archives & Museums",
		marketSize: "Thousands",
		body: "Publish archives, reports, educational resources, and specialized collections through the same publishing infrastructure.",
		icon: "research" as const,
	},
	{
		title: "Government & Non-profit Organizations",
		marketSize: "Global institutional market",
		body: "Publish research, educational resources, and public information through secure, controlled digital publishing.",
		icon: "government" as const,
	},
];

const products = [
	{ title: "WePub", body: "Web-native publishing infrastructure." },
	{ title: "WeRead", body: "Browser-based reading and a large public-domain catalog." },
	{ title: "WeBuzz", body: "Literary community and public discussion." },
	{ title: "WeTalk", body: "Controlled institutional discussion environments." },
	{ title: "BookTree", body: "Research, notes, and structured knowledge workflows." },
	{ title: "Scribe", body: "AI conversation for books and publishing." },
];

const customerMarkets = [
	{ title: "Authors", icon: "author" as const },
	{ title: "Publishers", icon: "publisher" as const },
	{ title: "Universities", icon: "university" as const },
	{ title: "Libraries", icon: "library" as const },
	{ title: "Archives and museums", icon: "research" as const },
	{ title: "Government and non-profits", icon: "government" as const },
];

const revenueCards = [
	{
		title: "Author subscriptions",
		body: "Professional publishing tools and platform services for independent authors.",
	},
	{
		title: "Publisher relationships",
		body: "Publishing infrastructure and commercial services for independent and established publishers.",
	},
	{
		title: "Institutional licensing",
		body: "Universities, libraries, and organizations can deploy ReaderPub across their communities and collections.",
	},
	{
		title: "Platform expansion",
		body: "Additional products and services can extend existing customer relationships through the same technology foundation.",
	},
];

const capitalCards = [
	{
		title: "Author acquisition",
		body: "Introduce independent and professional authors to web-native publishing and direct reader relationships.",
	},
	{
		title: "Publisher partnerships",
		body: "Build commercial relationships with publishers seeking modern publishing, distribution, and engagement infrastructure.",
	},
	{
		title: "Institutional deployments",
		body: "Expand pilots and adoption among universities, libraries, and organizations managing knowledge collections.",
	},
	{
		title: "Strategic partnerships",
		body: "Develop distribution, technology, and market relationships that can accelerate platform adoption.",
	},
];

const timingCards = [
	{
		title: "Publishing is moving beyond static files",
		body: "Books and knowledge publications increasingly need to remain accessible, manageable, and connected to readers after release. Static file delivery does not support that continuing relationship.",
	},
	{
		title: "The market is consolidating fragmented workflows",
		body: "Authors, publishers, and institutions increasingly need publishing, reading, controlled access, discussion, analytics, and AI assistance to work together instead of remaining in disconnected products.",
	},
];

const expansionCards = [
	{
		title: "Shared technology",
		body: "Products use a common foundation instead of requiring separate platforms for every market.",
	},
	{
		title: "Cross-product value",
		body: "Publishing, reading, discussion, knowledge organization, and AI can reinforce one another within the same customer relationship.",
	},
	{
		title: "New market paths",
		body: "The platform can enter different customer segments without abandoning its core infrastructure or product logic.",
	},
];

const finalCtaActions = [
	{ label: "Partner inquiry", href: "#partnership-request-modal", modalTarget: "#partnership-request-modal" },
	{ label: "Explore the Platform", href: "/platform/", variant: "secondary" as const },
];
---

<Base
	title="ReaderPub Strategy"
	description="Explore ReaderPub’s market-ready, multi-market publishing platform, recurring revenue model, growth strategy, and partnership and investment opportunities."
	canonical="/strategy/"
	ogTitle="ReaderPub Strategy"
	ogDescription="Explore ReaderPub’s multi-market platform, recurring revenue model, and strategy for scaling adoption across commercial and institutional publishing."
	ogImage="/images/growth.webp"
>
	<HeroSection
		class="growth-hero"
		title="Building the infrastructure behind the future of publishing"
		image="/images/growth.webp"
		imageAlt="ReaderPub platform growth illustration for investors and strategic partners"
		mediaPosition="start"
		mediaRevealOrigin="left"
		actions={heroActions}
	>
		<div slot="body" class="growth-hero-body-copy">
			<p class="growth-hero-solution">
				ReaderPub is a market-ready platform that brings publishing, reading, collaboration, AI, and literary communities together.
			</p>
			<p class="growth-hero-problem">
				The product is ready. We are focused on launching initial pilot projects and attracting partners, and we are open to financial collaboration.
			</p>
		</div>
	</HeroSection>

	<Section
		tone="white"
		class="growth-markets-section"
		body="ReaderPub is designed for multiple customer segments that share the same publishing infrastructure. Together, they represent a diversified global market with different purchasing models but similar needs for publishing, reading, collaboration, and knowledge management."
	>
		<Fragment slot="title"><ProductTitle text="ReaderPub serves multiple global markets" /></Fragment>
		<CardGrid columns="3" class="growth-market-grid">
			{marketCards.map((card) => (
				<article class="card card--with-icon growth-market-card">
					<div class="card-icon-heading">
						<SectionIcon type={card.icon} title={`${card.title} icon`} />
						<h3>{card.title}</h3>
					</div>
					<p class="growth-market-size">{card.marketSize}</p>
					<p>{card.body}</p>
				</article>
			))}
		</CardGrid>
		<p class="growth-section-note">Together, these customer segments represent a diversified global market united by a common need:&nbsp;&nbsp;publishing, protecting, distributing, and discussing digital knowledge through a single platform.</p>
	</Section>

	<Section
		tone="green"
		class="growth-architecture-section"
		body="ReaderPub uses one technology foundation to power a connected product ecosystem and serve multiple customer groups."
	>
		<Fragment slot="title">Multiple markets. Multiple products. <span class="growth-architecture-heading-emphasis">One ecosystem<span class="growth-architecture-heading-period">.</span></span></Fragment>
		<div class="growth-architecture" aria-label="ReaderPub platform architecture">
			<section class="growth-architecture-level" aria-labelledby="growth-foundation-title">
				<h3 id="growth-foundation-title" class="growth-architecture-level-title">Technology foundation</h3>
					<article class="card growth-foundation-card">
						<h4><ProductTitle text="ReaderPub" /><span class="growth-foundation-title-colon">:</span>&nbsp;&nbsp;A market-ready platform</h4>
					<p>Shared publishing infrastructure, content model, accounts, permissions, commerce, and analytics.</p>
				</article>
			</section>
			<div class="growth-architecture-connector" aria-hidden="true"></div>
			<section class="growth-architecture-level" aria-labelledby="growth-products-title">
				<h3 id="growth-products-title" class="growth-architecture-level-title">Connected products</h3>
				<CardGrid columns="3" class="growth-architecture-grid growth-product-grid">
						{products.map((product) => (
							<article class:list={["card", "card--compact", "growth-architecture-card", product.title === "WeTalk" && "growth-product-card--wetalk"]}>
							<h4 class:list={product.title === "Scribe" && "growth-product-title--scribe"}><ProductTitle text={product.title} /></h4>
							<p>{product.body}</p>
						</article>
					))}
				</CardGrid>
			</section>
			<div class="growth-architecture-connector" aria-hidden="true"></div>
			<section class="growth-architecture-level" aria-labelledby="growth-customer-markets-title">
				<h3 id="growth-customer-markets-title" class="growth-architecture-level-title">Customer markets</h3>
				<CardGrid columns="3" class="growth-architecture-grid growth-customer-market-grid">
					{customerMarkets.map((market) => (
						<article class="card card--compact growth-architecture-card">
							<SectionIcon type={market.icon} title={`${market.title} icon`} />
							<h4>{market.title}</h4>
						</article>
					))}
				</CardGrid>
			</section>
		</div>
		<p class="growth-section-note">Because the products share one technology foundation, new capabilities can strengthen the entire platform instead of being developed as isolated systems.</p>
	</Section>

	<Section
		tone="white"
		class="growth-revenue-section"
		title="Multiple recurring revenue streams"
		body="ReaderPub is designed around subscription and licensing relationships rather than dependence on a single transaction type."
	>
		<CardGrid columns="4" class="growth-revenue-grid">
			{revenueCards.map((card) => <Card {...card} />)}
		</CardGrid>
		<p class="growth-section-note">This structure creates multiple paths to adoption while keeping the products connected within one platform.</p>
		<div class="cta-row growth-secondary-action">
			<a class="button button--secondary" href="/pricing/">View pricing</a>
		</div>
	</Section>

	<Section
		tone="green"
		class="growth-capital-section"
		body="ReaderPub’s primary objective is to expand market adoption. Investment would be directed toward reaching the customers for whom the platform has already been designed."
	>
		<Fragment slot="title">Capital focused <span class="growth-capital-heading-emphasis">on growth</span></Fragment>
		<CardGrid columns="4" class="growth-capital-grid">
			{capitalCards.map((card) => <Card {...card} />)}
		</CardGrid>
		<p class="growth-section-note">This approach allows new capital to support commercial expansion instead of rebuilding the platform’s technology foundation.</p>
	</Section>

	<Section
		tone="white"
		class="growth-expansion-section"
		title="Built for long-term expansion"
		body="ReaderPub has been architected as a platform rather than a single application. Each product can serve a distinct need while strengthening the same publishing infrastructure, customer relationships, and knowledge ecosystem."
	>
		<CardGrid columns="3" class="growth-expansion-grid">
			{expansionCards.map((card) => <Card {...card} />)}
		</CardGrid>
		<p class="growth-section-note">As adoption grows in one segment, the same foundation can support expansion into others.</p>
	</Section>

	<Section tone="green" class="growth-timing-section">
		<Fragment slot="title">Why now<span class="growth-timing-heading-question">?</span></Fragment>
		<CardGrid columns="2" class="growth-timing-grid">
			{timingCards.map((card) => <Card {...card} />)}
		</CardGrid>
		<p class="growth-section-note">ReaderPub was designed around this transition from file delivery to continuously managed web-native publishing.</p>
	</Section>

	<CtaBlock
		class="growth-final-cta"
		title="Partner with ReaderPub"
		actions={finalCtaActions}
	>
		<Fragment slot="body">
			We are expanding commercial partnerships, institutional deployments, and strategic investment relationships.<br />
			<span class="growth-final-cta-body-second-sentence">If you are interested in helping scale the next generation of publishing infrastructure, we would like to start the conversation.</span>
		</Fragment>
	</CtaBlock>

	<PartnershipRequestModal />
</Base>

<style>
	:global(.growth-hero.hero-section:not(.section--with-media)) {
		grid-template-columns: minmax(0, 1fr);
		padding-bottom: 64px;
	}

	:global(.growth-hero .hero-copy) {
		max-width: 860px;
	}

	.growth-hero-body-copy {
		display: grid;
		gap: 0.65em;
	}

	.growth-hero-body-copy p {
		margin: 0;
	}

	.growth-hero-body-copy .growth-hero-solution {
		color: var(--accent-copy);
		font-size: var(--hero-solution-copy-size);
	}

	.growth-hero-body-copy .growth-hero-problem {
		color: var(--text);
		font-size: var(--hero-problem-copy-size);
	}

	:global(.growth-hero .hero-media) {
		order: -1;
		justify-content: flex-start !important;
	}

	@media (orientation: landscape) and (min-width: 901px) {
		:global(.growth-hero.hero-section.section--with-media.hero-section--media-start) {
			grid-template-columns: minmax(0, 36%) minmax(0, 58%);
			column-gap: 6%;
		}
	}

	:global(.growth-market-grid.card-grid--3) {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	:global(.growth-market-card) {
		gap: 14px;
	}

	:global(.growth-market-size) {
		margin: 0;
		color: var(--accent) !important;
		font-family: var(--font-heading);
		font-size: 1.125rem;
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.25;
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}

	:global(.growth-section-note) {
		width: 100%;
		max-width: 820px;
		margin: 0;
		color: var(--accent-copy);
		font-size: 1.125rem;
		line-height: var(--line-height-body);
	}

	:global(.growth-markets-section .growth-section-note),
	:global(.growth-expansion-section .growth-section-note) {
		color: var(--text);
	}

	:global(.growth-architecture-section .section-kicker),
	:global(.growth-capital-section .section-kicker) {
		color: #ffffff;
	}

	:global(.growth-architecture) {
		display: grid;
		gap: 18px;
		width: 100%;
	}

	:global(.growth-architecture-section > .growth-architecture) {
		margin-top: 14px;
	}

	:global(.growth-architecture-level) {
		display: grid;
		gap: 14px;
	}

	:global(.growth-architecture-level-title) {
		margin: 0;
		color: #ffffff !important;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: var(--line-height-heading);
		text-align: center;
		text-transform: uppercase;
	}

	:global(body .page .content .growth-architecture-section .growth-architecture-level-title) {
		color: #ffffff !important;
	}

	:global(.growth-architecture-heading-emphasis) {
		color: #ffffff !important;
	}

	:global(.growth-capital-heading-emphasis) {
		color: #ffffff !important;
	}

	:global(.growth-architecture-heading-period) {
		color: var(--section-green-orange) !important;
	}

	:global(.growth-foundation-card) {
		align-items: center;
		justify-content: center;
		justify-self: center;
		min-height: 0;
		width: fit-content;
		max-width: 100%;
		padding: 28px;
		text-align: center;
	}

	:global(.growth-foundation-card h4),
	:global(.growth-architecture-card h4) {
		margin: 0;
		color: var(--text);
		font-family: var(--font-heading);
		font-size: 1.35rem;
		font-weight: var(--font-weight-heading);
		letter-spacing: 0;
		line-height: var(--line-height-heading);
	}

	:global(.growth-foundation-card > p:last-child) {
		max-width: 24rem;
		margin: 0;
		color: var(--accent) !important;
		text-align: center;
	}

	:global(body .page .content .growth-architecture-section .growth-foundation-card > p:last-child) {
		text-align: center !important;
	}

	:global(.growth-foundation-card h4 :is(.product-heading-base, .readerpub-heading-reader)),
	:global(.growth-foundation-card:hover h4 :is(.product-heading-base, .readerpub-heading-reader)) {
		color: var(--accent) !important;
	}

	:global(.growth-foundation-card h4 :is(.product-heading-accent, .readerpub-heading-pub)),
	:global(.growth-foundation-card:hover h4 :is(.product-heading-accent, .readerpub-heading-pub)) {
		color: var(--accent-orange) !important;
	}

	:global(body .page .content .growth-architecture-section .growth-foundation-title-colon),
	:global(body .page .content .growth-architecture-section .growth-foundation-card:hover .growth-foundation-title-colon) {
		color: var(--text) !important;
	}

	:global(.growth-architecture-connector) {
		display: grid;
		justify-items: center;
		min-height: 44px;
	}

	:global(.growth-architecture-connector::before) {
		content: "";
		width: 2px;
		height: 30px;
		background: var(--section-green-orange);
	}

	:global(.growth-architecture-connector::after) {
		content: "";
		width: 0;
		height: 0;
		border-top: 7px solid var(--section-green-orange);
		border-right: 6px solid transparent;
		border-left: 6px solid transparent;
	}

	:global(.growth-architecture-grid) {
		grid-template-columns: repeat(6, minmax(0, 1fr));
		row-gap: var(--card-grid-gap);
		column-gap: calc(var(--card-grid-gap) * 0.8);
	}

	:global(.growth-architecture-card) {
		align-items: center;
		justify-content: center;
		min-height: 118px;
		padding: 18px;
		text-align: center;
	}

	:global(.growth-architecture-card h4) {
		text-align: center;
	}

	:global(.growth-architecture-card p) {
		margin: 0;
		text-align: center;
	}

	:global(body .page .content .growth-architecture-section .growth-product-grid .growth-architecture-card),
	:global(body .page .content .growth-architecture-section .growth-customer-market-grid .growth-architecture-card),
	:global(body .page .content .growth-architecture-section .growth-product-grid .growth-architecture-card :is(h4, p)),
	:global(body .page .content .growth-architecture-section .growth-customer-market-grid .growth-architecture-card h4) {
		text-align: center !important;
	}

	:global(.growth-customer-market-grid .growth-architecture-card) {
		gap: 12px;
		min-height: 148px;
	}

	:global(.growth-customer-market-grid .growth-architecture-card > .section-icon) {
		width: 42px !important;
		height: 42px !important;
	}

	:global(.growth-product-grid .growth-architecture-card) {
		display: grid;
		grid-template-rows: 2em auto;
		justify-items: center;
		align-content: start;
	}

	:global(.growth-product-grid .growth-architecture-card p) {
		align-self: start;
	}

	:global(.growth-product-grid.card-grid--3),
	:global(.growth-customer-market-grid.card-grid--3) {
		grid-template-columns: repeat(6, minmax(0, 1fr));
	}

	:global(.growth-product-grid .growth-product-card--wetalk) {
		padding-inline: 12px;
	}

	:global(.growth-customer-market-grid .growth-architecture-card) {
		display: grid;
		grid-template-rows: 42px 2.7em;
		justify-items: center;
		align-content: center;
	}

	:global(.growth-customer-market-grid .growth-architecture-card h4) {
		font-size: 1rem;
	}

	:global(.growth-product-title--scribe) {
		color: var(--accent) !important;
	}

	:global(.growth-secondary-action) {
		justify-content: flex-start;
	}

	:global(.growth-final-cta-body-second-sentence) {
		color: #ffffff !important;
	}

	.growth-timing-heading-question {
		color: #ffffff;
	}

	@media (max-width: 1100px) {
		:global(.growth-market-grid.card-grid--3) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		:global(.growth-product-grid.card-grid--3),
		:global(.growth-customer-market-grid.card-grid--3) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		:global(.growth-customer-market-grid > :nth-child(5)) {
			grid-column: auto;
		}

	}

	@media (max-width: 900px) {
		:global(.growth-hero.hero-section:not(.section--with-media)) {
			padding-bottom: 42px;
		}

		:global(.growth-market-grid.card-grid--3) {
			grid-template-columns: 1fr;
		}

		:global(.growth-hero .hero-copy) {
			max-width: none;
		}

		:global(.growth-product-grid.card-grid--3),
		:global(.growth-customer-market-grid.card-grid--3) {
			grid-template-columns: 1fr;
		}

		:global(.growth-product-grid .growth-architecture-card) {
			grid-template-rows: 2em auto;
		}

		:global(.growth-foundation-card),
		:global(.growth-architecture-card) {
			min-height: 0;
		}

		:global(.growth-foundation-card) {
			width: 100%;
		}

		:global(.growth-secondary-action) {
			justify-content: center;
		}
	}
</style>
