---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import SpecCardsSection from "../components/sections/SpecCardsSection.astro";
import SectionIcon from "../components/SectionIcon.astro";
import ProductName from "../components/ProductName.astro";
import { PUBLISH_URL, SITE_NAME } from "../consts";

const pricingAction = { label: "See pricing", href: "/pricing", variant: "secondary" as const };
const finalPublishAction = { label: "Start publishing with WePub", href: PUBLISH_URL, external: true };
const publishingFlowSlides = Array.from({ length: 6 }, (_, index) => {
	const number = index + 1;

	return {
		number,
		top: `/images/wepub-publishing-flow/top_${number}.png`,
		body: `/images/wepub-publishing-flow/body_${number}.png`,
	};
});
---

<Base
	title={`Web-Native Book Publishing for Authors & Publishers | ${SITE_NAME}`}
	description="Publish web-native, browser-readable books with WePub. Sell directly, keep reader relationships and activity connected, and pay a 5% sales commission."
	canonical="/wepub/"
	ogImage="/images/author1.webp"
>
	<HeroSection
		class="wepub-new-hero"
		image="/images/author1.webp"
		imageAlt="Illustration of an author using WePub to publish books online and stay connected with readers"
		spacerBackgroundPositionY="54%"
	>
		<Fragment slot="title"><span style="color: var(--accent);">We<span class="hero-product-part-accent">Pub</span><span class="hero-title-colon">:</span></span><br /><span class="hero-title-rest">Publish books on the web. Own your readers' activity—not Amazon.</span></Fragment>
		<Fragment slot="lead">Authors build audiences. Marketplaces own the customer relationship and charge platform fees of up to <strong>35%</strong>.</Fragment>
		<Fragment slot="body">WePub helps you build direct, long-term relationships with readers...</Fragment>
		<p class="authors-hero-fee-line">...while charging just a <strong class="authors-hero-fee">5%</strong> sales commission.</p>
		<div class="cta-row">
			<a class="button" href="/wepub">Start publishing</a>
			<a class="button button--secondary" href="/pricing">See pricing</a>
			<a class="button button--secondary author-protection-button" href="/security#control-who-reads">
				<span class="author-protection-button-label">We protect your book</span>
				<span class="author-protection-icon" aria-hidden="true">
					<SectionIcon type="security" title="Protection icon" />
				</span>
			</a>
		</div>
	</HeroSection>

	<section class="section section--gray wepub-new-old-model-section">
		<section class="wepub-new-source-gray-block wepub-new-source-wepub-block">
			<header class="section-header">
				<h2><span class="section-title-rest">The old publishing model</span> <span class="section-title-accent">creates files—not lasting reader relationships</span></h2>
				<p class="section-lead">Most publishing systems distribute files through marketplaces, surrendering the direct relationship between authors and readers.</p>
			</header>
			<CardGrid columns="2">
				<Card
					title="Marketplace control"
					body="Books are packaged as files and handed to marketplaces that own discovery, customer access, and most of the data."
				/>
				<Card
					title="Why the model fails"
					body="The author gets distribution, but the sale ends the relationship while the platform keeps the audience."
				/>
			</CardGrid>
		</section>

		<section class="wepub-new-source-gray-block wepub-new-source-authors-block">
			<header class="section-header">
				<h2><span class="section-title-accent">What</span> <span class="section-title-rest">authors lose today</span></h2>
				<p class="section-lead">The dominant publishing model gives authors distribution while taking away the direct reader relationship.</p>
			</header>
			<div class="card-grid wepub-new-source-authors-loss-grid">
				<div class="card">
					<h3>Audience ownership</h3>
					<p>You sell the books. The platform owns the customer.</p>
				</div>
				<div class="card">
					<h3>Reader relationships</h3>
					<p>You rarely know who your readers are, what they finish, what they discuss, or what brings them back.</p>
				</div>
				<div class="card">
					<h3>Community</h3>
					<p>Discussion happens elsewhere, disconnected from your book and your author presence.</p>
				</div>
				<div class="card">
					<h3>Economics</h3>
					<p>High commissions and marketplace dependence reduce author control.</p>
				</div>
				<div class="card">
					<h3>Context</h3>
					<p>Reader reactions disappear into reviews, star ratings, and external social feeds.</p>
				</div>
			</div>
		</section>

	</section>

	<Section tone="white" class="wepub-new-source-solution-section">
		<Fragment slot="title"><em class="wepub-new-source-solution-title-prefix">The solution:</em><ProductName name="WePub" /> builds a direct web presence</Fragment>
		<h3 class="wepub-new-source-solution-lede">WePub treats each book as a web publication that can be read, found, discussed, and connected to the author over time.</h3>
		<CardGrid columns="3" class="wepub-new-source-icon-grid">
			<article class="card icon-grid-card">
				<SectionIcon type="publisher" title="Web-native book pages" />
				<div class="icon-grid-card-copy">
					<h3>Web-native book pages</h3>
					<p>Each title can live as a readable web asset—not only as a downloadable package.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="author" title="Author-centered publishing" />
				<div class="icon-grid-card-copy">
					<h3>Author-centered publishing</h3>
					<p>The author's presence stays connected to the work and the people reading it.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="fan" title="Reader connection" />
				<div class="icon-grid-card-copy">
					<h3>Reader connection</h3>
					<p>Discussion and reader activity remain attached to books and authors after publication.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<section class="section section--green wepub-flow-slider-section section-continuation" aria-label="WePub publishing flow">
		<div
			class="wepub-flow-slider-frame"
			data-wepub-flow-slider
			data-slides={JSON.stringify(publishingFlowSlides)}
		>
			<button class="wepub-flow-slider-arrow wepub-flow-slider-arrow--prev" type="button" aria-label="Previous slide" data-flow-control="prev">‹</button>
			<div class="wepub-flow-slider-shell">
				<div class="wepub-flow-slider">
					<div class="wepub-flow-top-stage" aria-hidden="true">
						<img
							class="wepub-flow-top-image is-current"
							src={publishingFlowSlides[0].top}
							alt=""
							loading="eager"
							decoding="async"
							width="1900"
							height="265"
							data-flow-top-current-image
						/>
						<img
							class="wepub-flow-top-image"
							src={publishingFlowSlides[1].top}
							alt=""
							loading="lazy"
							decoding="async"
							width="1900"
							height="265"
							data-flow-top-next-image
						/>
					</div>
					<div class="wepub-flow-body-window">
						<img
							class="wepub-flow-body-image is-current"
							src={publishingFlowSlides[0].body}
							alt={`WePub publishing flow screen ${publishingFlowSlides[0].number}`}
							loading="eager"
							decoding="async"
							width="1900"
							height="1104"
							data-flow-current-image
						/>
						<img
							class="wepub-flow-body-image"
							src={publishingFlowSlides[1].body}
							alt={`WePub publishing flow screen ${publishingFlowSlides[1].number}`}
							loading="lazy"
							decoding="async"
							width="1900"
							height="1104"
							data-flow-next-image
						/>
					</div>
					<div class="wepub-flow-preload" aria-hidden="true">
						{publishingFlowSlides.slice(2).map((slide) => (
							<img
								src={slide.top}
								alt=""
								loading="lazy"
								decoding="async"
								width="1900"
								height="265"
							/>
						))}
						{publishingFlowSlides.slice(2).map((slide) => (
							<img
								src={slide.body}
								alt=""
								loading="lazy"
								decoding="async"
								width="1900"
								height="1104"
							/>
						))}
					</div>
				</div>
			</div>
			<button class="wepub-flow-slider-arrow wepub-flow-slider-arrow--next" type="button" aria-label="Next slide" data-flow-control="next">›</button>
		</div>
	</section>

	<Section tone="white" class="wepub-path-section section--two-column" title="What changes when you publish with ReaderPub">
		<div class="wepub-comparison-grid">
			<article class="comparison-text-panel wepub-list-card wepub-old-path-card">
				<div class="card-copy">
					<h3>Old publishing path</h3>
					<ul class="wepub-model-list">
						<li>Prepare a book file</li>
						<li>Upload it to a marketplace</li>
						<li>Let the platform own discovery and customer access</li>
						<li>Lose visibility into reader activity after purchase</li>
					</ul>
				</div>
			</article>
			<article class="card card--good wepub-list-card wepub-readerpub-path-card">
				<div class="card-copy">
					<h3><span class="readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> publishing path</h3>
					<ul class="wepub-model-list">
						<li>Create an active, browser-based publication</li>
						<li>Build an author-centered web presence</li>
						<li>Keep reader relationships connected</li>
						<li>Support discussion and future work around the book</li>
					</ul>
				</div>
			</article>
		</div>
		<div class="wepub-path-workflow-image" data-media-reveal-origin="bottom">
			<img
				class="image-block wepub-path-workflow-image-asset"
				src="/images/wepub.webp"
				alt="Four-step WePub workflow: upload, adjust, price, then sell and engage"
				loading="lazy"
				decoding="async"
				width="1024"
				height="900"
			/>
		</div>
		<div class="wepub-start-grid">
			<article class="card wepub-start-card">
				<div class="card-copy">
					<h3>What you get with WePub</h3>
					<p class="wepub-start-lede">Everything you need to publish, monetize, and grow a direct audience.</p>
					<ul class="wepub-start-list">
						<li>A fast web edition that readers can open instantly.</li>
						<li>Direct sales to connected readers.</li>
						<li>A low 5% commission on sales.</li>
						<li>Fan clubs for every book and author.</li>
						<li>Sales and engagement analytics.</li>
						<li>Optional, production-ready EPUB output.</li>
					</ul>
				</div>
			</article>
			<article class="card wepub-start-card">
				<div class="card-copy">
					<h3>How publishing works</h3>
					<p class="wepub-start-lede">A simple workflow from manuscript to live web edition.</p>
					<ol class="wepub-start-list">
						<li>Share your manuscript (Word or EPUB).</li>
						<li>We prepare your web edition and metadata.</li>
						<li>You define sales and fan-club options.</li>
						<li>Your book goes live&mdash;with analytics from day one.</li>
					</ol>
					<p class="wepub-start-lede wepub-compat-lede">
						Works with WeRead for web reading and BookTree for organizing sources.
					</p>
				</div>
			</article>
		</div>
	</Section>

	<SpecCardsSection tone="green" class="authors-source-section authors-model-section section--two-column">
		<h2><span class="readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> changes the author model</h2>
		<div class="model-grid">
			<div class="comparison-text-panel model-card marketplace-model-card">
				<h3>Marketplace publishing</h3>
				<ul class="comparison-list">
					<li>High commissions</li>
					<li>The platform owns the customer</li>
					<li>Reviews replace conversation</li>
					<li>Marketplace algorithms control discovery</li>
					<li>Readers leave after purchase</li>
				</ul>
			</div>
			<div class="card card--good model-card readerpub-model-card">
				<h3><span class="readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> publishing</h3>
				<ul class="comparison-list">
					<li>5% platform commission</li>
					<li>An author-centered web presence</li>
					<li>Reader relationships stay connected</li>
					<li>Discussion stays attached to books and authors</li>
					<li>Books remain active after publication</li>
				</ul>
			</div>
		</div>
	</SpecCardsSection>

	<SpecCardsSection class="authors-source-section authors-benefits-section section--two-column section-continuation">
		<div class="authors-living-layout">
			<div class="authors-living-copy">
				<h2>From a one-time sale to a living audience</h2>
				<p class="lede">
					ReaderPub turns every book into a long-term web asset—easy to read, easy to find, easy to discuss, and always connected to future work.
				</p>
			</div>
			<div class="card-grid authors-living-grid">
				<div class="card author-benefit-card">
					<div class="author-benefit-heading">
						<SectionIcon type="dollars" title="Monetize your catalog" />
						<h2>Monetize your catalog</h2>
					</div>
					<p class="author-benefit-lede">Publish on the web—with optional EPUB output whenever you need it.</p>
					<ul class="bullets">
						<li>Direct sales</li>
						<li>Bundles and promotions (optional)</li>
						<li>Fan clubs and memberships</li>
						<li>A web edition plus optional, production-ready EPUB delivery.</li>
					</ul>
					<p class="author-benefit-note">
						Save with a <strong class="author-save-highlight">5%</strong> commission versus Amazon's 35%. Use the resources you keep to promote your books on ReaderPub.
					</p>
				</div>
				<div class="card author-benefit-card">
					<div class="author-benefit-heading">
						<SectionIcon type="readerBook" title="Sell directly to your readers" />
						<h2>Sell directly—and communicate with your readers.</h2>
					</div>
					<p class="author-benefit-lede">Keep your audience, keep your data, and keep more from every sale.</p>
					<ul class="bullets">
						<li>Sell web editions and ebooks directly through ReaderPub.</li>
						<li>Pay a 5% sales commission—far below Amazon's take.</li>
						<li>See sales and reader-engagement analytics in one place.</li>
						<li>Receive context-rich reader notes attached to exact passages—not generic comments.</li>
					</ul>
				</div>
				<div class="card author-benefit-card">
					<div class="author-benefit-heading">
						<SectionIcon type="author" title="Author benefits" />
						<h2>Author benefits</h2>
					</div>
					<p class="author-benefit-lede">Everything you need to publish, manage, and grow your work.</p>
					<ul class="bullets">
						<li>Organize sources, annotations, and drafts in one place.</li>
						<li>Publish to a public audience or private collaborators.</li>
						<li>Build authority with transparent references and updates.</li>
						<li>Keep work structured across projects and editions.</li>
					</ul>
				</div>
				<div class="card author-benefit-card">
					<div class="author-benefit-heading">
						<SectionIcon type="research" title="Make your research legible" />
						<h2>Make your research legible</h2>
					</div>
					<p class="author-benefit-lede">Show readers where ideas come from and where they lead.</p>
					<ul class="bullets">
						<li>Show sources, references, and context alongside your texts.</li>
						<li>Present evolving ideas transparently, not as static PDFs.</li>
						<li>Invite readers, collaborators, and institutions into your work.</li>
						<li>Turn research and writing into a readable public record.</li>
					</ul>
				</div>
				<div class="card author-benefit-card author-benefit-card--scribe">
					<div class="author-benefit-heading">
						<SectionIcon type="program" title="Writing and publishing companion" />
						<h2>Scribe: Your writing and publishing companion</h2>
					</div>
					<p class="author-benefit-lede">Scribe gives authors a focused AI companion for developing ideas, shaping drafts, comparing publishing options, planning launches, and clarifying ReaderPub workflows across writing, editing, publishing, and long-term audience development.</p>
				</div>
			</div>
		</div>
	</SpecCardsSection>

	<Section tone="green" class="wepub-economics-section">
		<Fragment slot="title">Better economics, stronger connections, and<br /> <span class="green-heading-white">longer-lasting value</span></Fragment>
		<CardGrid columns="3">
			<Card title="Lower commission" body="ReaderPub charges a 5% platform commission on direct sales." />
			<Card
				title="Better reader connection"
				body="Reader relationships stay connected to the author rather than disappearing into a marketplace account."
			/>
			<Card
				title="Longer book lifecycle"
				body="Books remain active as web assets through discovery, discussion, and future author activity."
			/>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		class="wepub-new-infrastructure-section"
		title="Publishing infrastructure built for the web"
		body="WePub brings secure publishing, browser delivery, direct sales, and audience visibility into one publishing workflow."
	>
		<CardGrid columns="3">
			<Card icon="webReader" title="Web-native publishing" body="Publish books as web destinations instead of isolated downloads." />
			<Card icon="reader" title="Reader visibility" body="Maintain visibility into publication activity after release." />
			<Card icon="security" title="Anti-piracy" body="Protect access through obfuscated web delivery." />
			<Card icon="sale" title="Direct sales" body="Build direct commercial relationships with readers." />
			<Card icon="epubFile" title="EPUB generation" body="Generate EPUB editions whenever external distribution requires them." />
			<Card icon="fan" title="Long-term engagement" body="Keep publications connected to readers after launch." />
		</CardGrid>
	</Section>

	<Section
		tone="green"
		class="wepub-new-relationship-section"
		body="A web-native publication keeps generating discovery, engagement, and discussion after release. It remains part of an ongoing relationship instead of becoming a completed transaction."
	>
		<Fragment slot="title">From digital files <span class="green-heading-white">to living web assets</span></Fragment>
		<CardGrid columns="4">
			<Card title="Visibility" body="Reader activity remains visible." />
			<Card title="Engagement" body="Discussion continues after publication." />
			<Card title="Discovery" body="New readers continue discovering the work." />
			<Card title="Continuity" body="Publications stay active over time." />
		</CardGrid>
		<p class="section-lead">
			ReaderPub helps publishers turn books and knowledge publications into living web assets that stay active after release.
		</p>
		<CardGrid columns="4">
			<Card icon="readerBook" title="Readers" body="Keep engaging with the publication." />
			<Card icon="author" title="Authors" body="Maintain stronger relationships with readers." />
			<Card icon="publisher" title="Publishers" body="Gain visibility beyond the moment of sale." />
			<Card icon="library" title="Institutions" body="Publish knowledge that remains discoverable and useful over time." />
		</CardGrid>
	</Section>

	<CtaBlock
		title="Stop renting your audience."
		body="Publish browser-readable books that remain discoverable, discussable, and connected to readers long after release."
		actions={[finalPublishAction, pricingAction]}
	/>
</Base>

<style>
	:global(.wepub-new-hero .hero-copy) {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	:global(.wepub-new-hero .hero-copy > *) {
		margin: 0;
	}

	:global(.wepub-new-hero h1) {
		line-height: var(--line-height-heading);
	}

	:global(.wepub-new-hero .hero-lead) {
		color: var(--text) !important;
		font-size: 19.5px !important;
		line-height: var(--line-height-body) !important;
	}

	:global(.wepub-new-hero .hero-lead strong) {
		color: inherit;
		font-weight: 700;
	}

	:global(.wepub-new-hero .hero-body) {
		max-width: 720px;
		color: var(--accent) !important;
		font-family: var(--font-heading);
		font-size: clamp(22.1px, 2.72vw, 32.3px);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--letter-spacing-heading);
		line-height: var(--line-height-heading);
	}

	:global(.wepub-new-hero .authors-hero-fee-line) {
		max-width: 760px;
		color: var(--text);
		font-size: 22.425px;
		line-height: var(--line-height-body);
	}

	:global(.wepub-new-hero .authors-hero-fee) {
		color: var(--accent);
		font-weight: 700;
	}

	:global(.wepub-new-hero .button) {
		min-height: 0;
		padding: 10px 18px;
		font-size: 14px;
		font-weight: 500;
	}

	:global(.wepub-new-hero .button--secondary) {
		background: var(--accent);
		color: #ffffff;
		border-color: transparent;
	}

	:global(.wepub-new-hero .button--secondary:hover) {
		background: var(--text);
		color: #ffffff;
		border-color: transparent;
	}

	:global(.wepub-new-hero .author-protection-button) {
		--author-protection-shield-fill: var(--accent);
		display: inline-flex !important;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding-top: 6px;
		padding-bottom: 6px;
	}

	:global(.wepub-new-hero .author-protection-button:hover) {
		--author-protection-shield-fill: var(--text);
	}

	:global(.wepub-new-hero .author-protection-icon) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 23.8px;
		height: 23.8px;
		flex-shrink: 0;
	}

	:global(.wepub-new-hero .author-protection-icon .section-icon) {
		display: block;
		width: 100% !important;
		height: 100% !important;
		stroke: #ffffff;
	}

	:global(.wepub-new-hero .author-protection-icon .section-icon [fill]) {
		fill: var(--author-protection-shield-fill) !important;
	}

	.wepub-new-source-gray-block {
		display: grid;
		gap: 28px;
	}

	.wepub-new-source-authors-block {
		margin-top: calc(var(--section-stack-gap) - 28px);
	}

	:global(.wepub-new-source-solution-section > .section-header) {
		justify-self: stretch;
		width: 100%;
		max-width: none;
		text-align: center;
	}

	:global(.wepub-new-source-solution-section > .section-header h2) {
		text-align: center;
	}

	:global(.wepub-economics-section .card) {
		min-height: 0;
	}

	.wepub-new-source-solution-title-prefix {
		font-style: italic;
	}

	.wepub-new-source-solution-title-prefix::after {
		content: "\00a0\00a0";
	}

	.wepub-new-source-solution-lede {
		justify-self: center;
		width: min(100%, 980px);
		margin: 0;
		color: var(--accent);
		font-size: clamp(1.25rem, 2.1vw, 1.8rem);
		line-height: var(--line-height-heading);
		text-align: center;
	}

	.wepub-comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.wepub-path-workflow-image {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.wepub-start-grid {
