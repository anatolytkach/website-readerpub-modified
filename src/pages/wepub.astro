---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import SectionIcon from "../components/SectionIcon.astro";
import ProductName from "../components/ProductName.astro";
import { PUBLISH_URL, SITE_NAME } from "../consts";

const publishAction = { label: "Publish with WePub", href: PUBLISH_URL, external: true };
const pricingAction = { label: "See pricing", href: "/pricing", variant: "secondary" as const };
const publishingFlowSlides = Array.from({ length: 6 }, (_, index) => {
	const number = index + 1;

	return {
		number,
		top: `/images/wepub-publishing-flow/top_${number}.png`,
		body: `/images/wepub-publishing-flow/body_${number}.png`,
	};
});
---

<Base
	title={`WePub | ${SITE_NAME}`}
	description="WePub helps authors and publishers create browser-readable books that remain connected to readers, discussion and discovery after release."
>
	<HeroSection
		eyebrow="WePub"
		lead="Most publishing systems are built to distribute files through marketplaces, surrendering the book audience to the marketplace."
		image="/images/wepub.webp"
		imageAlt="WePub publishing workflow from manuscript to live book"
		actions={[publishAction, pricingAction]}
		spacerBackgroundPositionY="18%"
	>
		<Fragment slot="title"><span style="color: var(--accent);">We<span class="hero-product-part-accent">Pub</span><span class="hero-title-colon">:</span></span><br /><span class="hero-title-rest">Publish to readers, you never lose.</span></Fragment>
		<Fragment slot="body">ReaderPub turns books into living web assets: readable, searchable, discussable and connected, so authors and publishers achieve strategic distribution.</Fragment>
	</HeroSection>

	<Section
		tone="gray"
		class="wepub-old-model-section"
		body="A file-based model can distribute a book, but it usually separates the author from the reader."
	>
		<Fragment slot="title"><span class="section-title-rest">The old model</span> <span class="section-title-accent">just creates book files for download</span></Fragment>
		<CardGrid columns="2">
			<Card
				title="Problem"
				body="Books are packaged as files and handed to marketplaces that own discovery, customer access and most of the data."
			/>
			<Card
				title="Why it fails"
				body="The sale ends the relationship. The author gets distribution, but the platform keeps the audience."
			/>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		class="wepub-solution-section"
	>
		<Fragment slot="title"><em class="wepub-solution-title-prefix">The solution:</em><ProductName name="WePub" /> builds direct web presence</Fragment>
		<h3 class="wepub-solution-lede">WePub treats a book as a web publication that can be read, found, discussed and connected to the author over time.</h3>
		<CardGrid columns="3" class="wepub-source-icon-grid">
			<article class="card icon-grid-card">
				<SectionIcon type="publisher" title="Web-native book pages" />
				<div class="icon-grid-card-copy">
					<h3>Web-native book pages</h3>
					<p>Each title can live as a readable web asset, not only as a downloadable package.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="author" title="Author-centered publishing" />
				<div class="icon-grid-card-copy">
					<h3>Author-centered publishing</h3>
					<p>The author's presence stays connected to the work and to the people reading it.</p>
				</div>
			</article>
			<article class="card icon-grid-card">
				<SectionIcon type="fan" title="Reader connection" />
				<div class="icon-grid-card-copy">
					<h3>Reader connection</h3>
					<p>Discussion and activity remain attached to books and authors after publication.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<section class="section section--green wepub-flow-slider-section section-continuation" aria-label="WePub publishing flow">
		<div
			class="wepub-flow-slider-frame"
			data-wepub-flow-slider
			data-slides={JSON.stringify(publishingFlowSlides)}
		>
			<button class="wepub-flow-slider-arrow wepub-flow-slider-arrow--prev" type="button" aria-label="Previous slide" data-flow-control="prev">‹</button>
			<div class="wepub-flow-slider-shell">
				<div class="wepub-flow-slider">
					<div class="wepub-flow-top-stage" aria-hidden="true">
						<img
							class="wepub-flow-top-image is-current"
							src={publishingFlowSlides[0].top}
							alt=""
							loading="eager"
							decoding="async"
							width="1900"
							height="265"
							data-flow-top-current-image
						/>
						<img
							class="wepub-flow-top-image"
							src={publishingFlowSlides[1].top}
							alt=""
							loading="lazy"
							decoding="async"
							width="1900"
							height="265"
							data-flow-top-next-image
						/>
					</div>
					<div class="wepub-flow-body-window">
						<img
							class="wepub-flow-body-image is-current"
							src={publishingFlowSlides[0].body}
							alt={`WePub publishing flow screen ${publishingFlowSlides[0].number}`}
							loading="eager"
							decoding="async"
							width="1900"
							height="1104"
							data-flow-current-image
						/>
						<img
							class="wepub-flow-body-image"
							src={publishingFlowSlides[1].body}
							alt={`WePub publishing flow screen ${publishingFlowSlides[1].number}`}
							loading="lazy"
							decoding="async"
							width="1900"
							height="1104"
							data-flow-next-image
						/>
					</div>
					<div class="wepub-flow-preload" aria-hidden="true">
						{publishingFlowSlides.slice(2).map((slide) => (
							<img
								src={slide.top}
								alt=""
								loading="lazy"
								decoding="async"
								width="1900"
								height="265"
							/>
						))}
						{publishingFlowSlides.slice(2).map((slide) => (
							<img
								src={slide.body}
								alt=""
								loading="lazy"
								decoding="async"
								width="1900"
								height="1104"
							/>
						))}
					</div>
				</div>
			</div>
			<button class="wepub-flow-slider-arrow wepub-flow-slider-arrow--next" type="button" aria-label="Next slide" data-flow-control="next">›</button>
		</div>
	</section>

		<Section tone="white" class="wepub-path-section section--two-column" title="What changes when you publish on ReaderPub">
		<div class="wepub-comparison-grid">
			<article class="comparison-text-panel wepub-list-card wepub-old-path-card">
				<div class="card-copy">
					<h3>Old publishing path</h3>
					<ul class="wepub-model-list">
						<li>Prepare a file</li>
						<li>Upload to a marketplace</li>
						<li>Let the platform own discovery and customer access</li>
						<li>Watch reader activity disappear after purchase</li>
					</ul>
				</div>
			</article>
			<article class="card card--good wepub-list-card wepub-readerpub-path-card">
				<div class="card-copy">
					<h3><span class="readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> path</h3>
					<ul class="wepub-model-list">
						<li>Create an active browser-based publication</li>
						<li>Build an author-centered web presence</li>
						<li>Keep reader relationships connected</li>
						<li>Support discussion and future work around the book</li>
					</ul>
				</div>
			</article>
		</div>
		<div class="wepub-start-grid">
			<article class="card wepub-start-card">
				<div class="card-copy">
					<h3>What you get</h3>
					<p class="wepub-start-lede">Everything you need to publish, monetize, and grow a direct audience.</p>
					<ul class="wepub-start-list">
						<li>A fast web edition readers can open instantly.</li>
						<li>Direct sales to connected readers.</li>
						<li>Low 5% commission on sales.</li>
						<li>Fan clubs for every book and author.</li>
						<li>Analytics for sales and engagement.</li>
						<li>Optional production-ready EPUB output.</li>
					</ul>
				</div>
			</article>
			<article class="card wepub-start-card">
				<div class="card-copy">
					<h3>How publishing works</h3>
					<p class="wepub-start-lede">A simple workflow from manuscript to live web edition.</p>
					<ol class="wepub-start-list">
						<li>Share your manuscript (Word, or EPUB).</li>
						<li>We prepare your web edition and metadata.</li>
						<li>You define sales and fan-club options.</li>
						<li>Your book goes live &mdash; with analytics from day one.</li>
					</ol>
					<p class="wepub-start-lede wepub-compat-lede">
						Compatible with WeRead for web reading and BookTree for organizing sources.
					</p>
				</div>
			</article>
		</div>
	</Section>

	<Section tone="green" class="wepub-economics-section">
		<Fragment slot="title">Better economics, stronger connections, <span class="green-heading-white">longer-lasting value</span></Fragment>
		<CardGrid columns="3">
			<Card title="Lower commission" body="ReaderPub uses a 5% platform commission for direct sales." />
			<Card
				title="Better reader connection"
				body="Reader relationships stay connected to the author instead of disappearing into a marketplace account."
			/>
			<Card
				title="Longer book lifecycle"
				body="Books remain active as web assets through discovery, discussion and future author activity."
			/>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		class="wepub-infrastructure-section"
		title="Publishing infrastructure built for the web"
		body="WePub combines secure publishing, browser delivery, direct sales and audience visibility inside a single publishing workflow."
	>
		<CardGrid columns="3">
			<Card title="Web-native publishing" body="Publish books as web destinations rather than isolated downloads." />
			<Card title="Reader visibility" body="Maintain visibility into publication activity after release." />
			<Card title="Anti-piracy" body="Protect access through obfuscated web delivery." />
			<Card title="Direct sales" body="Build direct commercial relationships with readers." />
			<Card title="EPUB generation" body="Generate EPUB editions when external distribution requires them." />
			<Card title="Long-term engagement" body="Keep publications connected to readers after launch." />
		</CardGrid>
	</Section>

	<Section
		tone="green"
		body="ReaderPub helps publishers transform books and knowledge publications into living web assets that remain active after release."
		>
			<Fragment slot="title">From digital files <span class="green-heading-white">to living web assets</span></Fragment>
			<CardGrid columns="4">
				<Card icon="readerBook" title="Readers" body="Continue engaging with the publication." />
				<Card icon="author" title="Authors" body="Maintain stronger reader relationships." />
				<Card icon="publisher" title="Publishers" body="Gain visibility beyond the moment of sale." />
				<Card icon="library" title="Institutions" body="Publish knowledge that remains discoverable and useful over time." />
			</CardGrid>
		</Section>

	<CtaBlock
		title="Publish living web assets."
		body="Move beyond file delivery and build publications that remain alive after release."
		actions={[publishAction, pricingAction]}
	/>
</Base>

<style>
	.wepub-comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	@media (min-width: 901px) {
		:global(.wepub-old-model-section .section-header h2) {
			font-size: clamp(1.71rem, 2.7vw, 1.872rem);
			white-space: normal;
		}

		:global(.wepub-old-model-section .section-lead) {
			font-size: clamp(1rem, 1.55vw, 1.08rem);
			white-space: normal;
		}
	}

	.wepub-start-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.wepub-start-card {
		min-height: 0;
	}

	.wepub-start-lede {
		color: var(--accent-copy);
		font-size: 1.125rem;
		line-height: var(--line-height-body);
	}

	.wepub-start-list {
		display: grid;
		gap: 10px;
		padding-left: 1.15rem;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}

	ul.wepub-start-list,
	ul.wepub-start-list li {
		list-style: disc;
	}

	ol.wepub-start-list,
	ol.wepub-start-list li {
		list-style: decimal;
	}

	.wepub-start-list li::marker {
		color: var(--accent);
	}

	.wepub-compat-lede {
		margin-top: 0;
	}

	.wepub-list-card {
		min-height: 0;
	}

	.wepub-old-path-card {
		background: var(--card-bg);
	}

	.wepub-old-path-card .wepub-model-list li::marker {
		color: var(--text);
	}

	.wepub-readerpub-path-card {
		background: var(--card-bg);
	}

	.wepub-readerpub-path-card h3 > .readerpub-heading-word {
		color: var(--accent);
	}

	:global(.section.wepub-path-section) {
		padding-top: calc(var(--section-padding) * 0.4375) !important;
	}

	@media (orientation: portrait) {
		:global(.section.wepub-path-section) {
			padding-top: var(--section-padding) !important;
		}
	}

	:global(.wepub-economics-section .card) {
		min-height: 0;
	}

	:global(.wepub-infrastructure-section .card) {
		min-height: 0;
	}

	.wepub-model-list {
		display: grid;
		gap: 10px;
		padding-left: 1.15rem;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}

	.wepub-model-list li::marker {
		color: var(--accent);
	}

	.wepub-supporting-text {
		color: var(--accent-copy);
		font-size: 1.125rem;
		line-height: var(--line-height-body);
	}

	:global(.wepub-solution-section > .section-header) {
		justify-self: stretch;
		width: 100%;
		max-width: none;
		text-align: center;
	}

	:global(.wepub-solution-section > .section-header h2) {
		text-align: center;
	}

	.wepub-solution-title-prefix {
		font-style: italic;
	}

	.wepub-solution-title-prefix::after {
		content: "\00a0\00a0";
	}

	.wepub-solution-lede {
		justify-self: center;
		width: min(100%, 980px);
		margin: 0;
		color: var(--accent);
		font-size: clamp(1.25rem, 2.1vw, 1.8rem);
		line-height: var(--line-height-heading);
		text-align: center;
	}

	.wepub-flow-slider-section {
		--wepub-flow-radius: min(16px, calc(var(--radius-card) * 1.5));
		display: block;
	}

	.wepub-flow-slider-frame {
		position: relative;
		width: min(80%, calc(100vw - 144px), 1900px);
		max-width: 100%;
		margin-inline: auto;
	}

	.wepub-flow-slider-shell {
		width: 100%;
		max-width: 100%;
		overflow: hidden;
		border-radius: var(--wepub-flow-radius);
		background: #ffffff;
		box-shadow: var(--card-green-shadow);
	}

	.wepub-flow-slider {
		position: relative;
		display: grid;
		width: 100%;
		max-width: 100%;
		overflow: hidden;
		background: #ffffff;
	}

	.wepub-flow-top-stage {
		position: relative;
		width: 100%;
		max-width: 100%;
		aspect-ratio: 1900 / 265;
		overflow: hidden;
		background: #ffffff;
	}

	.wepub-flow-top-image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0;
		transition: opacity 720ms cubic-bezier(0.22, 1, 0.36, 1);
		will-change: opacity;
	}

	.wepub-flow-top-image.is-current,
	.wepub-flow-top-image.is-entering {
		opacity: 1;
	}

	.wepub-flow-top-image.is-current {
		z-index: 1;
	}

	.wepub-flow-top-image.is-entering {
		z-index: 2;
	}

	.wepub-flow-top-image.is-resetting {
		transition: none;
	}

	.wepub-flow-body-window {
		position: relative;
		width: 100%;
		max-width: 100%;
		aspect-ratio: 1900 / 1104;
		overflow: hidden;
		background: #ffffff;
	}

	.wepub-flow-body-image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transform: translateX(100%);
		transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.wepub-flow-body-image.is-current {
		z-index: 1;
		transform: translateX(0);
	}

	.wepub-flow-body-image.is-entering-next,
	.wepub-flow-body-image.is-entering-prev,
	.wepub-flow-body-image.is-entered {
		z-index: 2;
	}

	.wepub-flow-body-image.is-exiting-next {
		transform: translateX(-100%);
	}

	.wepub-flow-body-image.is-exiting-prev {
		transform: translateX(100%);
	}

	.wepub-flow-body-image.is-entering-next {
		transform: translateX(100%);
	}

	.wepub-flow-body-image.is-entering-prev {
		transform: translateX(-100%);
	}

	.wepub-flow-body-image.is-entered {
		transform: translateX(0);
	}

	.wepub-flow-body-image.is-resetting {
		transition: none;
	}

	.wepub-flow-slider-arrow {
		--wepub-flow-arrow-line-length: 12px;
		--wepub-flow-arrow-line-stroke: 2px;
		--wepub-flow-arrow-line-half-stroke: calc(var(--wepub-flow-arrow-line-stroke) / 2);
		--wepub-flow-arrow-tip-offset: calc(var(--wepub-flow-arrow-line-length) * 0.3535533906);
		border: 0;
		font-family: var(--font-ui);
		cursor: pointer;
		position: absolute;
		top: 50%;
		z-index: 5;
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		background: var(--accent-orange);
		color: #ffffff;
		font-size: 0;
		line-height: 0;
		transform: translateY(-50%);
		transition:
			background var(--motion-deliberate) ease,
			color var(--motion-deliberate) ease;
	}

	.wepub-flow-slider-arrow::before,
	.wepub-flow-slider-arrow::after {
		content: "";
		position: absolute;
		top: calc(50% - var(--wepub-flow-arrow-line-half-stroke));
		display: block;
		width: var(--wepub-flow-arrow-line-length);
		height: var(--wepub-flow-arrow-line-stroke);
		border-radius: 999px;
		background: currentColor;
	}

	.wepub-flow-slider-arrow--prev::before,
	.wepub-flow-slider-arrow--prev::after {
		left: calc(50% - var(--wepub-flow-arrow-tip-offset));
		transform-origin: 0 50%;
	}

	.wepub-flow-slider-arrow--next::before,
	.wepub-flow-slider-arrow--next::after {
		left: calc(50% + var(--wepub-flow-arrow-tip-offset) - var(--wepub-flow-arrow-line-length));
		transform-origin: 100% 50%;
	}

	.wepub-flow-slider-arrow--prev::before,
	.wepub-flow-slider-arrow--next::after {
		transform: rotate(-45deg);
	}

	.wepub-flow-slider-arrow--prev::after,
	.wepub-flow-slider-arrow--next::before {
		transform: rotate(45deg);
	}

	.wepub-flow-slider-arrow--prev {
		left: -62px;
	}

	.wepub-flow-slider-arrow--next {
		right: -62px;
	}

	.wepub-flow-slider-arrow:hover,
	.wepub-flow-slider-arrow:focus-visible {
		background: #ffffff !important;
		color: var(--accent-orange);
	}

	.wepub-flow-preload {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	:global(.wepub-source-icon-grid .card.icon-grid-card) {
		display: grid !important;
		grid-template-columns: var(--card-icon-column) minmax(0, 1fr) !important;
		column-gap: var(--card-icon-gap) !important;
		row-gap: 16px !important;
		align-items: flex-start;
		width: 100%;
	}

	:global(.wepub-source-icon-grid .icon-grid-card-copy) {
		display: contents;
	}

	:global(.wepub-source-icon-grid .icon-grid-card > .section-icon) {
		grid-column: 1;
		grid-row: 1;
		align-self: center;
		width: var(--card-inline-icon-size) !important;
		height: var(--card-inline-icon-size) !important;
	}

	:global(.wepub-source-icon-grid .icon-grid-card .icon-grid-card-copy > h3) {
		grid-column: 2;
		grid-row: 1;
		align-self: center;
		margin: 0;
	}

	:global(.wepub-source-icon-grid .icon-grid-card .icon-grid-card-copy > p) {
		grid-column: 1 / -1;
	}

	@media (max-width: 900px) {
		.wepub-comparison-grid,
		.wepub-start-grid {
			grid-template-columns: 1fr;
		}

		.wepub-model-list,
		.wepub-start-list {
			text-align: left;
		}

		:global(.wepub-source-icon-grid .icon-grid-card-copy) {
			display: contents;
		}

		.wepub-flow-slider-arrow {
			--wepub-flow-arrow-line-length: 10.667px;
			--wepub-flow-arrow-line-stroke: 2px;
			width: 40px;
			height: 40px;
		}

		.wepub-flow-slider-arrow--prev {
			left: -52px;
		}

		.wepub-flow-slider-arrow--next {
			right: -52px;
		}
	}

	@media (orientation: portrait) {
		.wepub-flow-slider-frame {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			justify-content: center;
			column-gap: 12px;
			row-gap: 12px;
			width: 100%;
		}

		.wepub-flow-slider-shell {
			grid-column: 1 / -1;
			order: 1;
		}

		.wepub-flow-slider-arrow {
			position: relative;
			top: auto;
			order: 2;
			width: 40px;
			height: 40px;
			transform: none;
		}

		.wepub-flow-slider-arrow--prev {
			justify-self: start;
		}

		.wepub-flow-slider-arrow--next {
			justify-self: end;
		}

		.wepub-flow-slider-arrow--prev,
		.wepub-flow-slider-arrow--next {
			right: auto;
			left: auto;
		}
	}
</style>

<script>
	const setupWePubFlowSliders = () => {
		const sliders = document.querySelectorAll<HTMLElement>("[data-wepub-flow-slider]");

		sliders.forEach((slider) => {
			if (slider.dataset.sliderReady === "true") return;

			const slides = JSON.parse(slider.dataset.slides || "[]") as Array<{ number: number; top: string; body: string }>;
			const initialTopCurrentImage = slider.querySelector<HTMLImageElement>("[data-flow-top-current-image]");
			const initialTopNextImage = slider.querySelector<HTMLImageElement>("[data-flow-top-next-image]");
			const initialCurrentImage = slider.querySelector<HTMLImageElement>("[data-flow-current-image]");
			const initialNextImage = slider.querySelector<HTMLImageElement>("[data-flow-next-image]");
			const prevButton = slider.querySelector<HTMLButtonElement>('[data-flow-control="prev"]');
			const nextButton = slider.querySelector<HTMLButtonElement>('[data-flow-control="next"]');
			const total = slides.length;

			if (!initialTopCurrentImage || !initialTopNextImage || !initialCurrentImage || !initialNextImage || total === 0) return;

			slider.dataset.sliderReady = "true";

			let topCurrentImage = initialTopCurrentImage;
			let topNextImage = initialTopNextImage;
			let currentImage = initialCurrentImage;
			let nextImage = initialNextImage;
			let currentIndex = 0;
			let targetIndex = 0;
			let isAnimating = false;
			let isTopAnimating = false;
			const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

			const resetTopStandbyImage = () => {
				topNextImage.className = "wepub-flow-top-image is-resetting";
				window.requestAnimationFrame(() => {
					topNextImage.classList.remove("is-resetting");
				});
			};

			const completeTopTransition = () => {
				if (!isTopAnimating) return;
				const previousTopImage = topCurrentImage;
				topCurrentImage = topNextImage;
				topNextImage = previousTopImage;
				topCurrentImage.className = "wepub-flow-top-image is-current";
				isTopAnimating = false;
				resetTopStandbyImage();
			};

			const setTopImage = (index: number, immediate = false) => {
				const targetSrc = slides[index].top;
				const currentSrc = new URL(topCurrentImage.getAttribute("src") || "", window.location.href).href;
				const targetUrl = new URL(targetSrc, window.location.href).href;

				if (currentSrc === targetUrl) return;
				if (isTopAnimating) completeTopTransition();

				if (immediate || motionQuery.matches) {
					topCurrentImage.src = targetSrc;
					topCurrentImage.className = "wepub-flow-top-image is-resetting is-current";
					isTopAnimating = false;
					resetTopStandbyImage();
					window.requestAnimationFrame(() => {
						topCurrentImage.classList.remove("is-resetting");
					});
					return;
				}

				topNextImage.src = targetSrc;
				topNextImage.className = "wepub-flow-top-image is-resetting";
				isTopAnimating = true;
				const revealTopImage = () => window.requestAnimationFrame(() => {
					topCurrentImage.className = "wepub-flow-top-image";
					topNextImage.className = "wepub-flow-top-image is-entering";
				});

				if (topNextImage.complete) {
					revealTopImage();
				} else {
					topNextImage.decode().then(revealTopImage).catch(revealTopImage);
				}
			};

			const setCurrentBodyImage = (index: number) => {
				currentImage.src = slides[index].body;
				currentImage.alt = `WePub publishing flow screen ${slides[index].number}`;
			};

			const completeTransition = () => {
				if (!isAnimating) return;
				const previousCurrentImage = currentImage;
				currentImage = nextImage;
				nextImage = previousCurrentImage;
				currentImage.className = "wepub-flow-body-image is-current";
				nextImage.className = "wepub-flow-body-image is-resetting";
				currentIndex = targetIndex;
				isAnimating = false;
				window.requestAnimationFrame(() => {
					nextImage.classList.remove("is-resetting");
				});
			};

			const goTo = (nextIndex: number, immediate = false, direction: "next" | "prev" = "next") => {
				if (isAnimating && !immediate) return;

				const normalizedIndex = (nextIndex + total) % total;
				if (normalizedIndex === currentIndex && !immediate) return;

				if (immediate || motionQuery.matches) {
					targetIndex = normalizedIndex;
					setTopImage(targetIndex, true);
					setCurrentBodyImage(targetIndex);
					currentImage.className = "wepub-flow-body-image is-resetting is-current";
					nextImage.className = "wepub-flow-body-image is-resetting";
					currentIndex = targetIndex;
					isAnimating = false;
					window.requestAnimationFrame(() => {
						currentImage.classList.remove("is-resetting");
						nextImage.classList.remove("is-resetting");
					});
					return;
				}

				targetIndex = normalizedIndex;
				isAnimating = true;
				setTopImage(targetIndex);

				nextImage.src = slides[targetIndex].body;
				nextImage.alt = `WePub publishing flow screen ${slides[targetIndex].number}`;
				currentImage.className = "wepub-flow-body-image is-current";
				nextImage.className = `wepub-flow-body-image is-entering-${direction}`;

				window.requestAnimationFrame(() => {
					currentImage.classList.remove("is-current");
					currentImage.classList.add(`is-exiting-${direction}`);
					nextImage.classList.add("is-entered");
				});
			};

			const handleBodyTransitionEnd = (event: TransitionEvent) => {
				if (!isAnimating) return;
				if (event.target !== nextImage || event.propertyName !== "transform") return;
				completeTransition();
			};

			initialCurrentImage.addEventListener("transitionend", handleBodyTransitionEnd);
			initialNextImage.addEventListener("transitionend", handleBodyTransitionEnd);

			const handleTopTransitionEnd = (event: TransitionEvent) => {
				if (!isTopAnimating) return;
				if (event.target !== topNextImage || event.propertyName !== "opacity") return;
				completeTopTransition();
			};

			initialTopCurrentImage.addEventListener("transitionend", handleTopTransitionEnd);
			initialTopNextImage.addEventListener("transitionend", handleTopTransitionEnd);

			prevButton?.addEventListener("click", () => {
				goTo(currentIndex - 1, false, "prev");
			});

			nextButton?.addEventListener("click", () => {
				goTo(currentIndex + 1, false, "next");
			});

			motionQuery.addEventListener("change", () => {
				goTo(currentIndex, true);
			});

			goTo(0, true);
		});
	};

	document.addEventListener("astro:page-load", setupWePubFlowSliders);
	setupWePubFlowSliders();
</script>
