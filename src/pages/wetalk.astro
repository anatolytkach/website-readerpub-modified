---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import ProductName from "../components/ProductName.astro";
import ProductStructuredData from "../components/ProductStructuredData.astro";
import { SITE_NAME } from "../consts";

const requestPilotAction = { label: "Request a Pilot", href: "/contact/?topic=wetalk" };
const contactAction = { label: "Contact Us", href: "/contact/", variant: "secondary" as const };
const institutionHeroActions = [
	{ label: "Build an institutional library", href: "/contact/?topic=institution" },
	{ label: "See pricing", href: "/pricing/", variant: "secondary" as const },
];

const fragmentationCards = [
	{
		title: "Conversations happen elsewhere",
		body: "Discussion often moves to email, chat, learning systems, or public platforms that sit outside the publication.",
	},
	{
		title: "Materials lose context",
		body: "When discussion is separated from the work, comments, decisions, and their context become harder to understand later.",
	},
	{
		title: "Access is difficult to manage",
		body: "Organizations need participation rules that align with courses, cohorts, collections, teams, and restricted programs.",
	},
	{
		title: "Knowledge becomes harder to reuse",
		body: "Valuable discussion can disappear into disconnected threads instead of remaining attached to the material.",
	},
];

const discussionLayerCards = [
	{
		title: "Controlled access",
		body: "Participation can follow the same access model used for controlled-access publications and collections.",
		icon: "access" as const,
	},
	{
		title: "Publication-centered discussion",
		body: "Conversation stays close to books, archives, educational materials, reports, and other institutional publications.",
		icon: "readerBook" as const,
	},
	{
		title: "Professional communities",
		body: "Organizations can support discussion around knowledge without moving it into public social channels.",
		icon: "library" as const,
	},
	{
		title: "Permission-based participation",
		body: "Readers, students, researchers, members, and partners can participate according to their roles and access levels.",
		icon: "security" as const,
	},
];

const workflowCards = [
	{
		title: "Course materials",
		body: "Give classes and cohorts a controlled space to discuss assigned reading and educational materials.",
	},
	{
		title: "Library collections",
		body: "Support reader groups, programs, and collection-centered conversations inside a managed environment.",
	},
	{
		title: "Research publications",
		body: "Keep discussion attached to papers, reports, editions, archives, and research collections.",
	},
	{
		title: "Controlled releases",
		body: "Open selected publications or excerpts for approved groups without making the discussion public.",
	},
	{
		title: "Membership access",
		body: "Connect membership, course, department, or partner access to publication-centered discussion.",
	},
	{
		title: "Community analytics",
		body: "Track discussion, access, and engagement activity around controlled-access content.",
	},
];

const organizationCards = [
	{ title: "Universities", body: "Support classroom, research, and departmental discussion around published materials.", icon: "university" as const },
	{ title: "Libraries", body: "Create managed discussion spaces around collections, programs, and reading rooms.", icon: "library" as const },
	{ title: "Research organizations", body: "Keep research conversations attached to publications, archives, and shared references.", icon: "research" as const },
	{ title: "Public institutions", body: "Host controlled conversations around reports, guides, policies, and public knowledge materials.", icon: "government" as const },
	{ title: "Membership organizations", body: "Give approved members access to publications and related discussion spaces.", icon: "public" as const },
	{ title: "Educational programs", body: "Run program-based discussions around course content, reading lists, and learning materials.", icon: "program" as const },
];

const audienceCards = [
	{ title: "Organizations", body: "Manage publication-centered discussion without exposing materials to public channels.", icon: "library" as const },
	{ title: "Educators", body: "Keep class and cohort discussions close to assigned materials.", icon: "university" as const },
	{ title: "Libraries", body: "Support programs and reading communities through managed participation.", icon: "readerBook" as const },
	{ title: "Readers", body: "Discuss materials where you read them, within the access rules set by the organization.", icon: "reader" as const },
	{ title: "Researchers", body: "Preserve context around publications, notes, archives, and shared references.", icon: "research" as const },
	{ title: "Administrators", body: "Control access, roles, and visibility across publication-centered discussion spaces.", icon: "access" as const },
];
---

<Base
	title={`WeTalk: Private Institutional Discussion Spaces | ${SITE_NAME}`}
	description="Create private, controlled-access discussion spaces around courses, collections, research, archives, and institutional publications with WeTalk."
	canonical="/wetalk/"
	ogImage="/images/wetalk.webp"
>
	<Fragment slot="head">
		<ProductStructuredData
			name="WeTalk"
			description="Create private, controlled-access discussion spaces around courses, collections, research, archives, and institutional publications with WeTalk."
			url="/wetalk/"
			image="/images/wetalk.webp"
		/>
	</Fragment>
	<HeroSection
		eyebrow="WeTalk"
		lead="Universities, libraries, and organizations publish valuable materials that invite discussion—but not always public exposure."
		body="WeTalk creates controlled discussion spaces around the materials an organization publishes and manages."
		image="/images/wetalk.webp"
		imageAlt="WeTalk private discussion spaces for institutional publications, courses, collections, and research"
		actions={institutionHeroActions}
		spacerBackgroundPositionY="100%"
		class="wetalk-hero"
	>
		<Fragment slot="title"><span class="wetalk-hero-product">We<span class="hero-product-part-accent">Talk</span><span class="hero-title-colon">:</span></span><br /><span class="hero-title-rest">Private discussion for institutional knowledge</span></Fragment>
	</HeroSection>

	<Section
		tone="gray"
		body="Organizations often publish valuable materials, but discussion takes place in separate systems where access, context, and long-term value are harder to preserve."
	>
		<Fragment slot="title"><span class="section-title-rest">Institutional discussion</span> <span class="section-title-accent">is fragmented</span></Fragment>
		<CardGrid columns="2">
			{fragmentationCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<section class="section section--white wetalk-solution-heading-section section-continuation">
		<h2 class="wetalk-solution-heading">
			<em class="wetalk-solution-heading-accent">The solution<span class="wetalk-solution-heading-colon">:</span></em><br />
			<ProductName name="WeTalk" /> – A discussion layer for controlled-access content
		</h2>
	</section>

	<Section tone="green" class="wetalk-discussion-layer-section">
		<h3 class="wetalk-discussion-layer-lede">
			<span class="wetalk-discussion-layer-product">WeTalk</span> keeps discussion close to the publications an organization controls, with participation rules aligned with institutional access needs.
		</h3>
		<CardGrid columns="2" class="wetalk-icon-card-grid">
			{discussionLayerCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<Section
		tone="white"
		class="wetalk-workflow-section"
		title="How WeTalk works"
		body="WeTalk supports membership-based access to discussions around course materials, research, restricted releases, and more."
	>
		<CardGrid columns="3">
			{workflowCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<Section tone="green" title="Built for organizations" class="wetalk-organizations-section">
		<CardGrid columns="3" class="wetalk-icon-card-grid">
			{organizationCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<Section
		tone="white"
		class="wetalk-comparison-section section--two-column"
		title="WeTalk and WeBuzz"
		body="ReaderPub supports both public literary conversation and private institutional discussion, but each serves a different need."
	>
		<div class="model-grid wetalk-comparison-grid">
			<article class="card wetalk-comparison-card">
				<h3><ProductName name="WeBuzz" /></h3>
				<p>A public literary community for books, authors, passages, and reader discovery.</p>
				<ul class="bullets">
					<li>Public conversation</li>
					<li>Reader discovery</li>
					<li>Author and book communities</li>
					<li>Open literary participation</li>
				</ul>
			</article>
			<article class="card wetalk-comparison-card">
				<h3><ProductName name="WeTalk" /></h3>
				<p>A private discussion environment for controlled-access institutional content.</p>
				<ul class="bullets">
					<li>Managed participation</li>
					<li>Institutional access rules</li>
					<li>Course and collection discussion</li>
					<li>Controlled-access publications</li>
				</ul>
			</article>
		</div>
	</Section>

	<Section tone="green" title="Who benefits from WeTalk?">
		<CardGrid columns="3">
			{audienceCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<CtaBlock
		title="Knowledge is more valuable when people can discuss it."
		body="WeTalk helps organizations create controlled discussion environments around the materials they publish and manage."
		actions={[institutionHeroActions[0]]}
	/>
</Base>

<style>
	:global(.wetalk-hero-product) {
		color: var(--accent);
	}

	@media (orientation: landscape) and (min-width: 901px) {
		:global(body .page .content .wetalk-hero.hero-section.section--with-media) {
			grid-template-columns: minmax(0, 58%) minmax(0, 40%);
			column-gap: 2%;
		}
	}

	.wetalk-solution-heading-section {
		justify-items: center;
		margin-bottom: 0 !important;
		padding-bottom: 0 !important;
	}

	.wetalk-solution-heading {
		width: 100%;
		max-width: 1180px;
		margin: 0 !important;
		text-align: center;
	}

	.wetalk-solution-heading-accent {
		color: var(--accent-orange);
	}

	.wetalk-solution-heading-colon {
		color: var(--accent);
	}

	:global(.wetalk-discussion-layer-section) {
		margin-top: calc(var(--section-padding) * 0.6) !important;
	}

	.wetalk-discussion-layer-lede {
		justify-self: stretch;
		width: min(100%, 980px);
		margin: 0 !important;
		color: var(--accent-orange) !important;
		font-size: clamp(1.25rem, 1.8vw, 1.55rem);
		line-height: var(--line-height-heading);
		text-align: left;
	}

	.wetalk-discussion-layer-product {
		color: #ffffff !important;
	}

	:global(.wetalk-workflow-section),
	:global(.wetalk-comparison-section) {
		--card-tint: #fcfaf8;
	}

	:global(.wetalk-workflow-section .card),
	:global(.wetalk-comparison-section .card) {
		background: var(--card-bg) !important;
	}

	.wetalk-comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.wetalk-comparison-card {
		align-items: stretch;
		text-align: left;
	}

	.wetalk-comparison-card h3 {
		color: var(--accent);
	}

	.wetalk-comparison-card .bullets {
		display: grid;
		gap: 8px;
		margin: 0;
		padding-left: 20px;
		color: var(--muted);
		font-size: 1rem;
		line-height: var(--line-height-body);
		text-align: left;
	}

	.wetalk-comparison-card .bullets li::marker {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		:global(.wetalk-icon-card-grid .card.card--with-icon) {
			text-align: center;
		}

		:global(.wetalk-icon-card-grid .card.card--with-icon > .card-icon-heading) {
			display: grid !important;
			grid-template-columns: var(--card-icon-heading-size) min(13em, calc(100vw - 120px));
			justify-content: center !important;
			align-items: center !important;
			width: 100%;
			max-width: 100%;
			column-gap: var(--card-icon-gap);
			text-align: left;
		}

		:global(.wetalk-icon-card-grid .card.card--with-icon > .card-icon-heading > .section-icon) {
			grid-column: 1;
			width: var(--card-icon-heading-size) !important;
			height: var(--card-icon-heading-size) !important;
		}

		:global(.wetalk-icon-card-grid .card.card--with-icon > .card-icon-heading > h3) {
			grid-column: 2;
			max-width: none;
			text-align: left;
		}

		.wetalk-comparison-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
