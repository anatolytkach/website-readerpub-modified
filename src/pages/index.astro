---
import ActionLink from "../components/ActionLink.astro";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import ProductName from "../components/ProductName.astro";
import Section from "../components/sections/Section.astro";
import { BOOKS_URL, PUBLISH_URL, SITE_NAME } from "../consts";

const homeVideoDoorSides = ["left", "right"] as const;
---

<Base
	title={`Web-Native Publishing Network | ${SITE_NAME}`}
	description="ReaderPub is a web-native publishing network that keeps books and readers connected—without apps, downloads, or platform lock-in."
	ogImage="/images/home.webp"
	>

	<section id="home-main-hero" class="section section--green home-hero">
		<div class="home-hero-content">
			<div class="home-hero-title" role="heading" aria-level="1">
				<div class="home-hero-title-line home-hero-title-line--accent">Transforming</div>
				<div class="home-hero-title-line">the world of books</div>
			</div>
			<p class="home-hero-statement" data-home-hero-content-reveal>
				ReaderPub is a web-native publishing network that makes books readable online and keeps readers connected.
			</p>
			<div class="cta-row home-hero-actions" data-home-hero-content-reveal>
				<ActionLink label="Publish your book" href={PUBLISH_URL} external class="home-hero-publish-button" />
				<ActionLink label="60K+ PD books in Catalog" href={BOOKS_URL} external class="home-hero-catalog-button" />
			</div>
			<p class="home-hero-strategy" data-home-hero-content-reveal aria-label="Read instantly. Publish securely. Distribute strategically.">
				<span class="home-hero-strategy-line">READ INSTANTLY</span>
				<span class="home-hero-strategy-dot" aria-hidden="true">•</span>
				<span class="home-hero-strategy-line">PUBLISH SECURELY</span>
				<span class="home-hero-strategy-dot" aria-hidden="true">•</span>
				<span class="home-hero-strategy-line">DISTRIBUTE STRATEGICALLY</span>
			</p>
		</div>
	</section>

	<div class="home-hero-illustration-backdrop">
		<section
			class="home-hero-image-section"
			aria-label="ReaderPub audience illustration"
			data-media-reveal-origin="right"
		>
			<img
				class="home-hero-image"
				src="/images/home.webp?v=1876x968"
				alt="Illustration of ReaderPub connecting a reader with an author, publisher, library, and university"
				loading="eager"
				decoding="async"
				width="1876"
				height="968"
			/>
		</section>

		<section class="hero-background-spacer home-hero-bookshelf" aria-hidden="true"></section>
	</div>

	<script is:inline>
		(() => {
			const syncHomeHeroBookshelf = () => {
				const image = document.querySelector(".home-hero-image");
				const bookshelf = document.querySelector(".home-hero-bookshelf");

				if (!(image instanceof HTMLImageElement) || !(bookshelf instanceof HTMLElement)) {
					return;
				}

				const imageHeight = image.getBoundingClientRect().height;

				if (imageHeight > 0) {
					const bookshelfRatio = window.matchMedia("(orientation: portrait)").matches ? 0.4 : 0.25;
					const bookshelfHeight = `${imageHeight * bookshelfRatio}px`;
					bookshelf.style.setProperty("--hero-background-spacer-height", bookshelfHeight);
					bookshelf.style.setProperty("height", bookshelfHeight, "important");
				}
			};

			window.addEventListener("resize", syncHomeHeroBookshelf, { passive: true });
			window.addEventListener("load", syncHomeHeroBookshelf, { once: true });
			document.addEventListener("astro:page-load", syncHomeHeroBookshelf);
			const image = document.querySelector(".home-hero-image");

			if (image instanceof HTMLImageElement && "ResizeObserver" in window) {
				new ResizeObserver(syncHomeHeroBookshelf).observe(image);
			}

			syncHomeHeroBookshelf();
		})();
	</script>

	<Section
		id="home-challenge"
		tone="gray"
		title="The challenge:"
		body="Ebooks are still delivered as standalone files, detached from authors, publishers, discussions, and communities."
	>
		<CardGrid columns="3" class="home-problem-grid">
			<Card
				class="about-why-card"
				icon="epubFile"
				title="Week file-first publishing"
				body="Traditional digital publishing ends with the delivery of a file that is, moreover, poorly protected."
			/>
			<Card
				class="about-why-card"
				icon="readerBook"
				title="Broken reader relationships"
				body="Authors, publishers, and institutions often lose visibility into what happens after readers gain access."
			/>
			<Card
				class="about-why-card"
				icon="public"
				title="Poor discussion and discovery"
				body="Conversation, discovery, and reader activity frequently move away from the publication itself."
			/>
		</CardGrid>
	</Section>

	<div class="home-video-stage is-green-intro" data-home-video-stage>
		<section class="home-video-intro" data-home-video-intro aria-label="ReaderPub video introduction">
			<video
				class="home-video-intro-media"
				src="/videos/treasure_island-1.mp4"
				poster="/images/treasure-island-video-poster.webp"
				title="Treasure Island in WeRead"
				muted
				playsinline
				preload="metadata"
			></video>
		</section>
		<div class="home-video-green-shutters" aria-hidden="true">
			{homeVideoDoorSides.map((side) => (
				<div class={`home-video-green-panel home-video-green-panel--${side}`}>
					<div class="home-video-intro-content home-video-intro-content--door">
						<p class="home-video-solution-label" data-home-video-reveal="solution">
							<span>The solution</span><span class="home-video-solution-colon">:</span>
						</p>
						<div class="home-video-brand" data-home-video-reveal="brand">
							<span class="home-video-brand-mark">
								<img src="/images/logo_white.svg" alt="" />
							</span>
							<span class="home-video-wordmark"><span>Reader</span><span>Pub</span></span>
						</div>
						<div class="home-video-slogan-block" data-home-video-reveal="slogan">
							<span class="home-video-slogan"><span class="home-video-slogan-lead">Direct web access.</span><br />No downloads or platform lock-in.</span>
						</div>
					</div>
				</div>
			))}
		</div>
		<div class="home-video-green-layer" aria-hidden="true"></div>
		<div class="home-video-intro-content home-video-intro-content--controls">
			<div class="home-video-final-content">
				<p class="home-video-teaser" aria-live="polite">
					<span class="home-video-teaser-line home-video-teaser-accent">Guess what<span class="home-video-teaser-question">?</span></span>
					<span class="home-video-teaser-line home-video-teaser-line--detail"><span class="home-video-teaser-accent">This is not an app,</span><span class="home-video-teaser-detail-rest"> but a web page<span class="home-video-teaser-accent">!</span></span></span>
				</p>
				<button class="home-video-replay" type="button" data-home-video-replay aria-label="Replay the ReaderPub introduction">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
						<path d="M3 3v5h5"></path>
					</svg>
				</button>
			</div>
			<button class="button home-video-start-button" type="button" data-home-video-start>
				Check it out
			</button>
			<div class="home-video-accessible-intro">
				The solution:  ReaderPub. Direct web access. No downloads or platform lock-in.
			</div>
		</div>
		<div class="home-video-wave-space" aria-hidden="true"></div>
	</div>

	<Section
		tone="white"
		class="home-file-model-section section--two-column"
	>
		<div class="home-comparison-grid">
			<article class="comparison-text-panel home-list-card home-old-model-card">
				<div class="card-copy">
					<h3>Old model</h3>
					<ul class="home-model-list" style="--home-model-marker-color: var(--text);">
						<li>File is uploaded</li>
						<li>Reader downloads the file</li>
						<li>Discussion moves elsewhere</li>
						<li>Audience becomes invisible</li>
						<li>Relationship ends</li>
					</ul>
					<p class="home-broken-relationship-problem">
						There are many platforms – <span class="home-broken-relationship-platform">Kindle</span><span class="home-broken-relationship-platform-punctuation">,</span> <span class="home-broken-relationship-platform">Substack</span><span class="home-broken-relationship-platform-punctuation">,</span> <span class="home-broken-relationship-platform">Everand</span> – making a book available. But the actual life of their books ends when a file is delivered.
					</p>
				</div>
			</article>
			<article class="card card--good home-list-card home-readerpub-model-card">
				<div class="card-copy">
					<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> model</h3>
					<ul class="home-model-list">
						<li>Book is published online</li>
						<li>Reader opens it instantly in the web eReader</li>
						<li>Comments stay connected</li>
						<li>Audience remains visible</li>
						<li>Relationship continues</li>
					</ul>
					<p class="home-broken-relationship-solution">
						Only <span class="readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> keeps the book alive and connected after delivery.
					</p>
				</div>
			</article>
		</div>

		<h3 class="home-tech-title-line home-tech-title-line-solution">A browser-based eReader <span class="home-tech-title-plus">+</span> a web-native publishing network.</h3>

		<div class="home-reader-groups-section">
			<CardGrid columns="3" class="home-reader-groups-grid">
				<Card
					href="/weread/"
					icon="reader"
					title="Readers"
					body="Reading is digital yet remains complicated, while discussion and discovery remain fragmented across apps, stores, and social networks. See how ReaderPub fixed this."
					variant="good"
					class="home-readerpub-model-card home-list-card home-reader-groups-card"
				>
					<Fragment slot="body">Reading is digital yet remains complicated, while discussion and discovery remain fragmented across apps, stores, and social networks.<br />See how <ProductName name="ReaderPub" class="home-reader-groups-readerpub" /> fixed this.</Fragment>
				</Card>
				<Card
					href="/wepub/"
					icon="author"
					title="Authors & Publishers"
					body="Authors and publishers release books, yet marketplaces control visibility, access to readers, and the customer relationship. Get back your audience with ReaderPub."
					variant="good"
					class="home-readerpub-model-card home-list-card home-reader-groups-card"
				>
					<Fragment slot="body">Authors and publishers release books, yet marketplaces control visibility, access to readers, and the customer relationship.<br />Get back your audience with <ProductName name="ReaderPub" class="home-reader-groups-readerpub" />.</Fragment>
				</Card>
				<Card
					href="/institutions/"
					icon="library"
					title="Institutions"
					body="Libraries, universities, and public organizations publish knowledge that remains difficult to find, read, and discuss online. With ReaderPub, it’s a total breeze."
					variant="good"
					class="home-readerpub-model-card home-list-card home-reader-groups-card"
				>
					<Fragment slot="body">Libraries, universities, and public organizations publish knowledge that remains difficult to find, read, and discuss online.<br />With <ProductName name="ReaderPub" class="home-reader-groups-readerpub" />, it’s a total breeze.</Fragment>
				</Card>
			</CardGrid>
		</div>

	</Section>

	<script is:inline>
		(() => {
			const setupHomeVideoIntro = () => {
				const stage = document.querySelector("[data-home-video-stage]");

				if (!(stage instanceof HTMLElement) || stage.dataset.videoReady === "true") {
					return;
				}

				const intro = stage.querySelector("[data-home-video-intro]");
				const video = intro instanceof HTMLElement ? intro.querySelector("video") : null;
				const replayButton = stage.querySelector("[data-home-video-replay]");
				const startButton = stage.querySelector("[data-home-video-start]");
				const nav = document.querySelector(".nav");

				if (
					!(intro instanceof HTMLElement) ||
					!(video instanceof HTMLVideoElement) ||
					!(replayButton instanceof HTMLButtonElement) ||
					!(startButton instanceof HTMLButtonElement)
				) {
					return;
				}

				stage.dataset.videoReady = "true";

				const syncStartButtonPosition = () => {
					const doorContents = Array.from(stage.querySelectorAll(".home-video-intro-content--door"));
					const leftDoorContent = stage.querySelector(".home-video-green-panel--left .home-video-intro-content--door");
					const solutionLabel = leftDoorContent?.querySelector(".home-video-solution-label");
					const slogan = leftDoorContent?.querySelector(".home-video-slogan");

					if (!(solutionLabel instanceof HTMLElement) || !(slogan instanceof HTMLElement)) return;

					/* Measure the untransformed layout. The door panels contain two visual
					 * copies, so the single interactive button stays in the controls layer
					 * and joins their text as one vertically centred group. */
					doorContents.forEach((content) => content.style.setProperty("--home-video-start-stack-shift", "0px"));
					void stage.offsetHeight;

					const stageRect = stage.getBoundingClientRect();
					const contentRect = leftDoorContent.getBoundingClientRect();
					/* offsetTop/offsetHeight ignore the entrance animation transforms, so
					 * the measured centre stays exact while the text fades into place. */
					const offsetFromContent = (element) => {
						let offset = 0;
						let current = element;
						while (current instanceof HTMLElement && current !== leftDoorContent) {
							offset += current.offsetTop;
							current = current.offsetParent;
						}
						return offset;
					};
					const textTop = contentRect.top + offsetFromContent(solutionLabel);
					const textBottom = contentRect.top + offsetFromContent(slogan) + slogan.offsetHeight;
					const controlHeight = startButton.offsetHeight;
					const standardGap = controlHeight * 0.6;
					const textHeight = textBottom - textTop;
					const combinedHeight = textHeight + standardGap + startButton.offsetHeight;
					const groupTop = contentRect.top + (contentRect.height - combinedHeight) / 2;
					const stackShift = groupTop - textTop;

					doorContents.forEach((content) =>
						content.style.setProperty("--home-video-start-stack-shift", `${stackShift}px`),
					);
					startButton.style.top = `${groupTop + textHeight + standardGap - stageRect.top}px`;
				};

				const syncIntroGeometry = () => {
					const navHeight = nav instanceof HTMLElement ? nav.getBoundingClientRect().height : 0;
					const videoWidth = video.videoWidth || 1272;
					const videoHeight = video.videoHeight || 798;
					const introWidth = intro.getBoundingClientRect().width;

					document.documentElement.style.setProperty("--home-video-nav-height", `${Math.round(navHeight)}px`);

					if (introWidth > 0 && videoWidth > 0 && videoHeight > 0) {
						const introHeight = introWidth * (videoHeight / videoWidth);
						stage.style.setProperty("--home-video-intro-height", `${introHeight}px`);
						intro.style.height = `${introHeight}px`;
					}

					syncStartButtonPosition();
				};

				const introTimers = new Set();
				let playbackAttempt = 0;

				const clearIntroTimers = () => {
					introTimers.forEach((timer) => window.clearTimeout(timer));
					introTimers.clear();
				};

				const scheduleIntroStep = (callback, delay) => {
					const timer = window.setTimeout(() => {
						introTimers.delete(timer);
						callback();
					}, delay);
					introTimers.add(timer);
					return timer;
				};

				const showFinalMessage = (attempt) => {
					if (attempt !== playbackAttempt || stage.classList.contains("is-darkening")) return;
					stage.classList.remove("is-playing", "is-video-wait");
					stage.classList.add("is-darkening");
					scheduleIntroStep(() => {
						if (attempt === playbackAttempt) stage.classList.add("is-final");
					}, 850);
				};

				const startVideo = (attempt) => {
					if (attempt !== playbackAttempt) return;
					stage.classList.remove("is-video-wait");
					stage.classList.add("is-playing");
					const playPromise = video.play();
					const fallbackDuration = Number.isFinite(video.duration) && video.duration > 0
						? Math.ceil(video.duration * 1000) + 1500
						: 15000;

					scheduleIntroStep(() => showFinalMessage(attempt), fallbackDuration);
					playPromise?.catch(() => {
						if (attempt !== playbackAttempt) return;
						scheduleIntroStep(() => showFinalMessage(attempt), 1200);
					});
				};

				const openGreenIntro = (attempt) => {
					if (attempt !== playbackAttempt) return;
					video.pause();
					video.currentTime = 0;
					stage.classList.remove("is-green-intro");
					stage.classList.add("is-opened");
					scheduleIntroStep(() => {
						if (attempt !== playbackAttempt) return;
						stage.classList.add("is-video-wait");
						scheduleIntroStep(() => startVideo(attempt), 2000);
					}, 340);
				};

				const resetExperience = (resetImmediately = false) => {
					const attempt = ++playbackAttempt;
					clearIntroTimers();
					if (resetImmediately) stage.classList.add("is-resetting");
					stage.classList.remove(
						"is-sequence-started",
						"is-opened",
						"is-video-wait",
						"is-playing",
						"is-darkening",
						"is-final",
					);
					stage.classList.add("is-green-intro");
					video.loop = false;
					video.pause();
					video.currentTime = 0;
					if (resetImmediately) {
						void stage.offsetWidth;
						stage.classList.remove("is-resetting");
					}

					return attempt;
				};

				const showGreenIntro = (resetImmediately = false) => {
					const attempt = resetExperience(resetImmediately);
					startButton.disabled = false;

					window.requestAnimationFrame(() => {
						if (attempt !== playbackAttempt) return;
						stage.classList.add("is-sequence-started");
					});
				};

				const beginPlayback = (resetImmediately = false) => {
					const attempt = resetExperience(resetImmediately);
					startButton.disabled = true;
					stage.classList.add("is-sequence-started");
					openGreenIntro(attempt);
				};

				video.addEventListener("ended", () => {
					video.pause();
					showFinalMessage(playbackAttempt);
				});
				video.addEventListener("loadedmetadata", () => {
					video.pause();
					video.currentTime = 0;
					syncIntroGeometry();
				});
				replayButton.addEventListener("click", () => {
					beginPlayback(true);
				});
				startButton.addEventListener("click", () => {
					beginPlayback();
				});
				window.addEventListener("resize", syncIntroGeometry, { passive: true });

				if ("IntersectionObserver" in window) {
					let hasEnteredStage = false;
					let stageWasLeft = false;
					const stageObserver = new IntersectionObserver(
						([entry]) => {
							if (entry.isIntersecting) {
								if (hasEnteredStage && stageWasLeft && !stage.classList.contains("is-green-intro")) {
									showGreenIntro(true);
								}
								hasEnteredStage = true;
								stageWasLeft = false;
								return;
							}

							if (hasEnteredStage) stageWasLeft = true;
						},
						{ threshold: 0 },
					);

					stageObserver.observe(stage);
				}

				syncIntroGeometry();
				showGreenIntro();
			};

			setupHomeVideoIntro();
			document.addEventListener("astro:page-load", setupHomeVideoIntro);
		})();
	</script>
	<section class="section section--green home-tech-visual-section" aria-label="Explore ReaderPub platform">
		<h2 class="home-tech-container-title">
			<span class="home-tech-container-title-primary">ReaderPub is end-to-end<span class="home-tech-container-title-primary-colon">:</span></span>
			<span class="home-tech-container-title-secondary">from creation and publishing to reading and engagement</span>
		</h2>
		<a class="home-tech-picture-link" href="/platform/" aria-label="Explore the ReaderPub platform">
			<picture class="home-tech-picture">
				<source media="(orientation: portrait)" srcset="/images/tech_mobile.webp" width="823" height="1743" />
				<img
					src="/images/tech.webp"
					alt="ReaderPub dashboard connecting publishing, browser reading, discussion, and reader activity"
					loading="lazy"
					decoding="async"
					width="1663"
					height="946"
				/>
			</picture>
		</a>
		<h2 class="home-tech-reader-activity-note">This is what your readers' activity on <span>ReaderPub</span> will look like.</h2>
		<a class="button home-tech-visual-button home-tech-platform-button" href="/platform/">Explore ReaderPub</a>
	</section>

	<Section tone="white" class="home-web-asset-section section--two-column" title="What changes when a book becomes a living web asset?">
		<div class="home-comparison-grid">
				<article class="comparison-text-panel home-comparison-card home-old-publishing-card" style="background: var(--card-bg);">
				<div class="card-copy">
					<h3>Traditional publishing</h3>
					<p class="home-flow home-flow--dark">Publish → Download → Relationship ends</p>
					<p>The traditional model delivers a file and loses the reader relationship once access begins.</p>
				</div>
			</article>
			<article class="card card--good home-comparison-card home-readerpub-publishing-card">
				<div class="card-copy">
					<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> publishing</h3>
					<p class="home-flow">
						Publish <span class="home-flow-arrow">→</span> Discover <span class="home-flow-arrow">→</span> Read <span class="home-flow-arrow">→</span>
						Share &amp; Discuss <span class="home-flow-arrow">→</span> Follow &amp; Engage
					</p>
					<p>ReaderPub keeps the publication alive on the web, connected to readers, discussion, and long-term discovery.</p>
				</div>
			</article>
		</div>
	</Section>

	<Section
		id="solution"
		tone="green"
		title="How ReaderPub creates live web publications"
		body="ReaderPub combines browser-based reading, secure web-native publishing, public and private discussion, and structured knowledge tools so books and publications remain alive after launch."
	>
		<CardGrid columns="2" class="home-product-grid">
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/weread/"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Read</span></a></h3>
					<p>Books open instantly in the browser instead of being trapped inside apps or files.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/wepub/"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Pub</span></a></h3>
					<p>Authors and publishers release secure web-native publications while keeping their audience relationships.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3 class="home-product-title-line">
						<a class="home-product-link" href="/webuzz/"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Buzz</span></a>
						<span class="home-product-divider">/</span>
						<a class="home-product-link" href="/wetalk/"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Talk</span></a>
					</h3>
					<p>Social, public, and private discussions stay connected to books, authors, researchers, and ideas.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/booktree/"><span class="home-product-name-base">Book</span><span class="home-product-name-accent">Tree</span></a></h3>
					<p>Serious readers connect books, notes, and projects into durable knowledge structures.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/scribe/">Scribe</a></h3>
					<p>A specialized AI companion for literature, writing, publishing, and ReaderPub.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		title="ReaderPub is not just another ebook platform"
