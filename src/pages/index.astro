			var(--green-edge-air-bottom-wave-scroll),
			linear-gradient(to bottom, transparent 0 var(--home-hero-wave-height), #000 var(--home-hero-wave-height) 100%);
		--home-hero-wave-mask-position: var(--green-edge-wave-scroll-x) top, 0 0;
		--home-hero-wave-mask-repeat: repeat-x, no-repeat;
