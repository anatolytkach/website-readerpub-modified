---
import ActionLink from "../components/ActionLink.astro";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import { BOOKS_URL, PUBLISH_URL, SITE_NAME } from "../consts";
---

<Base
	title={`Web-Native Publishing & Digital Reading Platform | ${SITE_NAME}`}
	description="ReaderPub is a web-native publishing and digital reading platform that keeps books and readers connected—without apps, downloads, or platform lock-in."
>
	<div class="home-video-stage" data-home-video-stage>
		<section class="home-video-intro" data-home-video-intro aria-label="ReaderPub video introduction">
			<video
				class="home-video-intro-media"
				src="/videos/treasure_island-1.mp4"
				title="Treasure Island in WeRead"
				muted
				autoplay
				playsinline
				preload="auto"
			></video>
		</section>
		<div class="home-video-green-layer" aria-hidden="true"></div>
		<div class="home-video-intro-content">
			<p class="home-video-teaser" aria-live="polite">
				<span class="home-video-teaser-line home-video-teaser-accent">Guess what?</span>
				<span class="home-video-teaser-line">This is not an app, but a web page<span class="home-video-teaser-accent">!</span></span>
			</p>
			<div class="home-video-brand" data-home-video-reveal="brand">
				<span class="home-video-brand-mark" aria-hidden="true">
					<img src="/images/logo_white.svg" alt="" />
				</span>
				<span class="home-video-wordmark" aria-label="ReaderPub"><span>Reader</span><span>Pub</span></span>
			</div>
			<div class="home-video-slogan-block" data-home-video-reveal="slogan">
				<span class="home-video-slogan">Transforming the world of books</span>
			</div>
			<p class="home-video-strategy" data-home-video-reveal="strategy">
				<span class="home-video-strategy-line">READ INSTANTLY</span>
				<span class="home-video-period">•</span>
				<span class="home-video-strategy-line">PUBLISH SECURELY</span>
				<span class="home-video-period">•</span>
				<span class="home-video-strategy-line">DISTRIBUTE STRATEGICALLY</span>
			</p>
			<button class="home-video-scroll" type="button" data-home-video-scroll aria-label="Scroll to the ReaderPub introduction"></button>
			<button class="home-video-replay" type="button" data-home-video-replay aria-label="Replay the ReaderPub introduction">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
					<path d="M3 3v5h5"></path>
				</svg>
			</button>
		</div>
		<div class="home-video-wave-space" aria-hidden="true"></div>
	</div>

	<HeroSection
		id="home-main-hero"
		class="home-hero"
		title="Transforming the world of books."
		lead="Ebooks are still delivered as standalone files, detached from authors, publishers, discussions, and communities."
		image="/images/home.webp"
		imageAlt="Illustration of ReaderPub connecting a reader with an author, publisher, library, and university"
		actions={[
			{ label: "Explore the solution", href: "/platform" },
			{ label: "Read 60K+ books in WeRead", href: BOOKS_URL, external: true, variant: "secondary" },
		]}
		spacerBackgroundPositionY="0%"
	>
		<p class="home-hero-statement hero-body">
			ReaderPub is a web-native publishing platform that makes books readable online and keeps readers connected.
		</p>
		<p class="home-hero-strategy">
			Read instantly. Publish securely. Distribute strategically.
		</p>
		<p class="home-hero-lockin hero-lead">
			Direct web access, No downloads or platform lock-in
		</p>
	</HeroSection>

	<Section
		tone="gray"
		title="The challenge:"
		body="Digital publishing made distribution easier, but it still leaves books disconnected from readers, discussion, and long-term discovery."
	>
		<CardGrid columns="3" class="home-problem-grid">
			<Card
				href="/weread"
				icon="readerBook"
				title="Readers"
				body="Reading is digital, yet discussion and discovery remain fragmented across apps, stores, and social networks."
			/>
			<Card
				href="/wepub"
				icon="author"
				title="Authors & Publishers"
				body="Authors and publishers release books, yet marketplaces often control visibility, access to readers, and the customer relationship."
			/>
			<Card
				href="/institutions"
				icon="library"
				title="Institutions"
				body="Libraries, universities, and public organizations publish knowledge that remains difficult to find, read, and discuss online."
			/>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		class="home-tech-heading-section home-file-model-section section--two-column"
	>
		<h2 id="home-tech-title" class="home-tech-title">
			<span class="home-tech-title-line home-tech-title-line-primary"><span class="home-tech-title-prefix">The solution:</span><span class="home-tech-title-readerpub" style="color: var(--accent);"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span></span>
		</h2>
		<h3 class="home-tech-title-line home-tech-title-line-solution">A browser-based eReader <span class="home-tech-title-plus">+</span> a web-native publishing network.</h3>

		<div class="home-comparison-grid">
			<article class="comparison-text-panel home-list-card home-old-model-card">
				<div class="card-copy">
					<h3>Old model</h3>
					<ul class="home-model-list" style="--home-model-marker-color: var(--text);">
						<li>File is uploaded</li>
						<li>Reader downloads the file</li>
						<li>Discussion moves elsewhere</li>
						<li>Audience becomes invisible</li>
						<li>Relationship ends</li>
					</ul>
				</div>
			</article>
			<article class="card card--good home-list-card home-readerpub-model-card">
				<div class="card-copy">
					<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> model</h3>
					<ul class="home-model-list">
						<li>Book is published online</li>
						<li>Reader opens it instantly in the web eReader</li>
						<li>Comments stay connected</li>
						<li>Audience remains visible</li>
						<li>Relationship continues</li>
					</ul>
				</div>
			</article>
		</div>

		<p class="home-file-model-summary">
			<span class="home-file-model-summary-problem">The old file-first publishing model ends when a file is delivered, and breaks the relationships.</span>
			<span>ReaderPub keeps publications alive and connected after delivery.</span>
		</p>
	</Section>

	<script is:inline>
		(() => {
			const setupHomeVideoIntro = () => {
				const stage = document.querySelector("[data-home-video-stage]");

				if (!(stage instanceof HTMLElement) || stage.dataset.videoReady === "true") {
					return;
				}

				const intro = stage.querySelector("[data-home-video-intro]");
				const video = intro instanceof HTMLElement ? intro.querySelector("video") : null;
				const scrollButton = stage.querySelector("[data-home-video-scroll]");
				const replayButton = stage.querySelector("[data-home-video-replay]");
				const hero = document.querySelector("#home-main-hero");
				const nav = document.querySelector(".nav");

				if (
					!(intro instanceof HTMLElement) ||
					!(video instanceof HTMLVideoElement) ||
					!(scrollButton instanceof HTMLButtonElement) ||
					!(replayButton instanceof HTMLButtonElement)
				) {
					return;
				}

				stage.dataset.videoReady = "true";

				const syncIntroGeometry = () => {
					const navHeight = nav instanceof HTMLElement ? nav.getBoundingClientRect().height : 0;
					const videoWidth = video.videoWidth || 1272;
					const videoHeight = video.videoHeight || 798;
					const stageWidth = stage.getBoundingClientRect().width;

					document.documentElement.style.setProperty("--home-video-nav-height", `${Math.round(navHeight)}px`);

					if (stageWidth > 0 && videoWidth > 0 && videoHeight > 0) {
						const introHeight = stageWidth * (videoHeight / videoWidth);
						stage.style.setProperty("--home-video-intro-height", `${introHeight}px`);
						intro.style.height = `${introHeight}px`;
					}
				};

				let completionTimer;
				let revealTimer;
				let teaserTimer;
				let playbackAttempt = 0;
				let hasLeftPageTop = window.scrollY > 1;
				let scrollFrame = 0;

				const clearIntroTimers = () => {
					window.clearTimeout(completionTimer);
					window.clearTimeout(revealTimer);
					window.clearTimeout(teaserTimer);
				};

				const completeIntro = () => {
					if (stage.classList.contains("is-darkening")) return;
					window.clearTimeout(completionTimer);
					stage.classList.add("is-darkening");
					revealTimer = window.setTimeout(() => {
						stage.classList.add("is-teasing");
						teaserTimer = window.setTimeout(() => {
							stage.classList.remove("is-teasing");
							stage.classList.add("is-complete");
						}, 5000);
					}, 550);
				};

				const playVideoOnce = (resetImmediately = false) => {
					const attempt = ++playbackAttempt;
					clearIntroTimers();
					if (resetImmediately) stage.classList.add("is-resetting");
					stage.classList.remove("is-darkening", "is-teasing", "is-complete");
					video.loop = false;
					video.currentTime = 0;
					if (resetImmediately) {
						void stage.offsetWidth;
						stage.classList.remove("is-resetting");
					}
					const playPromise = video.play();

					completionTimer = window.setTimeout(() => {
						if (attempt === playbackAttempt) completeIntro();
					}, 13000);

					playPromise?.catch(() => {
						if (attempt !== playbackAttempt) return;
						window.clearTimeout(completionTimer);
						completionTimer = window.setTimeout(completeIntro, 900);
					});
				};

				video.addEventListener("ended", () => {
					video.pause();
					completeIntro();
				});
				video.addEventListener("loadedmetadata", syncIntroGeometry);
				scrollButton.addEventListener("click", () => {
					if (!(hero instanceof HTMLElement)) return;
					const navHeight = nav instanceof HTMLElement ? nav.getBoundingClientRect().height : 0;
					const heroTop = hero.getBoundingClientRect().top + window.scrollY;
					window.scrollTo({
						top: Math.max(0, heroTop - navHeight),
						behavior: "smooth",
					});
				});
				replayButton.addEventListener("click", () => {
					video.pause();
					playVideoOnce(true);
				});
				window.addEventListener(
					"scroll",
					() => {
						if (scrollFrame) return;

						scrollFrame = window.requestAnimationFrame(() => {
							scrollFrame = 0;
							const isAtPageTop = window.scrollY <= 1;

							if (!isAtPageTop) {
								hasLeftPageTop = true;
								return;
							}

							if (hasLeftPageTop) {
								hasLeftPageTop = false;
								video.pause();
								playVideoOnce(true);
							}
						});
					},
					{ passive: true },
				);
				window.addEventListener("resize", syncIntroGeometry, { passive: true });

				syncIntroGeometry();
				requestAnimationFrame(playVideoOnce);
			};

			setupHomeVideoIntro();
			document.addEventListener("astro:page-load", setupHomeVideoIntro);
		})();
	</script>
	<section class="section section--green home-tech-visual-section" aria-label="Explore ReaderPub platform">
		<h2 class="home-tech-container-title">
			<span class="home-tech-container-title-primary">ReaderPub is end-to-end:</span>
			<span class="home-tech-container-title-secondary">from creation and publishing to reading and engagement</span>
		</h2>
		<a class="home-tech-picture-link" href="/platform" aria-label="Explore the ReaderPub platform">
			<picture class="home-tech-picture">
				<source media="(orientation: portrait)" srcset="/images/tech_mobile.webp" width="823" height="1743" />
				<img
					src="/images/tech.webp"
					alt="ReaderPub dashboard connecting publishing, browser reading, discussion, and reader activity"
					loading="lazy"
					decoding="async"
					width="1663"
					height="946"
				/>
			</picture>
		</a>
		<h2 class="home-tech-reader-activity-note">This is what reader activity looks like on <span>ReaderPub</span>.</h2>
		<a class="button home-tech-visual-button home-tech-platform-button" href="/platform">Explore ReaderPub</a>
	</section>

	<Section tone="white" class="home-web-asset-section section--two-column" title="What changes when a book becomes a living web asset?">
		<div class="home-comparison-grid">
				<article class="comparison-text-panel home-comparison-card home-old-publishing-card" style="background: var(--card-bg);">
				<div class="card-copy">
					<h3>Traditional publishing</h3>
					<p class="home-flow home-flow--dark">Publish → Download → Relationship ends</p>
					<p>The traditional model delivers a file and loses the reader relationship once access begins.</p>
				</div>
			</article>
			<article class="card card--good home-comparison-card home-readerpub-publishing-card">
				<div class="card-copy">
					<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> publishing</h3>
					<p class="home-flow">
						Publish <span class="home-flow-arrow">→</span> Discover <span class="home-flow-arrow">→</span> Read <span class="home-flow-arrow">→</span>
						Share &amp; Discuss <span class="home-flow-arrow">→</span> Follow &amp; Engage
					</p>
					<p>ReaderPub keeps the publication alive on the web, connected to readers, discussion, and long-term discovery.</p>
				</div>
			</article>
		</div>
	</Section>

	<Section
		id="solution"
		tone="green"
		title="How ReaderPub creates live web publications"
		body="ReaderPub combines browser-based reading, secure web-native publishing, public and private discussion, and structured knowledge tools so books and publications remain alive after launch."
	>
		<CardGrid columns="2" class="home-product-grid">
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/weread"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Read</span></a></h3>
					<p>Books open instantly in the browser instead of being trapped inside apps or files.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/wepub"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Pub</span></a></h3>
					<p>Authors and publishers release secure web-native publications while keeping their audience relationships.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3 class="home-product-title-line">
						<a class="home-product-link" href="/webuzz"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Buzz</span></a>
						<span class="home-product-divider">/</span>
						<a class="home-product-link" href="/wetalk"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Talk</span></a>
					</h3>
					<p>Social, public, and private discussions stay connected to books, authors, researchers, and ideas.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/booktree"><span class="home-product-name-base">Book</span><span class="home-product-name-accent">Tree</span></a></h3>
					<p>Serious readers connect books, notes, and projects into durable knowledge structures.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/scribe">Scribe</a></h3>
					<p>A specialized AI companion for literature, writing, publishing, and ReaderPub.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		title="ReaderPub is not just another ebook platform"
	>
		<Fragment slot="body">
			ReaderPub is a web-native publishing network where books and knowledge publications become <span class="home-cta-body-accent">living web assets</span>.
		</Fragment>
		<CardGrid columns="4">
			<Card title="Readable" body="Readers open publications instantly in the browser." />
			<Card title="Discoverable" body="Books and publications have a web presence, metadata, and shareable URLs." />
			<Card title="Discussable" body="Conversation stays attached to books, authors, fragments, and ideas." />
			<Card title="Connected" body="Authors, publishers, and institutions can see and engage with their reading audiences." />
		</CardGrid>
	</Section>

	<Section tone="green">
		<Fragment slot="title">Who benefits from <span class="green-heading-white">web-native reading</span>?</Fragment>
		<CardGrid columns="4">
			<Card icon="readerBook" title="Readers" body="They get instant access, richer context, connected discussion, and better discovery." />
			<Card icon="author" title="Authors" body="They keep more revenue, gain greater audience visibility, and build a longer-term reader connection." />
			<Card icon="publisher" title="Publishers" body="They launch books as active web assets, not isolated product files." />
			<Card icon="library" title="Institutions" body="They turn collections and research into visible public knowledge infrastructure." />
		</CardGrid>
	</Section>

	<CtaBlock
		title="Books should live on the web."
		actions={[
			{ label: "Publish with WePub", href: PUBLISH_URL, external: true },
			{ label: "60K+ books in Catalog", href: BOOKS_URL, external: true, variant: "secondary" },
		]}
	>
		<Fragment slot="body">
			ReaderPub helps books and knowledge publications remain <span class="home-cta-body-accent">living web assets</span>—readable, searchable, shareable, discussable, and connected.
		</Fragment>
	</CtaBlock>
</Base>

<style>
	.home-cta-body-accent {
		color: var(--accent-orange) !important;
	}

	.home-video-stage {
		--home-video-green-background: repeating-radial-gradient(
			circle at 25% 75%,
			var(--section-green-wide-stripe) 0,
			var(--section-green-wide-stripe) 46.4px,
			var(--section-green-narrow-stripe) 46.4px,
			var(--section-green-narrow-stripe) 51.733px
		);
		--home-video-wave-height: clamp(72px, 8.2vw, 150px);
		--green-edge-bottom-wave-x: 0px;
		--green-edge-bottom-wave-width: 2200px;
		position: relative;
		width: 100%;
		overflow: hidden;
		background: transparent;
		isolation: isolate;
	}

	:global(.content > .home-video-stage + .hero-section.home-hero) {
		margin-top: var(--section-stack-gap) !important;
	}

	.home-video-intro {
		position: relative;
		z-index: 0;
		width: 100%;
		height: var(--home-video-intro-height, auto);
		min-height: 0;
		aspect-ratio: 1272 / 798;
		overflow: hidden;
		background: transparent;
	}

	.home-video-intro-media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		border: 0;
		object-fit: contain;
		background: #000000;
	}

	.home-video-green-layer {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--home-video-green-background);
		opacity: 0;
		transition: opacity 1700ms ease-in-out;
		pointer-events: none;
	}

	.home-video-green-layer::after {
		content: "";
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: var(--home-video-wave-height);
		background-image: var(--green-edge-air-bottom-wave-scroll);
		background-position: calc(var(--green-edge-bottom-wave-x) + var(--green-edge-wave-scroll-x)) bottom;
		background-repeat: repeat-x;
		background-size: var(--green-edge-bottom-wave-width) 100%;
		pointer-events: none;
		will-change: background-position;
	}

	.home-video-wave-space {
		position: relative;
		z-index: 0;
		width: 100%;
		height: 0;
		transition: height 1700ms ease-in-out;
	}

	.home-video-intro-content {
		position: absolute;
		inset: 0 0 auto;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0;
		box-sizing: border-box;
		width: 100%;
		height: var(--home-video-intro-height, 100%);
		max-width: var(--page-max);
		margin: 0 auto;
		padding: clamp(24px, 4vh, 48px) 24px;
		pointer-events: none;
	}

	.home-video-teaser {
		position: absolute;
		top: 50%;
		right: 24px;
		left: 24px;
		display: block;
		width: auto;
		max-width: none;
		margin: 0;
		padding: 0;
		color: #ffffff;
		font-family: var(--font-heading);
		font-size: clamp(1.7rem, 3.2vw, 2.8rem);
		font-style: normal;
		font-weight: var(--font-weight-heading);
		line-height: 1.2;
		text-align: center;
		opacity: 0;
		transform: translate3d(0, calc(-50% + 16px), 0) scale(0.96);
		transition:
			opacity 1100ms var(--motion-ease) 100ms,
			transform 1100ms var(--motion-ease) 100ms;
	}

	.home-video-teaser-accent {
		color: var(--section-green-orange);
	}

	.home-video-teaser-line {
		display: block;
	}

	.home-video-brand,
	.home-video-slogan-block,
	.home-video-strategy,
	.home-video-scroll,
	.home-video-replay {
		opacity: 0;
		transform: translate3d(0, 24px, 0);
		transition:
			opacity 900ms var(--motion-ease),
			transform 900ms var(--motion-ease);
	}

	.home-video-brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(12px, 1.4vh, 18px);
		width: 100%;
		transform: translate3d(0, 16px, 0) scale(0.96);
		transition:
			opacity 1100ms var(--motion-ease) 100ms,
			transform 1100ms var(--motion-ease) 100ms;
	}

	.home-video-brand-mark {
		position: relative;
		display: block;
		width: clamp(86px, 9.2vw, 140px);
		aspect-ratio: 3900 / 3500;
	}

	.home-video-brand-mark img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.home-video-wordmark {
		display: block;
		width: 25%;
		min-width: 220px;
		color: #ffffff;
		font-family: var(--font-ui);
		font-size: clamp(2rem, 3.4vw, 3.25rem);
		font-weight: 500;
		letter-spacing: var(--letter-spacing-heading);
		line-height: 1;
		text-align: center;
	}

	.home-video-wordmark > span:last-child {
		color: var(--accent-orange);
	}

	.home-video-slogan-block {
		display: flex !important;
		flex-direction: column;
		flex: 0 0 auto;
		align-items: center !important;
		justify-content: center !important;
		align-self: stretch !important;
		box-sizing: border-box;
		width: 100% !important;
		min-width: 100% !important;
		max-width: none !important;
		margin-top: clamp(36px, 4.4vh, 54px);
		margin-right: 0 !important;
		margin-left: 0 !important;
		padding: 0 !important;
		text-align: center;
		transition-delay: 1050ms;
	}

