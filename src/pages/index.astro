		-webkit-mask-composite: source-over;
		mask-image: var(--home-hero-wave-mask-images);
		mask-position: var(--home-hero-wave-mask-position);
		mask-repeat: var(--home-hero-wave-mask-repeat);
		mask-size: var(--home-hero-wave-mask-size);
		mask-composite: add;
		pointer-events: none;
