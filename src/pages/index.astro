		transform: rotateY(88deg);
		visibility: hidden;
	}

	.home-video-stage.is-opened .home-video-green-shutters {
		background: transparent;
	}

	/* Once the leaves begin to open, there must be no independent green
	 * backdrop behind them.  The two panels therefore reveal the video across
	 * the complete stage, rather than leaving a stationary green rim. */
	.home-video-stage.is-opened:not(.is-darkening, .is-final) .home-video-green-layer {
		opacity: 0;
		transition: none;
	}

	.home-video-stage.is-opened .home-video-green-panel--right {
		box-shadow: none;
		opacity: 0;
		transform: rotateY(-88deg);
		visibility: hidden;
