	/* Keep the green intro, the video, and the final green panel on the same
	 * physical stage. The automatic flex margins split the free height equally
	 * above and below the video in every state. */
	.home-video-stage:is(.is-opened, .is-darkening, .is-final) {
		display: flex;
		flex-direction: column;
		min-height: var(--home-video-open-stage-height);
