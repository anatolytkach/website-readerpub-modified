---
import ActionLink from "../components/ActionLink.astro";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import { BOOKS_URL, PUBLISH_URL, SITE_NAME } from "../consts";
---

<Base
	title={`Web-Native Publishing & Digital Reading Platform | ${SITE_NAME}`}
	description="ReaderPub is a web-native publishing and digital reading platform that keeps books and readers connected—without apps, downloads, or platform lock-in."
>
	<HeroSection
		class="home-hero"
		title="Transforming the world of books."
		lead="Ebooks are still delivered as standalone files, detached from authors, publishers, discussions, and communities."
		image="/images/home.webp"
		imageAlt="Illustration of ReaderPub connecting a reader with an author, publisher, library, and university"
		actions={[
			{ label: "Explore the solution", href: "/platform" },
			{ label: "Read 60K+ books in WeRead", href: BOOKS_URL, external: true, variant: "secondary" },
		]}
		spacerBackgroundPositionY="0%"
	>
		<p class="home-hero-statement hero-body">
			ReaderPub is a web-native publishing platform that makes books readable online and keeps readers connected.
		</p>
		<p class="home-hero-strategy">
			Read instantly. Publish securely. Distribute strategically.
		</p>
		<p class="home-hero-lockin hero-lead">
			Direct web access, No downloads or platform lock-in
		</p>
	</HeroSection>

	<Section
		tone="gray"
		title="The challenge:"
		body="Digital publishing made distribution easier, but it still leaves books disconnected from readers, discussion, and long-term discovery."
	>
		<CardGrid columns="3" class="home-problem-grid">
			<Card
				href="/weread"
				icon="readerBook"
				title="Readers"
				body="Reading is digital, yet discussion and discovery remain fragmented across apps, stores, and social networks."
			/>
			<Card
				href="/wepub"
				icon="author"
				title="Authors & Publishers"
				body="Authors and publishers release books, yet marketplaces often control visibility, access to readers, and the customer relationship."
			/>
			<Card
				href="/institutions"
				icon="library"
				title="Institutions"
				body="Libraries, universities, and public organizations publish knowledge that remains difficult to find, read, and discuss online."
			/>
		</CardGrid>
	</Section>

	<section class="section section--white home-tech-heading-section" aria-labelledby="home-tech-title">
		<h2 id="home-tech-title" class="home-tech-title">
			<span class="home-tech-title-line home-tech-title-line-primary"><span class="home-tech-title-prefix">The solution:</span><span class="home-tech-title-readerpub" style="color: var(--accent);"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span></span>
		</h2>
		<h3 class="home-tech-title-line home-tech-title-line-solution">A browser-based eReader <span class="home-tech-title-plus">+</span> a web-native publishing network.</h3>
		<div class="home-reader-frame" data-video-player>
			<a class="home-reader-video-link" href="https://reader.pub/books/reader/?id=90000120" target="_blank" rel="noopener noreferrer" aria-label="Open Treasure Island in WeRead">
				<video
					src="/videos/treasure_island-1.mp4"
					title="Treasure Island in WeRead"
					muted
					autoplay
					playsinline
					preload="auto"
				></video>
			</a>
			<button class="home-reader-play-button" type="button" aria-label="Play Treasure Island demo">
				<span aria-hidden="true"></span>
			</button>
		</div>
		<div class="home-tech-reader-cta">
			<h2 class="home-tech-visual-title heading--center-full heading--center-full-h2"><em class="home-tech-guess">Guess what<span class="home-tech-guess-question">?</span></em>It’s not an app. It’s a <span class="home-product-word"><span>We</span><span>Read</span></span> webpage.</h2>
			<h3 class="home-tech-reader-subtitle">Read this thrilling story, and many more.</h3>
			<div class="home-tech-reader-actions">
				<a class="button button--secondary" href={BOOKS_URL} target="_blank" rel="noopener noreferrer">60K+ books in WeRead</a>
				<a class="button home-tech-visual-button home-tech-reader-button" href="/weread">Explore WeRead</a>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			const setupHomeReaderVideo = () => {
				const frame = document.querySelector("[data-video-player]");

				if (!(frame instanceof HTMLElement) || frame.dataset.videoReady === "true") {
					return;
				}

				const video = frame.querySelector("video");
				const playButton = frame.querySelector("button");

				if (!(video instanceof HTMLVideoElement) || !(playButton instanceof HTMLButtonElement)) {
					return;
				}

				frame.dataset.videoReady = "true";

				const showPlayButton = () => {
					frame.classList.add("home-reader-frame--show-play");
				};

				const hidePlayButton = () => {
					frame.classList.remove("home-reader-frame--show-play");
				};

				const playVideo = () => {
					hidePlayButton();
					video.currentTime = 0;
					const playAttempt = video.play();

					if (playAttempt && typeof playAttempt.catch === "function") {
						playAttempt.catch(showPlayButton);
					}
				};

				video.addEventListener("play", hidePlayButton);
				video.addEventListener("ended", () => {
					video.pause();
					video.currentTime = 0;
					showPlayButton();
				});
				playButton.addEventListener("click", playVideo);

				requestAnimationFrame(playVideo);
			};

			setupHomeReaderVideo();
			document.addEventListener("astro:page-load", setupHomeReaderVideo);
		})();
	</script>
	<section class="section section--green home-tech-visual-section" aria-label="Explore ReaderPub platform">
		<h2 class="home-tech-container-title">
			<span class="home-tech-container-title-primary">ReaderPub is end-to-end:</span>
			<span class="home-tech-container-title-secondary">from creation and publishing to reading and engagement</span>
		</h2>
		<a class="home-tech-picture-link" href="/platform" aria-label="Explore the ReaderPub platform">
			<picture class="home-tech-picture">
				<source media="(orientation: portrait)" srcset="/images/tech_mobile.webp" width="823" height="1743" />
				<img
					src="/images/tech.webp"
					alt="ReaderPub dashboard connecting publishing, browser reading, discussion, and reader activity"
					loading="lazy"
					decoding="async"
					width="1663"
					height="946"
				/>
			</picture>
		</a>
		<h2 class="home-tech-reader-activity-note">This is what reader activity looks like on <span>ReaderPub</span>.</h2>
		<a class="button home-tech-visual-button home-tech-platform-button" href="/platform">Explore ReaderPub</a>
	</section>

	<Section
		tone="white"
		class="home-file-model-section section--two-column"
		title="The old file-first model breaks the reader relationship"
		body="The old file-first publishing model ends when a file is delivered. ReaderPub keeps publications alive and connected after delivery."
		>
			<div class="home-comparison-grid">
				<article class="comparison-text-panel home-list-card home-old-model-card">
					<div class="card-copy">
						<h3>Old model</h3>
						<ul class="home-model-list" style="--home-model-marker-color: var(--text);">
							<li>File is uploaded</li>
							<li>Reader downloads the file</li>
							<li>Discussion moves elsewhere</li>
						<li>Audience becomes invisible</li>
						<li>Relationship ends</li>
					</ul>
					</div>
				</article>
				<article class="card card--good home-list-card home-readerpub-model-card">
					<div class="card-copy">
						<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> model</h3>
						<ul class="home-model-list">
							<li>Book is published online</li>
							<li>Reader opens it instantly in the web eReader</li>
							<li>Comments stay connected</li>
							<li>Audience remains visible</li>
							<li>Relationship continues</li>
						</ul>
					</div>
				</article>
			</div>
	</Section>

	<Section tone="white" class="home-web-asset-section section--two-column" title="What changes when a book becomes a living web asset?">
		<div class="home-comparison-grid">
				<article class="comparison-text-panel home-comparison-card home-old-publishing-card" style="background: var(--card-bg);">
				<div class="card-copy">
					<h3>Traditional publishing</h3>
					<p class="home-flow home-flow--dark">Publish → Download → Relationship ends</p>
					<p>The traditional model delivers a file and loses the reader relationship once access begins.</p>
				</div>
			</article>
			<article class="card card--good home-comparison-card home-readerpub-publishing-card">
				<div class="card-copy">
					<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> publishing</h3>
					<p class="home-flow">
						Publish <span class="home-flow-arrow">→</span> Discover <span class="home-flow-arrow">→</span> Read <span class="home-flow-arrow">→</span>
						Share &amp; Discuss <span class="home-flow-arrow">→</span> Follow &amp; Engage
					</p>
					<p>ReaderPub keeps the publication alive on the web, connected to readers, discussion, and long-term discovery.</p>
				</div>
			</article>
		</div>
	</Section>

	<Section
		id="solution"
		tone="green"
		title="How ReaderPub creates live web publications"
		body="ReaderPub combines browser-based reading, secure web-native publishing, public and private discussion, and structured knowledge tools so books and publications remain alive after launch."
	>
		<CardGrid columns="2" class="home-product-grid">
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/weread"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Read</span></a></h3>
					<p>Books open instantly in the browser instead of being trapped inside apps or files.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/wepub"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Pub</span></a></h3>
					<p>Authors and publishers release secure web-native publications while keeping their audience relationships.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3 class="home-product-title-line">
						<a class="home-product-link" href="/webuzz"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Buzz</span></a>
						<span class="home-product-divider">/</span>
						<a class="home-product-link" href="/wetalk"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Talk</span></a>
					</h3>
					<p>Social, public, and private discussions stay connected to books, authors, researchers, and ideas.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/booktree"><span class="home-product-name-base">Book</span><span class="home-product-name-accent">Tree</span></a></h3>
					<p>Serious readers connect books, notes, and projects into durable knowledge structures.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/scribe">Scribe</a></h3>
					<p>A specialized AI companion for literature, writing, publishing, and ReaderPub.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		title="ReaderPub is not just another ebook platform"
	>
		<Fragment slot="body">
			ReaderPub is a web-native publishing network where books and knowledge publications become <span class="home-cta-body-accent">living web assets</span>.
		</Fragment>
		<CardGrid columns="4">
			<Card title="Readable" body="Readers open publications instantly in the browser." />
			<Card title="Discoverable" body="Books and publications have a web presence, metadata, and shareable URLs." />
			<Card title="Discussable" body="Conversation stays attached to books, authors, fragments, and ideas." />
			<Card title="Connected" body="Authors, publishers, and institutions can see and engage with their reading audiences." />
		</CardGrid>
	</Section>

	<Section tone="green">
		<Fragment slot="title">Who benefits from <span class="green-heading-white">web-native reading</span>?</Fragment>
		<CardGrid columns="4">
			<Card icon="readerBook" title="Readers" body="They get instant access, richer context, connected discussion, and better discovery." />
			<Card icon="author" title="Authors" body="They keep more revenue, gain greater audience visibility, and build a longer-term reader connection." />
			<Card icon="publisher" title="Publishers" body="They launch books as active web assets, not isolated product files." />
			<Card icon="library" title="Institutions" body="They turn collections and research into visible public knowledge infrastructure." />
		</CardGrid>
	</Section>

	<CtaBlock
		title="Books should live on the web."
		actions={[
			{ label: "Publish with WePub", href: PUBLISH_URL, external: true },
			{ label: "60K+ books in Catalog", href: BOOKS_URL, external: true, variant: "secondary" },
		]}
	>
		<Fragment slot="body">
			ReaderPub helps books and knowledge publications remain <span class="home-cta-body-accent">living web assets</span>—readable, searchable, shareable, discussable, and connected.
		</Fragment>
	</CtaBlock>
</Base>

<style>
	.home-cta-body-accent {
		color: var(--accent-orange) !important;
	}

	.home-hero-statement {
		max-width: 720px;
		color: var(--accent-copy);
		font-family: var(--font-body);
		font-size: var(--hero-solution-copy-size);
		font-weight: 400;
		letter-spacing: 0;
		line-height: var(--line-height-body);
	}

	.home-hero-strategy {
		max-width: 720px;
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: clamp(22.1px, 2.72vw, 32.3px);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--letter-spacing-heading);
		line-height: var(--line-height-heading);
	}

	.home-hero-lockin {
		max-width: 720px;
		color: var(--text);
	}

	@media (orientation: portrait) {
		:global(.home-hero .hero-image) {
			height: min(clamp(500px, 31vw, 560px), calc(100cqw * 0.98));
			max-width: none;
		}
	}

	:global(.home-tech-heading-section) {
		gap: 0;
		justify-items: center;
		padding-top: calc(var(--section-padding) * 0.8);
		padding-bottom: var(--section-padding);
	}

	:global(.home-tech-visual-section) {
		justify-items: center;
		gap: calc(var(--section-padding) * 0.45);
	}

	:global(.content > .section.section--gray + .home-tech-heading-section) {
		margin-top: calc(var(--section-stack-gap) * 0.8);
	}

	:global(body .page .content > .home-tech-heading-section + .home-tech-visual-section),
	:global(body .page .content > .home-tech-heading-section + script + .home-tech-visual-section) {
		margin-top: var(--section-stack-gap) !important;
	}

	:global(.content > .home-tech-visual-section + .section.section--white) {
		margin-top: calc(var(--section-stack-gap) * 0.64);
	}

	.home-tech-title {
		justify-self: stretch;
		width: 100%;
		margin: 0;
		font-size: clamp(1.8rem, 2.88vw, 2.88rem);
		text-align: center;
	}

	.home-tech-title-prefix {
		color: var(--text);
		font-style: italic;
	}

	.home-tech-title-prefix::after {
		content: "";
		display: inline-block;
		width: 0.58em;
	}

	.home-tech-title-line {
		display: block;
		margin: 0;
		color: var(--text);
		font-size: inherit;
		white-space: normal;
	}

	.home-tech-title-line + .home-tech-title-line {
		margin-top: clamp(10px, 1vw, 16px);
	}

	.home-tech-title-line-primary {
		white-space: nowrap;
	}

	.home-tech-title-line-solution {
		justify-self: stretch;
		width: 100%;
		margin-top: clamp(10px, 1vw, 16px);
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: clamp(22.1px, 2.72vw, 32.3px);
		font-weight: var(--font-weight-heading);
		line-height: var(--card-heading-line-height);
		text-align: center;
		white-space: nowrap;
	}

	.home-tech-title-plus {
		color: var(--accent-orange);
	}

	.home-tech-title .home-tech-title-readerpub {
		color: var(--accent) !important;
	}

	.home-product-word {
		display: inline-block;
		color: var(--accent);
	}

	.home-product-word > span:last-child {
		color: var(--accent-orange);
	}

	.home-tech-visual-button,
	.home-tech-visual-button:visited {
		justify-self: center;
		width: auto;
		background: var(--accent-orange);
	}

	.home-tech-visual-button:hover,
	.home-tech-visual-button:focus-visible {
		background: var(--text);
	}

	.home-tech-picture-link,
	.home-tech-picture {
		display: block;
		width: 100%;
	}

	.home-tech-reader-activity-note {
		margin: 0;
		color: var(--accent-orange);
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 1.8vw, 1.75rem);
		font-weight: var(--font-weight-heading);
		line-height: var(--line-height-heading);
		text-align: center;
	}

	.home-tech-reader-activity-note span {
		color: #ffffff !important;
	}

	.home-tech-picture-link {
		color: inherit;
		text-decoration: none;
	}

	.home-tech-picture img {
		display: block;
		width: 100%;
		height: auto;
	}

	.home-reader-frame {
		position: relative;
		justify-self: stretch;
		width: 100%;
		margin-top: 34px;
		aspect-ratio: 1272 / 798;
		height: auto;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: #ffffff;
		box-shadow: var(--card-green-shadow);
		transition:
			border-color var(--motion-deliberate) ease,
			box-shadow var(--motion-deliberate) ease;
	}

	.home-reader-frame:hover,
	.home-reader-frame:focus-within {
		border-color: var(--accent-orange);
	}

	.home-reader-video-link {
		display: block;
		width: 100%;
		height: 100%;
	}

	.home-reader-frame video {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: contain;
		background: #ffffff;
	}

	.home-reader-play-button {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: clamp(37px, 4vw, 57px);
		aspect-ratio: 1;
		border: 0;
		border-radius: 999px;
		background: var(--accent-orange);
		box-shadow: 0 7px 16px rgba(15, 23, 42, 0.18);
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, -50%) scale(0.9);
		transition:
			background var(--motion-fast) ease,
			opacity var(--motion-fast) ease,
			transform var(--motion-fast) ease;
	}

	.home-reader-play-button:hover,
	.home-reader-play-button:focus-visible {
		background: var(--text);
	}

	.home-reader-play-button > span {
		width: 0;
		height: 0;
		margin-left: 0.16em;
		border-top: 0.42em solid transparent;
		border-bottom: 0.42em solid transparent;
		border-left: 0.64em solid #ffffff;
		font-size: clamp(20px, 2.07vw, 29px);
	}

	.home-reader-frame--show-play .home-reader-play-button {
		opacity: 1;
		pointer-events: auto;
		transform: translate(-50%, -50%) scale(1);
	}

	.home-tablet-picture {
		display: block;
		justify-self: stretch;
		width: 100%;
	}

	.home-tablet-picture img {
		display: block;
		width: 100%;
		height: auto;
	}

	.home-tech-reader-cta {
		display: grid;
		justify-items: center;
		gap: clamp(10px, 1vw, 16px);
		justify-self: stretch;
		width: 100%;
		margin-top: 34px;
	}

	.home-tech-visual-title {
		margin: 0;
		color: var(--text) !important;
		font-size: clamp(22.1px, 2.72vw, 32.3px);
		text-align: center;
	}

	.home-tech-guess {
		display: inline-block;
		margin-right: 0.58em;
		color: var(--accent-orange) !important;
		font-style: normal !important;
	}

	.home-tech-guess-question {
		color: var(--accent-orange) !important;
	}

	.home-tech-reader-subtitle {
		justify-self: stretch;
		width: 100%;
		margin: 0;
		color: var(--accent) !important;
		font-size: clamp(22.1px, 2.72vw, 32.3px);
		line-height: var(--card-heading-line-height);
		text-align: center;
	}

	.home-tech-reader-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--button-row-gap);
		justify-self: center;
		width: 100%;
		margin-top: calc(var(--button-row-gap) * 0.25);
	}

	.home-tech-reader-actions-separator {
		color: var(--text);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 500;
		line-height: var(--line-height-heading);
	}

	.home-tech-reader-actions .button {
		width: auto;
	}

	.home-tech-container-title {
		margin: 0;
		justify-self: center;
		width: 100%;
		max-width: 1120px;
		color: var(--accent-orange) !important;
		text-align: center !important;
	}

	.home-tech-container-title > span {
		display: block !important;
	}

	.home-tech-container-title-primary {
		color: #ffffff !important;
	}

	.home-comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.home-comparison-card,
	.home-list-card {
		min-height: 0;
	}

	:global(.home-readerpub-model-card.home-readerpub-model-card) {
		background: var(--card-bg) !important;
	}

	.home-flow {
		color: var(--accent-copy);
		font-weight: 700;
	}

	.home-flow--dark,
	.home-flow-arrow {
		color: var(--text);
	}

	.home-title-accent,
	:global(.home-product-grid .card h3) {
		color: var(--accent);
	}

