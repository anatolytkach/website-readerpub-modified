---
import ActionLink from "../components/ActionLink.astro";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import { BOOKS_URL, PUBLISH_URL, SITE_NAME } from "../consts";
---

<Base
	title={`Transforming the world of books. | ${SITE_NAME}`}
	description="We make your books readable online and keep your readers connected. No apps, downloads, or platform lock-in."
>
	<HeroSection
		class="home-hero"
		title="Transforming the world of books."
		lead="E-books are still delivered as files detached from authors, publishers, discussions, and communities."
		image="/images/chain1.webp"
		imageAlt=""
		actions={[
			{ label: "Explore the solution", href: "/platform" },
			{ label: "Read 60K+ books in WeRead", href: BOOKS_URL, external: true, variant: "secondary" },
		]}
		spacerBackgroundPositionY="0%"
	>
		<p class="home-hero-statement hero-body">
			We make your books readable online and keep your readers connected.
		</p>
		<p class="home-hero-strategy">
			Read instantly. Publish securely. Distribute strategically.
		</p>
		<p class="home-hero-lockin hero-lead">
			No apps, downloads, or platform lock-in.
		</p>
	</HeroSection>

	<Section
		tone="gray"
		title="The challenge:"
		body="Digital publishing made distribution easier, but it did not keep books connected to readers, discussion or long-term discovery."
	>
		<CardGrid columns="3" class="home-problem-grid">
			<Card
				href="/weread"
				icon="readerBook"
				title="Readers"
				body="Reading is digital, but discussion and discovery are fragmented across apps, stores and social networks."
			/>
			<Card
				href="/authors"
				icon="author"
				title="Authors & Publishers"
				body="Authors publish books, but marketplaces often control visibility, readers and the customer relationship."
			/>
			<Card
				href="/institutions"
				icon="library"
				title="Institutions"
				body="Libraries, universities and public organizations publish knowledge that remains hard to find, read and discuss."
			/>
		</CardGrid>
	</Section>

	<section class="section section--white home-tech-heading-section" aria-labelledby="home-tech-title">
		<h2 id="home-tech-title" class="home-tech-title">
			<span class="home-tech-title-line home-tech-title-line-primary"><span class="home-tech-title-prefix">The solution:&nbsp;&nbsp;</span><span class="home-tech-title-readerpub" style="color: var(--accent);"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span></span>
			<span class="home-tech-title-line home-tech-title-line-solution">Browser-based eReader <span class="home-tech-title-plus">+</span> web-native publishing network.</span>
		</h2>
		<script is:inline>
			(() => {
				try {
					const readerDemoSessionKey = "readerpub:home-reader-demo-started:90000120";
					const readerPositionKey = "readerpub:lastcfi:90000120";
					const navigationEntry = performance.getEntriesByType("navigation")[0];

					if (sessionStorage.getItem(readerDemoSessionKey)) {
						return;
					}

					sessionStorage.setItem(readerDemoSessionKey, "1");

					if (navigationEntry?.type !== "reload") {
						localStorage.removeItem(readerPositionKey);
					}
				} catch {}
			})();
		</script>
		<div class="home-reader-frame">
			<iframe
				src="/books/reader/?id=90000120&source=gutenberg&reader=protected&protectedArtifactBookId=90000120&protectedArtifactSource=r2"
				title="Treasure Island in WeRead"
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="fullscreen"
			></iframe>
		</div>
		<div class="home-tech-reader-cta">
			<h2 class="home-tech-visual-title heading--center-full heading--center-full-h2">You got it, it’s not an app. It is <span class="home-product-word"><span>We</span><span>Read</span></span> webpage.</h2>
			<h2 class="home-tech-reader-subtitle heading--center-full heading--center-full-h2">You can read the thrilling story right here, or...</h2>
			<div class="home-tech-reader-actions">
				<a class="button button--secondary" href={BOOKS_URL} target="_blank" rel="noopener noreferrer">Read 60K+ books in WeRead</a>
				<span class="home-tech-reader-actions-separator">or</span>
				<a class="button home-tech-visual-button home-tech-reader-button" href="/weread">Explore WeRead</a>
			</div>
		</div>
	</section>
	<section class="section section--green home-tech-visual-section" aria-label="Explore ReaderPub platform">
		<h2 class="home-tech-container-title">
			<span class="home-tech-container-title-primary">ReaderPub is end-to-end:</span>
			<span class="home-tech-container-title-secondary">from creating to publishing and engagement</span>
		</h2>
		<picture class="home-tech-picture">
			<source media="(orientation: portrait)" srcset="/images/tech_mobile.webp" width="823" height="1743" />
			<img
				src="/images/tech.webp"
				alt="ReaderPub connects web publishing, reading, discussion and knowledge tools"
				loading="lazy"
				decoding="async"
				width="1663"
				height="946"
			/>
		</picture>
		<a class="button home-tech-visual-button home-tech-platform-button" href="/platform">Explore ReaderPub</a>
	</section>

	<Section
		tone="white"
		class="home-file-model-section section--two-column"
		title="The old file-first model breaks the relationship"
		body="The old publishing model ends when a file is delivered. ReaderPub helps publications remain alive and connected after delivery."
		>
			<div class="home-comparison-grid">
				<article class="comparison-text-panel home-list-card home-old-model-card">
					<div class="card-copy">
						<h3>Old model</h3>
						<ul class="home-model-list" style="--home-model-marker-color: var(--text);">
							<li>File uploaded</li>
							<li>Reader downloads</li>
							<li>Discussion moves elsewhere</li>
						<li>Audience becomes invisible</li>
						<li>Relationship ends</li>
					</ul>
					</div>
				</article>
				<article class="card card--good home-list-card home-readerpub-model-card">
					<div class="card-copy">
						<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> model</h3>
						<ul class="home-model-list">
							<li>Book is published online</li>
							<li>Reader opens instantly in web eReader</li>
							<li>Comments stay connected</li>
							<li>Audience remains visible</li>
							<li>Relationship continues</li>
						</ul>
					</div>
				</article>
			</div>
	</Section>

	<Section tone="white" class="home-web-asset-section section--two-column" title="What changes when a book becomes a living web asset?">
		<div class="home-comparison-grid">
				<article class="comparison-text-panel home-comparison-card home-old-publishing-card" style="background: var(--card-bg);">
				<div class="card-copy">
					<h3>Traditional publishing</h3>
					<p class="home-flow home-flow--dark">Publish → Download → Relationship ends</p>
					<p>The old model delivers a file and loses the reader relationship after access begins.</p>
				</div>
			</article>
			<article class="card card--good home-comparison-card home-readerpub-publishing-card">
				<div class="card-copy">
					<h3><span class="home-title-accent readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> publishing</h3>
					<p class="home-flow">
						Publish <span class="home-flow-arrow">→</span> Discover <span class="home-flow-arrow">→</span> Read <span class="home-flow-arrow">→</span>
						Share &amp; Discuss <span class="home-flow-arrow">→</span> Follow &amp; Engage
					</p>
					<p>ReaderPub keeps the publication alive on the web, connected to readers, discussion and long-term discovery.</p>
				</div>
			</article>
		</div>
	</Section>

	<Section
		id="solution"
		tone="green"
		title="How ReaderPub creates live web publications"
		body="ReaderPub combines web reading, secure publishing, public discussion and structured knowledge tools so books and publications remain alive after launch."
	>
		<CardGrid columns="2" class="home-product-grid">
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/weread"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Read</span></a></h3>
					<p>Books open instantly in the browser instead of being trapped inside apps or files.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/wepub"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Pub</span></a></h3>
					<p>Authors and publishers release secure web-native publications while keeping audience relationships.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3 class="home-product-title-line">
						<a class="home-product-link" href="/webuzz"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Buzz</span></a>
						<span class="home-product-divider">/</span>
						<a class="home-product-link" href="/wetalk"><span class="home-product-name-base">We</span><span class="home-product-name-accent">Talk</span></a>
					</h3>
					<p>Social and private discussions stay connected to books, authors, researchers, and ideas.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/booktree"><span class="home-product-name-base">Book</span><span class="home-product-name-accent">Tree</span></a></h3>
					<p>Serious readers connect books, notes and projects into durable knowledge structures.</p>
				</div>
			</article>
			<article class="card">
				<div class="card-copy">
					<h3><a class="home-product-link" href="/scribe">Scribe</a></h3>
					<p>A specialized AI companion for literature, writing, publishing and ReaderPub.</p>
				</div>
			</article>
		</CardGrid>
	</Section>

	<Section
		tone="white"
		title="ReaderPub is not yet another ebook platform"
	>
		<Fragment slot="body">
			ReaderPub is a web-native publishing network where books and knowledge publications become <strong>living web assets</strong>.
		</Fragment>
		<CardGrid columns="4">
			<Card title="Readable" body="Readers open publications instantly in the browser." />
			<Card title="Discoverable" body="Books and publications have web presence, metadata and shareable URLs." />
			<Card title="Discussable" body="Conversation stays attached to books, authors, fragments and ideas." />
			<Card title="Connected" body="Authors, publishers and institutions can see and engage with their reading audience." />
		</CardGrid>
	</Section>

	<Section tone="green">
		<Fragment slot="title">Who benefits from <span class="green-heading-white">web-native reading</span>?</Fragment>
		<CardGrid columns="4">
			<Card icon="readerBook" title="Readers" body="They get instant access, context, discussion and better discovery." />
			<Card icon="author" title="Authors" body="They keep more revenue, more audience visibility and more long-term reader connection." />
			<Card icon="publisher" title="Publishers" body="They launch books as active web assets, not isolated product files." />
			<Card icon="library" title="Institutions" body="They turn collections and research into visible public knowledge infrastructure." />
		</CardGrid>
	</Section>

	<CtaBlock
		title="Books should live on the web."
		actions={[
			{ label: "Publish with WePub", href: PUBLISH_URL, external: true },
			{ label: "60K+ books in Catalog", href: BOOKS_URL, external: true, variant: "secondary" },
		]}
	>
		<Fragment slot="body">
			ReaderPub helps books and knowledge publications remain <span class="home-cta-body-accent">living web assets</span> — readable, searchable, shareable, discussable and connected.
		</Fragment>
	</CtaBlock>
</Base>

<style>
	.home-cta-body-accent {
		color: var(--accent-orange);
	}

	.home-hero-statement {
		max-width: 720px;
		color: var(--accent-copy);
		font-family: var(--font-body);
		font-size: var(--hero-solution-copy-size);
		font-weight: 400;
		letter-spacing: 0;
		line-height: var(--line-height-body);
	}

	.home-hero-strategy {
		max-width: 720px;
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: clamp(22.1px, 2.72vw, 32.3px);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--letter-spacing-heading);
		line-height: var(--line-height-heading);
	}

	.home-hero-lockin {
		max-width: 720px;
		color: var(--text);
	}

	@media (orientation: portrait) {
		:global(.home-hero .hero-image) {
			height: min(clamp(500px, 31vw, 560px), calc(100cqw * 0.98));
			max-width: none;
		}
	}

	:global(.home-tech-heading-section) {
		gap: 34px;
		justify-items: center;
		padding-top: calc(var(--section-padding) * 0.8);
		padding-bottom: var(--section-padding);
	}

	:global(.home-tech-visual-section) {
		justify-items: center;
		gap: calc(var(--section-padding) * 0.45);
	}

	:global(.content > .section.section--gray + .home-tech-heading-section) {
		margin-top: calc(var(--section-stack-gap) * 0.8);
	}

	:global(body .page .content > .home-tech-heading-section + .home-tech-visual-section) {
		margin-top: var(--section-stack-gap) !important;
	}

	:global(.content > .home-tech-visual-section + .section.section--white) {
		margin-top: calc(var(--section-stack-gap) * 0.64);
	}

	.home-tech-title {
		justify-self: stretch;
		width: 100%;
		margin: 0;
		text-align: center;
	}

	.home-tech-title-prefix {
		color: var(--text);
		font-style: italic;
	}

	.home-tech-title-line {
		display: block;
		margin: 0;
		color: var(--text);
		white-space: normal;
	}

	.home-tech-title-line + .home-tech-title-line {
		margin-top: clamp(10px, 1vw, 16px);
	}

	.home-tech-title-line-primary {
		white-space: nowrap;
	}

	.home-tech-title-line-solution {
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 2.88vw, 2.88rem);
		font-weight: var(--font-weight-heading);
		line-height: var(--line-height-heading);
		white-space: nowrap;
	}

	.home-tech-title-plus {
		color: var(--accent-orange);
	}

	.home-tech-title .home-tech-title-readerpub {
		color: var(--accent) !important;
	}

	.home-product-word {
		display: inline-block;
		color: var(--accent);
	}

	.home-product-word > span:last-child {
		color: var(--accent-orange);
	}

	.home-tech-visual-button,
	.home-tech-visual-button:visited {
		justify-self: center;
		width: auto;
		background: var(--accent-orange);
	}

	.home-tech-visual-button:hover,
	.home-tech-visual-button:focus-visible {
		background: var(--text);
	}

	.home-tech-picture {
		display: block;
		width: 100%;
	}

	.home-tech-picture img {
		display: block;
		width: 100%;
		height: auto;
	}

	.home-reader-frame {
		justify-self: stretch;
		width: 100%;
		height: clamp(520px, 68vw, 820px);
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 8px;
		box-shadow: var(--card-green-shadow);
		transition:
			border-color var(--motion-deliberate) ease,
			box-shadow var(--motion-deliberate) ease;
	}

	.home-reader-frame:hover,
	.home-reader-frame:focus-within {
		border-color: var(--accent);
	}

	.home-reader-frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		background: #ffffff;
	}

	.home-tablet-picture {
		display: block;
		justify-self: stretch;
		width: 100%;
	}

	.home-tablet-picture img {
		display: block;
		width: 100%;
		height: auto;
	}

	.home-tech-reader-cta {
		display: grid;
		justify-items: center;
		gap: clamp(10px, 1vw, 16px);
		justify-self: stretch;
		width: 100%;
	}

	.home-tech-visual-title {
		margin: 0;
		color: var(--text) !important;
		text-align: center;
	}

	.home-tech-reader-subtitle {
		margin: 0;
		color: var(--accent) !important;
	}

	.home-tech-reader-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--button-row-gap);
		justify-self: center;
		width: 100%;
		margin-top: calc(var(--button-row-gap) * 0.25);
	}

	.home-tech-reader-actions-separator {
		color: var(--text);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 500;
		line-height: var(--line-height-heading);
	}

	.home-tech-reader-actions .button {
		width: auto;
	}

	.home-tech-container-title {
		margin: 0;
		justify-self: center;
		width: 100%;
		max-width: 1120px;
		color: var(--accent-orange) !important;
		text-align: center !important;
	}

	.home-tech-container-title > span {
		display: block !important;
	}

	.home-tech-container-title-primary {
		color: #ffffff !important;
	}

	.home-comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.home-comparison-card,
	.home-list-card {
		min-height: 0;
	}

	:global(.home-readerpub-model-card.home-readerpub-model-card) {
		background: var(--card-bg) !important;
	}

	.home-flow {
		color: var(--accent-copy);
		font-weight: 700;
	}

	.home-flow--dark,
	.home-flow-arrow {
		color: var(--text);
	}

	.home-title-accent,
	:global(.home-product-grid .card h3) {
		color: var(--accent);
	}

	:global(.home-readerpub-publishing-card:hover h3),
	:global(.home-readerpub-publishing-card:hover h3 *) {
		color: var(--accent-orange) !important;
	}

	:global(.home-readerpub-publishing-card:hover .home-flow-arrow) {
		color: var(--accent-orange) !important;
	}

	:global(.home-product-grid .home-product-link),
	:global(.home-product-grid .home-product-link:visited) {
		display: inline-flex;
		position: relative;
		isolation: isolate;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 11px 18px;
		border: 1px solid transparent;
		border-radius: var(--radius-control);
		background: transparent;
		color: var(--accent);
		font-family: var(--font-ui);
		font-size: 0.95rem;
		font-weight: 500;
		line-height: var(--line-height-heading);
		text-decoration: none;
		-webkit-mask-image:
			url("data:image/svg+xml,%3Csvg%20viewBox%3D%270%200%20100%20100%27%20preserveAspectRatio%3D%27none%27%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%3E%3Cpath%20fill%3D%27%23000%27%20d%3D%27M%200%200%20C%204.5%2025%204.5%2075%200%20100%20L%20100%20100%20L%20100%200%20Z%27/%3E%3C/svg%3E"),
			linear-gradient(#000, #000);
		mask-image:
			url("data:image/svg+xml,%3Csvg%20viewBox%3D%270%200%20100%20100%27%20preserveAspectRatio%3D%27none%27%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%3E%3Cpath%20fill%3D%27%23000%27%20d%3D%27M%200%200%20C%204.5%2025%204.5%2075%200%20100%20L%20100%20100%20L%20100%200%20Z%27/%3E%3C/svg%3E"),
			linear-gradient(#000, #000);
		-webkit-mask-position:
			left top,
			right top;
		mask-position:
			left top,
			right top;
		-webkit-mask-repeat:
			no-repeat,
			no-repeat;
		mask-repeat:
			no-repeat,
			no-repeat;
		-webkit-mask-size:
			var(--button-left-curve-width) 100%,
			calc(100% - var(--button-left-curve-width) + 1px) 100%;
		mask-size:
			var(--button-left-curve-width) 100%,
			calc(100% - var(--button-left-curve-width) + 1px) 100%;
		cursor: pointer;
		transition:
			border-color var(--motion-deliberate) ease,
			background var(--motion-deliberate) ease,
			color var(--motion-deliberate) ease;
	}

	:global(.home-product-grid .home-product-link::before),
	:global(.home-product-grid .home-product-link::after) {
		content: "";
		position: absolute;
		border-radius: var(--radius-control);
		-webkit-mask-image:
			url("data:image/svg+xml,%3Csvg%20viewBox%3D%270%200%20100%20100%27%20preserveAspectRatio%3D%27none%27%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%3E%3Cpath%20fill%3D%27%23000%27%20d%3D%27M%200%200%20C%204.5%2025%204.5%2075%200%20100%20L%20100%20100%20L%20100%200%20Z%27/%3E%3C/svg%3E"),
			linear-gradient(#000, #000);
		mask-image:
			url("data:image/svg+xml,%3Csvg%20viewBox%3D%270%200%20100%20100%27%20preserveAspectRatio%3D%27none%27%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%3E%3Cpath%20fill%3D%27%23000%27%20d%3D%27M%200%200%20C%204.5%2025%204.5%2075%200%20100%20L%20100%20100%20L%20100%200%20Z%27/%3E%3C/svg%3E"),
			linear-gradient(#000, #000);
		-webkit-mask-position:
			left top,
			right top;
		mask-position:
			left top,
			right top;
		-webkit-mask-repeat:
			no-repeat,
			no-repeat;
		mask-repeat:
			no-repeat,
			no-repeat;
		-webkit-mask-size:
			var(--button-left-curve-width) 100%,
			calc(100% - var(--button-left-curve-width) + 1px) 100%;
		mask-size:
			var(--button-left-curve-width) 100%,
			calc(100% - var(--button-left-curve-width) + 1px) 100%;
		pointer-events: none;
