		:is(
			.home-video-solution-label,
			.home-video-brand,
			.home-video-brand-mark,
			.home-video-wordmark,
			.home-video-slogan-block,
			.home-video-strategy,
			.home-video-scroll,
			.home-video-replay,
			.home-video-start-button
		) {
		transition: none;
	}

	/* The stage keeps one fixed centring plane through the complete sequence.
	 * In particular, the lower wave must not return to normal flow just before
	 * the final panel appears: that was shrinking the stage and lifting the
	 * video above the shared centre line. */
	.home-video-stage:is(.is-opened, .is-darkening, .is-final) .home-video-wave-space {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 0;
