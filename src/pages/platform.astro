---
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import ProductName from "../components/ProductName.astro";
import Base from "../layouts/Base.astro";
import { BOOKS_URL, SITE_NAME } from "../consts";

const heroActions = [
	{ label: "Start publishing", href: "/wepub" },
	{ label: "Explore security", href: "/security/", variant: "secondary" as const },
];

const ctaActions = [
	{ label: "Get started", href: "/contact" },
	{ label: "See pricing", href: "/pricing", variant: "secondary" as const },
];

const problemCards = [
	{
		title: "Publishing is separate",
		body: "Books are created and distributed through one set of tools, then handed off elsewhere.",
	},
	{
		title: "Reading is separate",
		body: "Readers move into isolated applications and closed ecosystems.",
	},
	{
		title: "Discussion is separate",
		body: "Conversations happen across platforms that are disconnected from the publication.",
	},
	{
		title: "Knowledge is separate",
		body: "Notes, references, and long-term work often remain outside the publication ecosystem.",
	},
];

const benefitCards = [
	{ title: "Authors", body: "Build and maintain stronger relationships with readers.", icon: "author" as const },
	{ title: "Publishers", body: "Operate across a unified publishing ecosystem.", icon: "publisher" as const },
	{
		title: "Institutions",
		body: "Support publishing, learning, and knowledge management in one environment.",
		icon: "library" as const,
	},
	{
		title: "Readers",
		body: "Access, discuss, and organize publications within a connected system.",
		icon: "reader" as const,
	},
];

---

<Base
	title={`Digital Publishing Platform & Connected Book Tools | ${SITE_NAME}`}
	description="Explore ReaderPub's digital publishing platform for browser reading, direct sales, discussion, analytics, knowledge tools, AI, and institutional access."
>
	<HeroSection
		eyebrow="Platform"
		lead="ReaderPub combines publishing, browser-based reading, discussion, and knowledge tools in one platform, keeping books active on the web after release."
		image="/images/home2.webp"
		imageAlt="Diagram showing a manuscript processed into a live digital book with publishing and market options"
		actions={heroActions}
		spacerBackgroundPositionY="45%"
		class="platform-hero"
	>
		<Fragment slot="title"><span class="platform-hero-product">Reader<span class="hero-product-part-accent">Pub</span><span class="hero-title-colon">:</span></span><br /><span class="hero-title-rest">A web-native publishing network.</span></Fragment>
		<Fragment slot="body">Publish securely to the web.<br />Listen to your readers—and retain them.</Fragment>
	</HeroSection>

	<Section
		tone="gray"
		body="Most digital publishing workflows still rely on disconnected tools: publishing, reading, discussion, and knowledge management often happen in separate systems."
	>
		<Fragment slot="title"><span class="section-title-rest">Publishing systems</span> <span class="section-title-accent">remain fragmented</span></Fragment>
		<CardGrid columns="2" class="platform-problem-grid">
			{problemCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<div class="platform-source-sections">
		<section class="section section--green spec-cards-section platform-source-section platform-source-problem-section section--two-column">
			<h2><span class="readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> exists because the old model breaks the reader relationship</h2>
			<p class="lede">
				File-first publishing can move a book from one place to another, but it cannot keep that book connected to readers, authors, institutions, and communities.
			</p>
			<div class="model-grid">
				<div class="comparison-text-panel platform-old-model-card">
					<h3>Old publishing model</h3>
					<ul class="comparison-list">
						<li>Create a standalone file</li>
						<li>Upload it to a marketplace or archive</li>
						<li>Lose the direct reader relationship</li>
						<li>Move discussion to external platforms</li>
					</ul>
				</div>
				<div class="card card--good platform-readerpub-model-card">
					<h3><span class="platform-readerpub-word readerpub-heading-word"><span class="readerpub-heading-reader">Reader</span><span class="readerpub-heading-pub">Pub</span></span> model</h3>
					<ul class="comparison-list">
						<li>Publish the book as a living web asset</li>
						<li>Keep readers, authors, and institutions connected</li>
						<li>Keep discussion and discovery attached to the work</li>
						<li>Extend the life of every publication</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="platform-model" class="section section--white spec-cards-section platform-source-section platform-products-section section-continuation">
			<h2 class="platform-products-heading">Six products in one unified ecosystem.</h2>
			<p class="lede platform-products-lede">ReaderPub connects publishing, reading, discovery, public and private discussion, knowledge organization, and AI guidance in one ecosystem.</p>
			<div class="card-grid platform-three-grid platform-products-grid">
				<div class="card">
					<h3><ProductName name="WePub" /></h3>
					<p>Publishing workflows for authors, publishers, and organizations.</p>
					<ul class="bullets">
						<li>Upload a Word or EPUB file to produce a single web edition</li>
						<li>Upload an entire catalog through the API for bulk publishing</li>
						<li>Preview web-accessible editions before publishing</li>
						<li>Set pricing</li>
						<li>Manage published titles</li>
						<li>Generate optional EPUB editions</li>
					</ul>
					<a class="button button--secondary" href="/wepub">Explore WePub</a>
				</div>
				<div class="card">
					<h3><ProductName name="WeRead" /></h3>
					<p>Instant, browser-based reading for long-form content.</p>
					<ul class="bullets">
						<li>Read without downloading files</li>
						<li>Use annotations and notes</li>
						<li>Use native device text-to-speech</li>
						<li>Reduce unauthorized copying with Theft Guard</li>
						<li>Share the book or its content</li>
						<li>Discuss the book or its author with the community</li>
					</ul>
					<a class="button" href={BOOKS_URL} target="_blank" rel="noreferrer">60K+ books in Catalog</a>
				</div>
				<div class="card">
					<h3><ProductName name="WeBuzz" /></h3>
					<p>Discuss books, authors, and passages with readers around the world. Build literary communities, connect directly with authors and publishers, and turn reading into a shared experience.</p>
					<ul class="bullets">
						<li>Book discussions</li>
						<li>Author discussions</li>
						<li>Passage discussions</li>
						<li>Reader communities</li>
						<li>Author participation</li>
						<li>Publisher engagement</li>
					</ul>
					<a class="button button--secondary" href="/webuzz">Explore WeBuzz</a>
				</div>
				<div class="card">
					<h3><ProductName name="WeTalk" /></h3>
					<p>Private discussion environments for organizations, educational programs, collections, and controlled-access publications.</p>
					<ul class="bullets">
						<li>Private discussion spaces</li>
						<li>Controlled-access participation</li>
						<li>Collection and course communities</li>
						<li>Institutional permissions</li>
					</ul>
					<a class="button button--secondary" href="/wetalk">Explore WeTalk</a>
				</div>
				<div class="card">
					<h3><ProductName name="BookTree" /></h3>
					<p>A structure for books, editions, metadata, catalogs, and collections.</p>
					<ul class="bullets">
						<li>Organize books, excerpts, and references across projects</li>
						<li>Preserve context while reading long, complex materials</li>
						<li>Build personal knowledge maps from your reading</li>
						<li>Consolidate notes from multiple books while working on your own manuscript</li>
					</ul>
					<a class="button button--secondary" href="/booktree">Explore BookTree</a>
				</div>
				<div class="card">
					<h3>Scribe</h3>
					<p>A conversational AI layer for books, literature, writing, publishing, and ReaderPub platform guidance.</p>
					<ul class="bullets">
						<li>Ask focused questions about literature, books, and authors</li>
						<li>Discuss writing, editing, and publishing workflows</li>
						<li>Get platform guidance without leaving ReaderPub</li>
						<li>Continue saved WeBuzz conversations from My Activity</li>
					</ul>
					<a class="button button--secondary" href="/scribe">Explore Scribe</a>
				</div>
			</div>
		</section>

		<section class="section section--white spec-cards-section platform-source-section section-continuation platform-capabilities-section">
			<h2>Platform capabilities</h2>
			<div class="card-grid platform-three-grid">
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Browser-based active reading</h3><p class="platform-capability-copy">Deliver publications instantly through the web.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Protected web editions</h3><p class="platform-capability-copy">Use web-native access instead of handing off a reusable file.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Direct sales</h3><p class="platform-capability-copy">Sell books, courses, cohorts, and limited releases.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Low commission</h3><p class="platform-capability-copy">Sell directly to readers with a low 5% platform fee.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Reader analytics</h3><p class="platform-capability-copy">Track reader engagement, feedback, and access patterns.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Collaboration</h3><p class="platform-capability-copy">Use annotations, notes, and shared context across teams.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Institutional access</h3><p class="platform-capability-copy">User, group, course, department, and role controls.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Catalog support</h3><p class="platform-capability-copy">Import and preserve structured metadata at scale.</p></div>
				<div class="card platform-capability-card"><h3 class="platform-capability-title">Reader community</h3><p class="platform-capability-copy">Readers discuss and promote books and knowledge content.</p></div>
			</div>
			<Section
				tone="green"
				class="platform-flow-section"
				title="How ReaderPub works"
				body="Each layer supports a different stage of the publication lifecycle while remaining connected within one platform."
			>
				<ol class="platform-flow" aria-label="ReaderPub publication lifecycle">
					<li class="card"><ProductName name="WePub" /><span class="platform-flow-arrow" aria-hidden="true">→</span></li>
					<li class="card"><ProductName name="WeRead" /><span class="platform-flow-arrow" aria-hidden="true">→</span></li>
					<li class="card"><ProductName name="BookTree" /><span class="platform-flow-arrow" aria-hidden="true">→</span></li>
					<li class="card"><span class="platform-flow-product-pair"><ProductName name="WeBuzz" /> / <ProductName name="WeTalk" /></span><span class="platform-flow-arrow" aria-hidden="true">→</span></li>
					<li class="card"><span class="platform-flow-scribe">Scribe</span></li>
				</ol>
				<p class="platform-flow-note">
					Instead of moving readers and content between disconnected systems, ReaderPub keeps these activities connected within one publishing environment.
				</p>
				<div class="card-grid platform-two-grid platform-onboarding-grid">
					<section class="platform-onboarding-panel">
						<h3 class="platform-onboarding-heading">For creators</h3>
						<div class="card platform-onboarding-card" data-card-reveal-origin="left">
							<p class="lede">Publish your book or catalog on ReaderPub.</p>
							<ul class="bullets">
								<li>Upload Word or EPUB files</li>
								<li>Publish browser-based web editions</li>
								<li>Generate production-ready EPUBs</li>
								<li>Track reader engagement</li>
							</ul>
							<div class="cta-row">
								<a class="button" href="/wepub">Start publishing</a>
								<a class="button button--secondary" href="/pricing/">See pricing</a>
							</div>
						</div>
					</section>
					<section class="platform-onboarding-panel">
						<h3 class="platform-onboarding-heading">For organizations</h3>
						<div class="card platform-onboarding-card" data-card-reveal-origin="right">
							<p class="lede">Bring your organization's publishing and collections to ReaderPub.</p>
							<ul class="bullets">
								<li>Import from OPDS, MARC, ONIX, KBART, S3, or CSV</li>
								<li>Manage users, groups, and permissions</li>
								<li>Deploy on a ReaderPub or custom subdomain</li>
								<li>Track usage and engagement</li>
							</ul>
							<div class="cta-row">
								<a class="button" href="/contact/">Contact us for details</a>
								<a class="button button--secondary" href="/security/">Explore security</a>
							</div>
						</div>
					</section>
				</div>
			</Section>
		</section>

		<section class="section section--white platform-source-section platform-audiences-section platform-first-white-section section--two-column section-continuation">
			<h2>Audiences across the platform</h2>
			<div class="card-grid platform-audiences-cards" data-card-reveal-origin="right" data-card-reveal-order="inner-first">
				<div class="card"><h3>Authors</h3><p>Publish and sell directly, then analyze reader engagement.</p></div>
				<div class="card"><h3>Publishers</h3><p>Manage titles, editions, catalogs, and controlled access.</p></div>
				<div class="card"><h3>Schools</h3><p>Distribute course materials and monitor usage.</p></div>
				<div class="card"><h3>Libraries</h3><p>Create active digital bookshelves for their communities.</p></div>
				<div class="card"><h3>Organizations</h3><p>Publish reports, papers, and structured knowledge online.</p></div>
				<div class="card">
					<h3>Manufacturers</h3>
					<p>Publish manuals and technical documentation for easy online access.</p>
				</div>
			</div>
			<img
				class="image-block platform-audiences-image"
				src="/images/audience.webp"
				alt="Illustration of readers, authors, publishers, libraries, universities, and organizations connected through ReaderPub"
				loading="lazy"
				decoding="async"
				width="1024"
				height="841"
			/>
		</section>

		<section class="section section--white platform-source-section platform-reading-section section--two-column section-continuation">
			<h2>Reading experience</h2>
			<div class="card-grid platform-reading-cards" data-card-reveal-origin="left" data-card-reveal-order="inner-first">
				<div class="card"><h3>Annotations</h3><p>Create highlights and notes while preserving context.</p></div>
				<div class="card"><h3>Shared context</h3><p>Keep discussion connected among readers, authors, and instructors.</p></div>
				<div class="card"><h3>Read-aloud support</h3><p>Use native device text-to-speech voices.</p></div>
				<div class="card"><h3>Long-form navigation</h3><p>Navigate long-form works with clean typography for serious reading.</p></div>
				<div class="card"><h3>Cross-device access</h3><p>Return to assigned or purchased titles from any device.</p></div>
				<div class="card"><h3>Structured reading</h3><p>Keep chapters, editions, and metadata connected.</p></div>
			</div>
			<img
				class="image-block platform-reading-image"
				src="/images/readers2.webp"
				alt="Reader experience with WeRead in the browser"
				loading="lazy"
				decoding="async"
				width="1024"
				height="1024"
			/>
		</section>

		<section class="section section--white platform-source-section platform-commerce-section section--two-column section-continuation">
			<h2 class="platform-commerce-heading">Commerce &amp; analytics</h2>
			<div class="platform-commerce-split">
				<img
					class="image-block platform-commerce-image"
					src="/images/commerce.webp"
					alt="Commerce and analytics for direct sales and reader engagement"
					loading="lazy"
					decoding="async"
					width="667"
					height="600"
				/>
				<div class="platform-commerce-cards">
					<section class="card">
						<h3>Manage sales and promotion</h3>
						<p>Sell directly while keeping the reader relationship.</p>
						<ul class="bullets">
							<li>Sell web editions directly with a low commission</li>
							<li>Support books, courses, cohorts, and limited releases</li>
							<li>Build fan clubs and reader communities</li>
							<li>Connect sales with engagement analytics</li>
						</ul>
					</section>
					<section class="card">
						<h3>Track your readers and audience</h3>
						<p>Know what happens after publication.</p>
						<ul class="bullets">
							<li>Reader engagement and annotation activity</li>
							<li>Title, collection, and institutional usage insights</li>
							<li>A first-party relationship with readers</li>
						</ul>
					</section>
				</div>
			</div>
		</section>

		<section class="section section--white platform-source-section platform-control-section section--two-column section-continuation">
			<h2>Institutional control</h2>
			<div class="platform-control-split">
				<img
					class="image-block platform-control-image"
					src="/images/control.webp"
					alt="ReaderPub Access Control for teams, classes, students, departments, and partners"
					loading="lazy"
					decoding="async"
					width="960"
					height="936"
				/>
				<div class="platform-control-copy">
					<div class="card platform-control-info-card" data-card-reveal-origin="left">
						<h3 class="platform-control-heading">Control access to internal publications</h3>
						<p class="lede platform-control-lede">
							Assign access by user, group, course, department, team, program, partner
							organization, or custom permission.
						</p>
						<ul class="bullets platform-control-list">
							<li>Public and private collections</li>
							<li>Controlled-access programs</li>
							<li>Course and cohort distribution</li>
							<li>Team-based publishing workflows</li>
							<li>Permission-based administration</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

	</div>

	<Section tone="green">
		<Fragment slot="title">Who benefits from the <span class="green-heading-white">ReaderPub web-native publishing network</span>?</Fragment>
		<CardGrid columns="4">
			{benefitCards.map((card) => <Card {...card} />)}
		</CardGrid>
	</Section>

	<CtaBlock
		title="A complete platform for web-native book publishing."
		body="ReaderPub brings publishing, reading, discussion, and knowledge management together in one system."
		actions={ctaActions}
	/>
</Base>

<style>
	.platform-source-sections {
		--section-flow-gap: 16px;
		--section-block-gap-adjust: 12px;
	}

	:global(.content > .section.section--gray + .platform-source-sections) {
		margin-top: var(--section-stack-gap);
	}

	:global(.content > .platform-source-sections + .section.section--green) {
		margin-top: var(--section-stack-gap);
	}

	:global(.platform-title-accent) {
		color: var(--accent);
	}

	.platform-source-section {
		display: flex;
		flex-direction: column;
		gap: var(--section-flow-gap);
		align-items: stretch;
		margin: 0;
	}

	.platform-source-section > * {
		margin: 0 !important;
	}

	.platform-source-section > :is(.card-grid, .cta-row) {
		margin-top: var(--section-block-gap-adjust) !important;
	}

	.platform-source-section > :is(.card-grid, .cta-row) + :is(p, ul, ol, .bullets, h3, h4) {
		margin-top: var(--section-block-gap-adjust) !important;
	}

	.platform-source-section.section-continue-next {
		padding-bottom: 58px !important;
	}

	.platform-source-section.section-continuation {
		padding-top: 58px !important;
		padding-bottom: 58px !important;
		margin-top: var(--section-stack-gap) !important;
	}

	.platform-source-section.platform-audiences-section + .platform-source-section.platform-reading-section,
	.platform-source-section.platform-reading-section + .platform-source-section.platform-commerce-section,
	.platform-source-section.platform-commerce-section + .platform-source-section.platform-control-section {
		margin-top: calc(var(--section-stack-gap) * 0.7) !important;
	}

	.platform-source-section h2 {
		font-size: clamp(21.6px, 2.7vw, 30.6px);
		line-height: var(--line-height-heading);
	}

	.platform-source-section .lede {
		color: var(--accent-copy);
		font-size: 18px;
		line-height: var(--line-height-body);
	}

	.platform-source-section .platform-readerpub-word {
		color: var(--accent);
	}

	.platform-source-section .card {
		min-height: 0;
	}

	.platform-source-section .card > .button {
		align-self: flex-start;
		margin-top: auto;
	}

	.platform-source-section .model-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: calc(var(--section-flow-gap) * 1.5);
		width: 100%;
	}

	.platform-source-section .comparison-list {
		display: grid;
		gap: 10px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.platform-source-section .comparison-list li {
		position: relative;
		padding-left: 18px;
		color: var(--muted);
		font-size: 16px;
		line-height: var(--line-height-body);
	}

	.platform-source-section .comparison-list li::before {
		content: "";
		position: absolute;
		top: 0.58em;
		left: 0;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.platform-source-section .platform-old-model-card {
		background: transparent !important;
	}

	.platform-source-section .platform-old-model-card .comparison-list li::before {
		background: var(--accent-orange) !important;
	}

	.platform-source-section.platform-source-problem-section.section--green > .lede,
	.platform-source-section.platform-source-problem-section.section--green .platform-old-model-card .comparison-list li {
		color: #ffffff !important;
	}

	.platform-source-section.platform-source-problem-section.section--green .platform-old-model-card h3 {
		color: var(--accent-orange) !important;
	}

	.platform-source-section.platform-source-problem-section.section--green .platform-old-model-card .comparison-list li::before {
		background: var(--accent-orange) !important;
	}

	:global(body .page .content .platform-source-problem-section.section--green .platform-old-model-card .comparison-list li) {
		color: #ffffff !important;
	}

	.platform-source-section .bullets {
		display: grid;
		gap: 6px;
		max-width: 720px;
		padding-left: 18px;
		list-style: disc;
	}

	.platform-source-section .bullets li {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted);
		font-size: 16px;
		line-height: var(--line-height-body);
		list-style: disc;
	}

	.platform-source-section .bullets li::marker {
		color: var(--accent);
	}

	.platform-source-section .card .bullets {
		max-width: none;
		padding-left: 18px;
	}

	.platform-source-section .platform-products-lede {
		align-self: flex-start;
		margin-right: auto !important;
		margin-left: 0 !important;
		text-align: left !important;
	}

	.platform-source-section.platform-products-section.section--white .platform-products-lede {
		color: var(--accent-copy) !important;
	}

	.platform-source-section .platform-two-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: calc(var(--section-flow-gap) * 1.5);
	}

	.platform-source-section .platform-three-grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.platform-source-section.platform-products-section .platform-products-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: auto;
	}

	.platform-source-section.platform-products-section .card {
		min-height: 0;
	}

