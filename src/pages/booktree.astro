---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import CtaBlock from "../components/sections/CtaBlock.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Section from "../components/sections/Section.astro";
import SectionIcon from "../components/SectionIcon.astro";
import ProductName from "../components/ProductName.astro";
import { BOOKS_URL, SITE_NAME } from "../consts";

const tryBookTreeAction = { label: "Try BookTree on any book", href: BOOKS_URL, external: true };
const useBookTreeAction = { label: "Use BookTree with any book", href: BOOKS_URL, external: true };
---

<Base
	title={`BookTree: Book Notes & Research Organization | ${SITE_NAME}`}
	description="Use BookTree to connect books, excerpts, notes, references, projects, and manuscripts in a structured knowledge map for research, writing, and study."
>
	<HeroSection
		class="booktree-hero"
		eyebrow="BookTree"
		title="BookTree: Keep books, notes, and research connected as you learn."
		lead="Knowledge breaks when context is lost. Over time, books, notes, and research materials become disconnected from one another."
		body="BookTree gives long-form readers, researchers, students, and authors a way to keep context alive across everything they read."
		image="/images/booktree.webp"
		imageAlt="BookTree interface connecting manuscripts, source books, notes, and a highlighted passage in a structured reading tree"
		actions={[tryBookTreeAction]}
		spacerBackgroundPositionY="36%"
	>
		<Fragment slot="title"><span class="booktree-hero-product" style="color: var(--accent);">Book<span class="hero-product-part-accent">Tree</span><span class="hero-title-colon">:</span></span><br /><span class="hero-title-rest">Keep books, notes, and research connected as you learn.</span></Fragment>
	</HeroSection>

	<Section
		tone="gray"
		body="People may organize their books, but the ideas they collect often scatter across files, notes, and projects."
	>
		<Fragment slot="title"><span class="section-title-accent">Books are organized.</span> <span class="section-title-rest">Knowledge is not.</span></Fragment>
		<CardGrid columns="2" class="booktree-problem-grid">
			<Card title="Ideas scatter" body="Important insights end up spread across many books and sources." />
			<Card title="Context disappears" body="Notes lose meaning when they are separated from the publications they came from." />
			<Card title="Projects outgrow books" body="Research and writing often depend on connections across many sources." />
			<Card
				title="Structure becomes manual"
				body="People build folders, documents, and spreadsheets just to preserve the relationships between ideas."
			/>
		</CardGrid>
	</Section>

	<section class="section section--white booktree-solution-heading-section section-continuation">
		<h2 class="booktree-solution-heading">
			<em class="booktree-solution-heading-prefix">The solution:&nbsp;&nbsp;</em><ProductName name="BookTree" /> connects reading to thinking
		</h2>
		<p class="booktree-solution-lede">
			<ProductName name="BookTree" /> helps readers organize books, excerpts, and notes around research, writing, and study.<br />
			Instead of collecting isolated highlights, readers build structured knowledge trees that connect sources, notes, references, and projects.
		</p>
	</section>

	<Section
		tone="green"
		class="booktree-source-section booktree-source-solution-section section--two-column section-continuation"
	>
		<h2 class="booktree-source-focus-heading">
			The focus shifts from storing information <span class="booktree-source-focus-white">to preserving context</span>
		</h2>
		<div class="booktree-source-model-grid">
			<article class="comparison-text-panel booktree-source-model-card booktree-without-card">
				<div class="card-copy">
					<h3>Without <span class="booktree-green-white">BookTree</span></h3>
					<ul class="booktree-source-list">
						<li>Notes remain trapped inside individual books.</li>
						<li>Connections between sources are easy to lose.</li>
						<li>Research becomes harder as projects grow.</li>
						<li>Important discoveries disappear into old highlights.</li>
					</ul>
				</div>
			</article>
			<article class="card card--good booktree-source-model-card booktree-with-card">
				<div class="card-copy">
					<h3>With <ProductName name="BookTree" /></h3>
					<ul class="booktree-source-list">
						<li>Sources remain connected to projects.</li>
						<li>Notes stay attached to their context.</li>
						<li>References remain traceable.</li>
						<li>Knowledge accumulates instead of scattering.</li>
					</ul>
				</div>
			</article>
		</div>
	</Section>

	<Section
		tone="white"
		class="booktree-connected-section"
		body="Organized reading creates organized knowledge. The relationships among books, references, and ideas should remain visible over time."
	>
		<Fragment slot="title">Knowledge should remain connected</Fragment>
		<CardGrid columns="4">
			<Card title="Context" body="Ideas remain connected to their sources." />
			<Card title="Continuity" body="Knowledge accumulates instead of fragmenting." />
			<Card title="Structure" body="Projects retain relationships across many publications." />
			<Card title="Traceability" body="References remain connected to the work they support." />
		</CardGrid>
	</Section>

	<Section tone="green" class="booktree-connected-flow-section section-continuation">
		<div class="booktree-connected-subsection">
			<header class="section-header">
				<h2>From isolated books <span class="green-heading-white">to connected knowledge</span></h2>
				<p class="section-lead">
					The value of reading rarely comes from a single book. It comes from the relationships among books, notes, ideas, and projects that accumulate over time. BookTree helps preserve those relationships.
				</p>
			</header>
			<div class="card booktree-flow-card">
				<ul class="flow-chain booktree-flow-chain" aria-label="BookTree knowledge flow">
					<li>Book</li>
					<li>Excerpt</li>
					<li>Note</li>
					<li>Project</li>
					<li>Manuscript</li>
					<li>Knowledge map</li>
				</ul>
			</div>
		</div>
	</Section>

	<Section
		tone="white"
		title="Knowledge compounds through relationships"
		body="The value of reading rarely comes from a single publication. It grows through the connections built across many publications over time."
	>
		<CardGrid columns="4" class="booktree-relationship-grid">
			<Card title="Research" body="Connect evidence across many sources." />
			<Card title="Writing" body="Preserve references while developing manuscripts." />
			<Card title="Study" body="Build durable learning structures." />
			<Card title="Discovery" body="Reveal relationships between ideas that would otherwise be lost." />
			<Card
				title="Explore connections"
				body="Use Scribe to map links among books, authors, history, literary movements, and research topics."
			/>
		</CardGrid>
	</Section>

	<Section tone="green" class="booktree-benefits-section">
		<Fragment slot="title">Who benefits from <span class="green-heading-white">structured knowledge</span>?</Fragment>
		<p class="section-lead booktree-source-audience-intro">
			BookTree is designed for people who work with ideas over months and years—not minutes and hours.
		</p>
		<CardGrid columns="3" class="booktree-use-grid">
			<Card icon="author" title="Authors" body="Connect source books, excerpts, and notes while working on a manuscript." />
			<Card icon="research" title="Researchers" body="Keep evidence, references, and observations organized across many texts." />
			<Card icon="university" title="Students" body="Build study structures that last beyond one class, book, or exam." />
			<Card icon="library" title="Academics" body="Maintain context across courses, papers, citations, and long-term projects." />
			<Card icon="reader" title="Journalists" body="Track source material and notes across investigations and background reading." />
			<Card icon="readerBook" title="Lifelong readers" body="Turn serious reading into a personal knowledge structure that grows over time." />
		</CardGrid>
	</Section>

		<CtaBlock
			title="Reading should create knowledge, not fragmentation."
			body="BookTree makes every book a functional part of a larger, structured knowledge system."
			actions={[useBookTreeAction]}
		/>
</Base>

<style>
	:global(.booktree-hero .hero-image) {
		border: 1px solid var(--border);
		border-radius: 10px;
		background: #ffffff;
	}

	:global(.booktree-hero .booktree-hero-product) {
		color: var(--accent) !important;
	}

	:global(.booktree-problem-grid) {
		align-items: stretch;
		grid-auto-rows: 1fr;
	}

	:global(.booktree-problem-grid .card) {
		align-self: stretch;
		height: 100%;
		min-height: 0;
	}

	.booktree-solution-heading-section {
		justify-items: center;
		margin-bottom: 0 !important;
		padding-bottom: 0 !important;
	}

	.booktree-solution-heading {
		width: 100%;
		max-width: 1180px;
		margin: 0 !important;
		text-align: center;
	}

	.booktree-solution-heading-prefix {
		color: var(--text);
	}

	.booktree-solution-lede {
		justify-self: center;
		width: min(80%, calc(var(--page-max) * 0.8));
		max-width: 80% !important;
		margin: 0 !important;
		color: var(--accent-copy);
		font-size: var(--hero-problem-copy-size);
		line-height: var(--line-height-body);
		text-align: left;
	}

	:global(body .page .content .section.booktree-solution-heading-section > p.booktree-solution-lede) {
		width: min(80%, calc(var(--page-max) * 0.8)) !important;
		max-width: 80% !important;
	}

	:global(.booktree-source-section.section--green) {
		margin-top: calc(var(--section-padding) * 0.6) !important;
	}

	.booktree-source-focus-heading {
		justify-self: stretch;
		width: 100%;
		margin: 0 !important;
		color: var(--accent-orange) !important;
		text-align: left;
	}

	.booktree-source-focus-white {
		color: #ffffff !important;
	}

	.booktree-source-model-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--card-grid-gap);
		width: 100%;
	}

	.booktree-source-model-card {
		min-height: 0;
	}

	.booktree-without-card {
		background: transparent;
		color: var(--accent-orange);
	}

	.booktree-without-card h3 {
		color: var(--accent-orange) !important;
	}

	.booktree-green-white {
		color: #ffffff !important;
	}

	.booktree-with-card h3 span {
		color: var(--accent);
	}

	.booktree-source-list {
		list-style: none;
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
	}

	.booktree-source-list li {
		position: relative;
		padding-left: 18px;
		color: var(--muted);
		font-size: 16px;
		line-height: var(--line-height-body);
	}

	.booktree-without-card .booktree-source-list li {
		color: #ffffff;
	}

	.booktree-source-list li::before {
		content: "";
		position: absolute;
		top: 0.58em;
		left: 0;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.booktree-without-card .booktree-source-list li::before {
		background: var(--accent-orange);
	}

	.booktree-connected-subsection {
		display: grid;
		gap: 28px;
		margin-top: var(--section-padding);
	}

	.booktree-connected-flow-section .booktree-connected-subsection {
		margin-top: 0;
	}

	:global(body .page .content .section.booktree-connected-flow-section.section--green) {
		--green-section-padding-top: calc(var(--green-edge-top-inset) + clamp(28px, 3vw, 48px));
	}

	.booktree-flow-card {
		min-height: 0;
	}

	.flow-chain {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.flow-chain li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--text);
		font-size: 15.3px;
		line-height: var(--line-height-body);
	}

	.flow-chain li:not(:last-child)::after {
		content: "→";
		color: var(--accent-orange);
		font-weight: 700;
	}

	.booktree-flow-chain {
		justify-content: center;
	}

	.booktree-flow-chain li {
		font-family: var(--font-heading);
		font-size: var(--card-heading-font-size);
		font-weight: var(--font-weight-heading);
		line-height: var(--card-heading-line-height);
		letter-spacing: var(--letter-spacing-heading);
	}

	.booktree-source-audience-intro {
		margin-top: 0 !important;
	}

	:global(.booktree-benefits-section .booktree-use-grid .card) {
		background: var(--card-bg);
	}

	:global(.card-grid.booktree-relationship-grid) {
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-auto-rows: auto;
	}

	:global(.booktree-relationship-grid > .card) {
		grid-column: span 2;
	}

	:global(.booktree-relationship-grid > .card:nth-child(4)) {
		grid-column: 2 / span 2;
	}

	:global(.booktree-relationship-grid > .card:nth-child(5)) {
		grid-column: 4 / span 2;
	}

	@media (max-width: 900px) {
		.booktree-source-model-grid {
			grid-template-columns: 1fr;
		}

		.booktree-flow-chain {
			justify-content: flex-start;
		}

		:global(.card-grid.booktree-relationship-grid) {
			grid-template-columns: 1fr;
		}

		:global(.booktree-relationship-grid > .card) {
			grid-column: auto;
		}
	}
</style>
