---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { SITE_DOMAIN, SITE_NAME } from "../consts";
import { ViewTransitions } from "astro:transitions";

const {
	title = `${SITE_NAME} - Web-Native Publishing Network`,
	description = `${SITE_NAME} is a web-native publishing network for readers, authors, publishers and institutions.`,
	canonical,
	ogTitle,
	ogDescription,
	ogImage = "/images/tech.webp",
} = Astro.props;

const siteUrl = `https://${SITE_DOMAIN}`;
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteUrl);
canonicalUrl.pathname = canonicalUrl.pathname === "/" ? "/" : `${canonicalUrl.pathname.replace(/\/+$/, "")}/`;
canonicalUrl.search = "";
canonicalUrl.hash = "";
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const resolvedOgImage = ogImage.startsWith("http")
	? ogImage
	: `${siteUrl}${ogImage.startsWith("/") ? ogImage : `/${ogImage}`}`;
const routeSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, "").split("/")[0] || "home";
const pageClass = `page-${routeSlug.replace(/[^a-z0-9-]/gi, "-").toLowerCase()}`;
const organizationStructuredData = {
	"@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: "ReaderPub Inc.",
  description: "ReaderPub is a web-native publishing network for books, knowledge publications, and connected reading.",
  url: siteUrl,
	logo: `${siteUrl}/images/logo.svg`,
	contactPoint: {
		"@type": "ContactPoint",
		url: `${siteUrl}/contact/`,
	},
};
const structuredData =
	routeSlug === "home"
		? {
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "WebSite",
						name: SITE_NAME,
						url: siteUrl,
						inLanguage: "en",
					},
					organizationStructuredData,
				],
			}
		: {
				"@context": "https://schema.org",
				...organizationStructuredData,
			};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			document.documentElement.classList.remove("no-js");
			document.documentElement.classList.add("animation-pass-ready");
			document.documentElement.classList.add("animation-pass-hold-hero");
		</script>
		<link rel="icon" type="image/svg+xml" href="/images/logo.svg?v=ff5a00" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={resolvedOgTitle} />
		<meta property="og:description" content={resolvedOgDescription} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={resolvedOgTitle} />
		<meta name="twitter:description" content={resolvedOgDescription} />
		<meta name="twitter:image" content={resolvedOgImage} />
		<meta name="application-name" content={SITE_NAME} />
		<meta name="author" content={SITE_NAME} />
		<meta name="hostname" content={SITE_DOMAIN} />
		<link rel="canonical" href={canonicalUrl.href} />
		<script type="application/ld+json" set:html={structuredDataJson} />
		<slot name="head" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
		/>
		<ViewTransitions />
	</head>
	<body class={pageClass}>
		<div class="page">
			<Nav />
			<main class="content">
				<slot />
			</main>
			<Footer />
		</div>
		<a href="/kb/" class="kb-fab" title="Knowledge Base" aria-label="Knowledge Base" transition:persist>?</a>
		<script is:inline>
			(() => {
				const fab = document.querySelector(".kb-fab");

				const updateFab = () => {
					if (!fab) return;

					const isKb = window.location.pathname === "/kb/";
					fab.href = isKb ? "/" : "/kb/";
					fab.title = isKb ? "Home" : "Knowledge Base";
					fab.setAttribute("aria-label", isKb ? "Home" : "Knowledge Base");
					fab.textContent = isKb ? "✕" : "?";
				};

				updateFab();
				document.addEventListener("astro:page-load", updateFab);
			})();
		</script>
		<script is:inline>
			(() => {
				const keepTextLineBreaks = () => {
					const textBlocks = document.querySelectorAll(".content :is(h2, p)");
					const colonSpacePlaceholder = "\uE000";
					const nextContentSibling = (node) => {
						let next = node.nextSibling;

						while (next && next.nodeType === Node.TEXT_NODE && !next.nodeValue.trim()) {
							next = next.nextSibling;
						}

						return next;
					};

			for (const textBlock of textBlocks) {
				if (textBlock.classList.contains("security-books-heading")) {
					continue;
				}

				if (textBlock.matches("p") && textBlock.closest(".card")) {
							continue;
						}

						const walker = document.createTreeWalker(textBlock, NodeFilter.SHOW_TEXT);
						const textNodes = [];
						let node = walker.nextNode();

						while (node) {
							textNodes.push(node);
							node = walker.nextNode();
						}

						for (const textNode of textNodes) {
							const hasNextContentSibling = Boolean(nextContentSibling(textNode));

							textNode.nodeValue = textNode.nodeValue
								.replace(/:\u00a0\u00a0/g, `:${colonSpacePlaceholder}${colonSpacePlaceholder}`)
								.replace(/\u00a0/g, " ")
								.replace(new RegExp(colonSpacePlaceholder, "g"), "\u00a0")
								.replace(/(^|[^\p{L}])(\p{L}{2,3})\s+(?=\p{L})/gu, (_match, prefix, word) => `${prefix}${word}\u00a0`);

							if (hasNextContentSibling && /\s$/.test(textNode.nodeValue)) {
								continue;
							}
						}

						for (let index = textNodes.length - 1; index >= 0; index -= 1) {
							const textNode = textNodes[index];

							if (nextContentSibling(textNode) && /\s$/.test(textNode.nodeValue)) {
								continue;
							}

							if (!/\S+\s+\S+\s*$/.test(textNode.nodeValue)) {
								continue;
							}

							textNode.nodeValue = textNode.nodeValue.replace(/(\S+)\s+(\S+)\s*$/, "$1\u00a0$2");
							break;
						}
					}
				};

				keepTextLineBreaks();
				document.addEventListener("astro:page-load", keepTextLineBreaks);
			})();
		</script>
		<script>
			import "../scripts/animation-pass.js";
		</script>
	</body>
</html>
