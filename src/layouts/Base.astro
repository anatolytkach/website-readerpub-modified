---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { SITE_DOMAIN, SITE_NAME } from "../consts";
import { ViewTransitions } from "astro:transitions";

const {
	title = `${SITE_NAME} - Web-Native Publishing Network`,
	description = `${SITE_NAME} is a web-native publishing network for readers, authors, publishers and institutions.`,
	canonical,
} = Astro.props;

const canonicalUrl = canonical
	? canonical.startsWith("http")
		? canonical
		: `https://${SITE_DOMAIN}${canonical.startsWith("/") ? canonical : `/${canonical}`}`
	: undefined;
const routeSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, "").split("/")[0] || "home";
const pageClass = `page-${routeSlug.replace(/[^a-z0-9-]/gi, "-").toLowerCase()}`;
---

<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			document.documentElement.classList.remove("no-js");
			document.documentElement.classList.add("animation-pass-ready");
		</script>
		<link rel="icon" type="image/svg+xml" href="/images/logo.svg?v=ff5a00" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="application-name" content={SITE_NAME} />
		<meta name="author" content={SITE_NAME} />
		<meta name="hostname" content={SITE_DOMAIN} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
		/>
		<ViewTransitions />
	</head>
	<body class={pageClass}>
		<div class="page">
			<Nav />
			<main class="content">
				<slot />
			</main>
			<Footer />
		</div>
		<a href="/kb" class="kb-fab" title="Knowledge Base" aria-label="Knowledge Base" transition:persist>?</a>
		<script is:inline>
			(() => {
				const fab = document.querySelector(".kb-fab");

				const updateFab = () => {
					if (!fab) return;

					const isKb = window.location.pathname === "/kb" || window.location.pathname === "/kb/";
					fab.href = isKb ? "/" : "/kb";
					fab.title = isKb ? "Home" : "Knowledge Base";
					fab.setAttribute("aria-label", isKb ? "Home" : "Knowledge Base");
					fab.textContent = isKb ? "✕" : "?";
				};

				updateFab();
				document.addEventListener("astro:page-load", updateFab);
			})();
		</script>
		<script is:inline>
			(() => {
				const keepTextLineBreaks = () => {
					const textBlocks = document.querySelectorAll(".content :is(h1, h2, p)");

					for (const textBlock of textBlocks) {
						if (textBlock.matches("p") && textBlock.closest(".card")) {
							continue;
						}

						const walker = document.createTreeWalker(textBlock, NodeFilter.SHOW_TEXT);
						const textNodes = [];
						let node = walker.nextNode();

						while (node) {
							textNodes.push(node);
							node = walker.nextNode();
						}

						for (const textNode of textNodes) {
							textNode.nodeValue = textNode.nodeValue
								.replace(/\u00a0/g, " ")
								.replace(/(^|[^\p{L}])(\p{L}{2,3})\s+(?=\p{L})/gu, (_match, prefix, word) => `${prefix}${word}\u00a0`);
						}

						for (let index = textNodes.length - 1; index >= 0; index -= 1) {
							const textNode = textNodes[index];

							if (!/\S+\s+\S+\s*$/.test(textNode.nodeValue)) {
								continue;
							}

							textNode.nodeValue = textNode.nodeValue.replace(/(\S+)\s+(\S+)\s*$/, "$1\u00a0$2");
							break;
						}
					}
				};

				keepTextLineBreaks();
				document.addEventListener("astro:page-load", keepTextLineBreaks);
			})();
		</script>
		<script>
			import "../scripts/animation-pass.js";
		</script>
	</body>
</html>
