---
import type { PageAction } from "../data/pages";

interface Props extends PageAction {
	class?: string;
}

const {
	href,
	label,
	variant = "primary",
	external = false,
	modalTarget,
	class: className = "",
	iconSrc,
	iconAlt = "",
	externalIconSrc,
	externalIconAlt = "",
	externalIconClass = "",
	externalIconStyle,
} = Astro.props;

const classes = [
	"button",
	variant === "secondary" && "button--secondary",
	variant === "tertiary" && "button--tertiary",
	className,
];

const insideIconSrc = externalIconSrc ? undefined : iconSrc;
---

{
	externalIconSrc ? (
		<span class="button-action-with-icon">
			<img
				class:list={["button-external-icon", externalIconClass]}
				src={externalIconSrc}
				alt={externalIconAlt}
				aria-hidden={externalIconAlt ? undefined : "true"}
				style={externalIconStyle}
			/>
			{modalTarget ? (
				<button class:list={classes} type="button" data-modal-open={modalTarget}>
					{insideIconSrc && <img class="button-icon" src={insideIconSrc} alt={iconAlt} />}
					{label}
				</button>
			) : (
				<a
					class:list={classes}
					href={href}
					target={external ? "_blank" : undefined}
					rel={external ? "noopener noreferrer" : undefined}
				>
					{insideIconSrc && <img class="button-icon" src={insideIconSrc} alt={iconAlt} />}
					{label}
				</a>
			)}
		</span>
	) : modalTarget ? (
		<button class:list={classes} type="button" data-modal-open={modalTarget}>
			{insideIconSrc && <img class="button-icon" src={insideIconSrc} alt={iconAlt} />}
			{label}
		</button>
	) : (
		<a
			class:list={classes}
			href={href}
			target={external ? "_blank" : undefined}
			rel={external ? "noopener noreferrer" : undefined}
		>
			{insideIconSrc && <img class="button-icon" src={insideIconSrc} alt={iconAlt} />}
			{label}
		</a>
	)
}
