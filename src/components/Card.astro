---
import SectionIcon from "./SectionIcon.astro";
import ProductTitle from "./ProductTitle.astro";
import type { PageCard } from "../data/pages";

interface Props extends PageCard {
	class?: string;
}

const { title, body, icon, href, variant = "default", class: className = "" } = Astro.props;
const classes = ["card", `card--${variant}`, icon && "card--with-icon", className];
---

{
	href ? (
		<a class:list={[...classes, "card--link"]} href={href}>
			{icon ? (
				<>
					<div class="card-icon-heading">
						<SectionIcon type={icon} title={`${title} icon`} />
						<h3><ProductTitle text={title} /></h3>
					</div>
					<p>{body}</p>
				</>
			) : (
				<div class="card-copy">
					<h3><ProductTitle text={title} /></h3>
					<p>{body}</p>
				</div>
			)}
		</a>
	) : (
		<article class:list={classes}>
			{icon ? (
				<>
					<div class="card-icon-heading">
						<SectionIcon type={icon} title={`${title} icon`} />
						<h3><ProductTitle text={title} /></h3>
					</div>
					<p>{body}</p>
				</>
			) : (
				<div class="card-copy">
					<h3><ProductTitle text={title} /></h3>
					<p>{body}</p>
				</div>
			)}
		</article>
	)
}
